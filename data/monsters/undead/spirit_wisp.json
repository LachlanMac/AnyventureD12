    },
    {
      "name": "Luring Light",
      "type": "utility",
      "magic": true,
      "description": "The spirit wisp attempts to lure a creature towards it, charming them if they fail a resilience check of 5. When charmed in this way, a creature will only use its turn to take normal movement to approach the spirit wisp. The charm ends upon reaching an adjacent space to the wisp, or after taking damage. Unlike normal charm, the target of this ability must make a resilience check of 5 at the end of their turn or they remain charmed.",
      "reaction": false,
      "basic": false,
      "round": false,
      "daily": false,
      "frequency": "battle",
      "actionCost": 1,
      "frequencyCondition": "",
      "charges": 0,
      "spellType": "normal"
    },
    {
      "name": "Cold Presence",
      "type": "movement",
      "magic": true,
      "description": "The spirit wisp passes through an adjacent creature, moving up to 2 units when doing so. The target of this ability must make an endurance check of 6 or higher or take 7 cold damage.",
      "reaction": false,
      "basic": false,
      "round": false,
      "daily": false,
      "frequency": "round",
      "actionCost": 1,
      "frequencyCondition": "",
      "charges": 0,
      "spellType": "normal"
    },
    {
      "name": "Dread Aura",
      "type": "utility",
      "magic": true,
      "description": "The spirit wisp emanates an aura of fear and dread within a very short (5 unit) distance. Any creature that willfully enters this aura must make a resilience check of 6 or higher or become afraid. This aura lasts until the start of the spirit wisp's next turn and does not affect creatures who are already in the area.",
      "reaction": false,
      "basic": false,
