    {
        "name": "Surge Table",
        "dice":"1d12",
        "entries": [
            {
                "dice": "1",
                "description": "You enter stasis, gaining that condition for the next 1d4 days"
            },
            {
                "dice": "2",
                "description": "You transform into a random beast as if you were under the effects of the spell polymorph by rolling on the Random Beast Table. This effect lasts for 1 hour or until naturally reverting due to losing health."
            },
            {
                "dice": "3",
                "description": "You become muted until the end of your next full rest"
            },
            {
                "dice": "4",
                "description": "You become the target of the channeled spell"
            },
            {
                "dice": "5",
                "description": "You teleport 1d6 units in a random direction. If the spot is occupied, teleport instead to the closest unoccupied tile to that point and take 2d12 true damage."
            },
            {
                "dice": "6",
                "description": "You become dazed until the end of your next full rest and take 2d12 psychic damage if you are currently focusing on a spell"
            },
            {
                "dice": "7",
                "description": "The spell fails and you gain 1 tier of exhaustion"
            },
            {
                "dice": "8",
                "description": "You gain temporary health equal to the amount of power spent on the spell"
            },
            {
                "dice": "9",
                "description": "The spell is upraded to a true hit and any damage dealt by the spell on your current turn is converted to true damage"
            },
            {
                "dice": "10",
                "description": "The spell is converted to a radius spell with a radius of 2 centered on your original target. If the spell already has an area type of radius, line, or cone, the size of the area is increased by 1 unit, instead."
            }
            ,
            {
                "dice": "11",
                "description": "The spell consumes double the power but is upgraded to a brutal critical. If the conduit reaches 0 as a result of this power increase, the channeler must then roll an essence burn to make up the remaining power required for the spell."
            }
            ,
            {
                "dice": "12",
                "description": "The spell is upgraded to a brutal critical and does not consume any power"
            }
        ]
    },
