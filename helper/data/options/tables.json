            },
            {
                "dice": "71-75",
                "description": "Angry Undead Spirits who are doomed to remain as shades until a curse is lifted"
            },
            {
                "dice": "76-80",
                "description": "Vengeful Elementals of the Land"
            },
            {
                "dice": "81-85",
                "description": "Fey Creatures bent on treating the expedition like toys and only engaging in combat when all avenues of 'fun' are expended"
            },
            {
                "dice": "86-90",
                "description": "Animated Plantoids or Earthen Elementals protesting against the expedition crossing their land"
            },
            {
                "dice": "91-93",
                "description": "Malfunctioning Clockwork Constructs from another era"
            },
            {
                "dice": "94-95",
                "description": "Maddened Constructs created by a powerful wizard"
            },
            {
                "dice": "96-97",
                "description": "Planar Encounter with either Dark or Divine Creatures"
            },
            {
                "dice": "98-100",
                "description": "A rift to another plane that is leaking corrupted versions of creatures through it. Roll on the Random Plane Table to determine which."
            }
        ]
    },
    
