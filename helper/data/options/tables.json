    {
        "name": "Random Encounter Type Table",
        "dice": "1d100",
        "entries": [
            {
                "dice": "1-5",
                "description": "Protective Humanoids with the intent of driving the expedition out of their land"
            },
            {
                "dice": "6-10",
                "description": "Criminal Humanoids with the intent of robbing or capturing members of the expedition"
            },
            {
