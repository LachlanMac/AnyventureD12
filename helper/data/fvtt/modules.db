{"name":"Abjuration Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"100","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Abjurist","avd12_id":"100_1","custom":false,"description":"You can research Beginner Level Abjuration Spells and gain +1 Power.","selected":true,"data":"S71=4:FP=1","cost":2},"option_2a":{"name":"Improved Focus","avd12_id":"100_2a","custom":false,"description":"Gain +1 Concentration and +2 Psychic Mitigation","selected":false,"data":"AS5=1:AD9=2","cost":2},"option_2b":{"name":"Potent Spells","avd12_id":"100_2b","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_3":{"name":"Action : Bond","avd12_id":"100_3","custom":false,"description":"You bond to a Creature, increasing the efficiency of your Shield Spells when used on them, adding additional Shielding equal to your Level. You can only be bound to one Creature at a time.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Shared Voice","avd12_id":"100_4a","custom":false,"description":"You and your bonded Creature can communicate telepathically when they are within 20 Units of you.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Reaction : Shared Life","avd12_id":"100_4b","custom":false,"description":"As a Reaction to recovering Health, your bonded target receives it instead.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Novice Abjurist","avd12_id":"100_5","custom":false,"description":"You can research Novice Level Abjuration Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S72=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Shared Mind","avd12_id":"100_6a","custom":false,"description":"You and your Bonded Target both gain a 1d4 Bonus to Resistance Checks.","selected":false,"data":"TD","cost":2},"option_6b":{"name":"Perfect Shields","avd12_id":"100_6b","custom":false,"description":"When you Shield an Ally as a Reaction, any Secondary or Tertiary Damage is also reduced by the total value of the Shield before Mitigation.","selected":false,"data":"TD","cost":2},"option_7":{"name":"Journeyman Abjurist","avd12_id":"100_7","custom":false,"description":"You can research Journeyman Level Abjuration Spells, gain +5 Power and +1 Elemental Mitigation","selected":false,"data":"S73=3:ADA=1:FP=5","cost":3},"option_8a":{"name":"Improved Channeling","avd12_id":"100_8a","custom":false,"description":"Gain +1 Spell Damage and +3 Power Regeneration","selected":false,"data":"FR=2:AZ4=1","cost":2},"option_8b":{"name":"Reaction : Divert Energy","avd12_id":"100_8b","custom":false,"description":"If the Creature you are bonded to takes Damage, you take the Damage instead applying both yours and your bonded allys Mitigation.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Expert Abjurist","avd12_id":"100_9","custom":false,"description":"You can research Expert Level Abjuration Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S74=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Contingency","avd12_id":"100_10a","custom":false,"description":"When you fall Unconscious, you become Impervious for 1 minute or until you regain Consciousness","selected":false,"data":"TG","cost":3},"option_10b":{"name":"Action : Overshield","avd12_id":"100_10b","custom":false,"description":"You Channel an Abjuration Shield that requires a Reaction as an Action and grant Temporary Health instead of a Shield.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Master Abjurist","avd12_id":"100_11","custom":false,"description":"You can research Master Level Abjuration Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research Grand Master Abjuration Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e4a1beb82a5241b5","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Acolyte","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"230","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Sect","avd12_id":"230_1","custom":false,"description":"You are part of a religious order that worships an Entity or Entities associated with life or death. Gain +1 Arcanum and +1 Runecarving","selected":true,"data":"AC4=1:AS7=1","cost":2},"option_2a":{"name":"Of the Faith","avd12_id":"230_2a","custom":false,"description":"Learn 2 Beginner and 2 Novice Spells from the Divine or Necromancy School of Magic","selected":false,"data":"AD7=2","cost":2},"option_2b":{"name":"Brothers and Sisters","avd12_id":"230_2b","custom":false,"description":"While you are within 6 Units of another member of your Sect or another Character who has the Sect trait, you reroll any Attack and Defense Checks when you Roll a 1 on a d12.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Servant","avd12_id":"230_3","custom":false,"description":"Gain +1 Spell Damage, +1 Dark Mitigation and +1 Divine Mitigation.","selected":false,"data":"AZ4=1:AD8=1:AD7=1","cost":2},"option_4a":{"name":"Craft : Sacred Symbol","avd12_id":"230_4a","custom":false,"description":"When you Craft either a Shield, Necklace or Chest Piece, you can add a Conduit Slot Infusion without taking up an Infusion Slot and add iconography associated with your Sect. This Item gains +2 Spell Damage when Equipped by you or a member of your Sect as a Conduit.","selected":false,"data":"O","cost":2},"option_4b":{"name":"Reaction : Absolute Faith","avd12_id":"230_4b","custom":false,"description":"In response to making a Resistance or Resilience Check, gain a 1d4 Bonus. If the Bonus was the cause of a success, gain Temporary Health equal to your Level until the end of your next Full Rest. If you have the Brothers and Sisters trait, you can use this on any eligble member of your Sect within 6 Units.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Final Service","avd12_id":"230_5","custom":false,"description":"In response to reaching 3 Lifeline Points or lower, you can choose to forfeit any remaining Lifeline points and skip ahead to making your Death Check, with the result needed to live becoming a 4 or higher. If you survive, you gain Health equal to double your Level. On a failure, you die and become eligble for a Pact with an Entity associated wtih your Sect.","selected":false,"data":"TD","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"24ec8223995148f4","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Acrobat","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"250","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Acrobat","avd12_id":"250_1","custom":false,"description":"Gain +1 Acrobatics and +1 Initiative.","selected":true,"data":"AS3=1:ASH=1","cost":2},"option_2a":{"name":"Safe Fall","avd12_id":"250_2a","custom":false,"description":"You take half Damage from falling that is applied after the Acrobatics Check to Mitigate the Damage. Additionally, you take no Damage when falling 6 Units or less.","selected":false,"data":"TG","cost":2},"option_2b":{"name":"Aerialist","avd12_id":"250_2b","custom":false,"description":"Your Acrobatics Modifier replaces your Athletics for determining the distance you can Jump and checks that involve Climbing.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Reaction : Rolling Dodge","avd12_id":"250_3","custom":false,"description":"Gain +1 Dodge until the start of your next turn. Each time you Dodge an Attack successfully, gain another +1 Dodge until the start of your next turn","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Action : Parkour Strike","avd12_id":"250_4a","custom":false,"description":"Make an Attack with a +2 Modifier. If your Attack hits, you can bounce off your Target 1 unit plus a distance equal to your Melee Range and avoid provoking Reactions.","selected":false,"data":"","cost":2},"option_4b":{"name":"Quick Dodge","avd12_id":"250_4b","custom":false,"description":"You can use your Dodge Modifier to Defend against Ray Attacks","selected":false,"data":"TD","cost":2},"option_5":{"name":"Master Acrobat","avd12_id":"250_5","custom":false,"description":"Gain +1 Dodge, +1 Movement Speed and +1 Acrobatics","selected":false,"data":"AD2=1:AV=1:AS3=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"bc24b8c91c0e4415","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Alchemist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"126","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Alchemist","avd12_id":"126_1","custom":false,"description":"Gain +2 Alchemy","selected":true,"data":"AC5=2","cost":2},"option_2a":{"name":"Deadly Poisons","avd12_id":"126_2a","custom":false,"description":"Your Poison recipes gain an extra dice of damage.","selected":false,"data":"TC","cost":2},"option_2b":{"name":"Improved Healing Potions","avd12_id":"126_2b","custom":false,"description":"Your Healing Potion recipes gain an extra dice of Health restored.","selected":false,"data":"TC","cost":2},"option_3":{"name":"Careful Chemist","avd12_id":"126_3","custom":false,"description":"Gain +1 Alchemy, +1 Concentration and increase the Required Checks against Potions you Craft by 1.","selected":false,"data":"AC5=1:AS5=1:TC","cost":2},"option_4a":{"name":"Non-Lethal Poisons","avd12_id":"126_4a","custom":false,"description":"You can modify a Poison you are crafting to not deal fatal damage, and instead cause a Creature to become Unconscious for a number of hours equal to your Alchemy Bonus Modifier when they reach 0 Health.","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Expanded Volatility","avd12_id":"126_4b","custom":false,"description":"Potions you craft that specify a radius have that radius increased by 1 unit","selected":false,"data":"TC","cost":2},"option_5":{"name":"Potent Potions","avd12_id":"126_5","custom":false,"description":"Healing Potions you craft heal for an additional amount of Health equal to your alchemy bonus modifier at the time of crafting. Additioanlly, Poisons you craft deal additional damage equal to half your alchemy bonus modifier.","selected":false,"data":"TC","cost":2},"option_6a":{"name":"Free Action : Apply Poison","avd12_id":"126_6a","custom":false,"description":"You quickly apply a Vial of Poison to a Weapon or Piece of Ammunition.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Action : Toss Potion","avd12_id":"126_6b","custom":false,"description":"As an action, you can toss a Potion to a friendly Creature within 6 units. They can use their Reaction to immediately consume the potion.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Advanced Alchemy","avd12_id":"126_7","custom":false,"description":"Gain +1 Alchemy and access to Alchemy Augmentations","selected":false,"data":"TC:AC5=1","cost":2},"option_8a":{"name":"Efficient Mixing","avd12_id":"126_8a","custom":false,"description":"You Overcraft on Alchemy recipes when you roll an 11 or 12 and you produce 2 potions instead of 1.","selected":false,"data":"TC","cost":2},"option_8b":{"name":"Bolstering Potions","avd12_id":"126_8b","custom":false,"description":"Your healing Potions grant Temporary Health that lasts until the end of the next Full Rest if a Creature consumes one while at Full Health.","selected":false,"data":"TC","cost":2},"option_9":{"name":"Concentrated Potions","avd12_id":"126_9","custom":false,"description":"Gain +1 Alchemy. The Required Checks against Potions you Craft is increased by 2.","selected":false,"data":"TC:AC5=1","cost":3},"option_10a":{"name":"Taste Tester","avd12_id":"126_10a","custom":false,"description":"Gain an Immunity to Poison and +2 Resilience","selected":false,"data":"I=19:AS6=2","cost":3},"option_10b":{"name":"Free Action : Chug","avd12_id":"126_10b","custom":false,"description":"You can quickly consume a Potion, not counting against the amount of objects you can consume on a given turn.","selected":false,"data":"Y","cost":3},"option_11":{"name":"Master Alchemist","avd12_id":"126_11","custom":false,"description":"Gain +2 Alchemy and an extra dice on Poisons, Healing Potions and Potions with damaging effects on your alchemy recipes.","selected":false,"data":"AC5=2:TC","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3fed90abc1c2455a","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Ammocrafter","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"132","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Ammocrafter","avd12_id":"132_1","custom":false,"description":"Gain +2 Ammocraft","selected":true,"data":"AC6=2","cost":2},"option_2a":{"name":"Critical Success","avd12_id":"132_2a","custom":false,"description":"When you Overcraft, you produce double the amount of Ammunition","selected":false,"data":"TC","cost":2},"option_2b":{"name":"Trajectory Analysis","avd12_id":"132_2b","custom":false,"description":"Gain Additional [Heavy +3 / Light +2 / Ultra Light +1] Range on Ranged Weapons","selected":false,"data":"O3=3:O2=2:O1=1","cost":2},"option_3":{"name":"Ammunition Specialist","avd12_id":"132_3","custom":false,"description":"Gain +1 Ammocraft and +1 Damage to Ranged Weapons","selected":false,"data":"AZ9=1:AC6=1","cost":2},"option_4a":{"name":"Free Action : Pass Through","avd12_id":"132_4a","custom":false,"description":"When you shoot a piece of your Ammunition, you turn it into a Line Attack that deals full Damage to the first target hit, and half to every other target it passes through.","selected":false,"data":"AC6=1","cost":2},"option_4b":{"name":"Volatile Ammunition","avd12_id":"132_4b","custom":false,"description":"Your Shrapnel and Exploding Ammunition deals an extra dice of Damage","selected":false,"data":"TC","cost":2},"option_5":{"name":"Trajectory Analysis","avd12_id":"132_5","custom":false,"description":"Gain +1 Attack to Ranged Weapons","selected":false,"data":"AZ5=1","cost":2},"option_6a":{"name":"Packed Ammunition","avd12_id":"132_6a","custom":false,"description":"The Radius on Ammunition Infusions that cause Area effects is increased by 1 Unit","selected":false,"data":"TC","cost":2},"option_6b":{"name":"Improved Ammunition Chamber","avd12_id":"132_6b","custom":false,"description":"You can apply an Ammunition Chamber Infusion to a Weapon that has already been Crafted without requiring an Infusion Slot by making an Ammocraft Check of 10 or Higher.","selected":false,"data":"TC","cost":2},"option_7":{"name":"Handloader","avd12_id":"132_7","custom":false,"description":"Gain +1 Ammocraft, +1 Initiative and +1 Engineering","selected":false,"data":"AC6=1:AC7=1:ASH=1","cost":2},"option_8a":{"name":"Armor Negation","avd12_id":"132_8a","custom":false,"description":"Armor Piercing Ammunition created by you bypasses Physical Mitigation Completely.","selected":false,"data":"TC","cost":3},"option_8b":{"name":"Potion Lobber","avd12_id":"132_8b","custom":false,"description":"Your Delivery Ammunition does not have a Penalty to the Required Check to avoid it and the Range is extend to the Maximum Range of a Weapon.","selected":false,"data":"TC","cost":2},"option_9":{"name":"Expert Ammocrafter","avd12_id":"132_9","custom":false,"description":"Gain +2 Ammocraft and +1 Damage to Ranged Weapons","selected":false,"data":"AC6=2:AZ9=1","cost":3},"option_10a":{"name":"Improved Utility","avd12_id":"132_10a","custom":false,"description":"When you create Ammunition with the Shrapnel, Explosive or Smokescreen Infusions, the initial Projectile now deals Damage like a normal Ranged Attack if you hit a Creature.","selected":false,"data":"TC","cost":3},"option_10b":{"name":"Action : Ammosurge","avd12_id":"132_10b","custom":false,"description":"You prepare 4 Ammunition which are all consumed by this Action. You fire 1d4 times ignoring any Ammunition Capacity property and do not apply your Bonus Damage Modifier to any of the hits.","selected":false,"data":"XX3","cost":2},"option_11":{"name":"Master Ammocrafter","avd12_id":"132_11","custom":false,"description":"Gain +2 Ammocraft. Your Shrapnel and Explosive Ammo add your Ammocraft Skill at the time of Crafting to their Splash Damage. Additionally, the execution threshold on your Executioner Infusion is doubled.","selected":false,"data":"TC:AC6=2","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"cb369e9678ab4ab1","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Arah-ka","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"11","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Wraps of the Arah-Ka","avd12_id":"11_1","custom":false,"description":"The Arah-Ka wear leather wraps that protect them from the harsh desert. Gain +1 Physical Mitigation when wearing Light Armor.","selected":true,"data":"W1D4=1:ALI","cost":2},"option_2a":{"name":"Path of the Sunscholar","avd12_id":"11_2a","custom":false,"description":"The sunscholars dedicate themselves to the flame and finding the knowledge within. Learn 2 Beginner and Novice Pyromancy Spells and gain +1 Academics","selected":false,"data":"AS9=1","cost":2},"option_2b":{"name":"Path of the Sundancer","avd12_id":"11_2b","custom":false,"description":"The sundancers achieve ultimate form to attain knowledge. Gain +1 Acrobatics and +1 Athletics","selected":false,"data":"AS3=1:AS1=1","cost":2},"option_3":{"name":"The Harsh Desert","avd12_id":"11_3","custom":false,"description":"The Arah-Ka society functions best during the warm days in the desert, but they have learned to endure the long, cold nights. Gain +3 Cold Mitigation and +1 Resilience.","selected":false,"data":"AD5=3:AS6=1","cost":2},"option_4a":{"name":"Bloodless Weaponry","avd12_id":"11_4a","custom":false,"description":"The Arah-ka society train with weapons that do not scar skin as to not desecrate themselves. Gain +1 Attack and Damage on Bludgeoning Weapons and Unarmed Attacks.","selected":false,"data":"AZN=1:AZM=1:AZ7=1:AZB=1","cost":2},"option_4b":{"name":"Legacy of Knowledge","avd12_id":"11_4b","custom":false,"description":"Many within the Arah-Ka culture dedicate themselves to continued learning and spellcraft. Gain +1 Scribing and become Good at one Knowledge Skill.","selected":false,"data":"AC3=1","cost":2},"option_5":{"name":"Action : Ritual Dagger","avd12_id":"11_5","custom":false,"description":"You perform the ultimate offense in the Arah-Ka culture and make an Attack with a Light 1-Handed Piercing Weapon made of glass, causing the Target to gain the Bleeding Condition. Add an additional 1d10 Damage to any Physical Damage you do while the Target has the Bleeding Condition on it.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9263685c7c284041","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Arcanatech","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"285","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Arcanatech","avd12_id":"285_1","custom":false,"description":"Gain Access to Arcanatech Crafting. You can use Beginner and Novice Level Catalysts in your Arcanatech Recipes.","selected":true,"data":"TD","cost":2},"option_2a":{"name":"Craft : Acceleration Theory","avd12_id":"285_2a","custom":false,"description":"When you apply your first Arcanatech Infusion to a Ranged Weapon, that weapon gains a +1 to Attack and +1 to Damage.","selected":false,"data":"O","cost":2},"option_2b":{"name":"Compounded Magic","avd12_id":"285_2b","custom":false,"description":"You can add an additional Infusion to any Arcanatech Enhancements you Craft.","selected":false,"data":"TC","cost":2},"option_3":{"name":"Tinkerer's Hands","avd12_id":"285_3","custom":false,"description":"Gain +1 Smithing, +1 Engineering and +1 Initiative","selected":false,"data":"AC1=1:AC7=1:ASH=1","cost":2},"option_4a":{"name":"Arcanatech Catalyst Expert","avd12_id":"285_4a","custom":false,"description":"Gain +1 Spell Damage. Additionally, Catalysts that you create count as 1 tier higher for the purpose of Arcanatech Recipes.","selected":false,"data":"AZ4=1:TC","cost":2},"option_4b":{"name":"Exo-Enhancements","avd12_id":"285_4b","custom":false,"description":"Your Aracanatech Enhancements can be installed seamlessly on top of their organic counterparts, mitigating the need to remove body parts. Enhancements installed in this way do not cause the penalty to maximum Health.","selected":false,"data":"TC","cost":2},"option_5":{"name":"Improved Arcanatech","avd12_id":"285_5","custom":false,"description":"Gain +1 Engineering. Additionally, you can use Journeyman Catalysts in your Arcanatech Recipes at Level 7, Expert at 9 and Master at 11.","selected":false,"data":"AC7=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8a7d37c6dd204da8","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Arcanist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"245","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Free Action : Arcanist Charge","avd12_id":"245_1","custom":false,"description":"You can charge Spells at the expense of your mind. Whenever you use this ability, you take Psychic Damage equal to 1d4 per Power cost of the Spell.","selected":true,"data":"Y","cost":2},"option_2a":{"name":"Channeler","avd12_id":"245_2a","custom":false,"description":"Gain +1 Arcanum and +1 Concentration","selected":false,"data":"AS7=1:AS5=1","cost":2},"option_2b":{"name":"Reaction : Empower Ally","avd12_id":"245_2b","custom":false,"description":"When another Creature within 10 Units that you can see Channels a Spell, you can Charge it by spending 2 Focus Points.","selected":false,"data":"","cost":2},"option_3":{"name":"Wizard","avd12_id":"245_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Reaction : Prepared Spell","avd12_id":"245_4a","custom":false,"description":"At the start of Combat, you can Channel a Spell that takes one Action before Initiative Order starts.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Arcane Dueler","avd12_id":"245_4b","custom":false,"description":"Gain +1 Resistance and +2 Arcane Mitigation","selected":false,"data":"AD1=1:ADC=2","cost":2},"option_5":{"name":"Action : Mind Challenge","avd12_id":"245_5","custom":false,"description":"You utilize your Focus to make a Contested Arcanum Check against a Creature with the loser of the Check becoming Dazed. While you Focus on this ability, the Target has a 1d4 Penalty to Resistance and Concentration Checks. This does not work on Creatures who are not capable of making an Arcanum Check.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e6f6d79539044624","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Armored Fighting","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"115","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Armored Fighting","avd12_id":"115_1","custom":false,"description":"Gain +1 Dodge and +1 Block while wearing Medium and Heavy Armor","selected":true,"data":"W2D2=1:W2D3=1","cost":2},"option_2a":{"name":"Physical Defense","avd12_id":"115_2a","custom":false,"description":"Gain +1 Physical Mitigation on all Medium and Heavy Armor","selected":false,"data":"W2D4=1","cost":2},"option_2b":{"name":"Elemental Defense","avd12_id":"115_2b","custom":false,"description":"Gain +1 Elemental Mitigation while wearing Medium and Heavy Armor","selected":false,"data":"W2DA=1","cost":2},"option_3":{"name":"Improved Mitigation","avd12_id":"115_3","custom":false,"description":"Gain +1 Physical and +1 Elemental Mitigation on all Medium and Heavy Armor","selected":false,"data":"W2D4=1:W2DA=1","cost":2},"option_4a":{"name":"Efficient Movement","avd12_id":"115_4a","custom":false,"description":"Remove the Stealth Penalty and gain +1 Dodge while wearing Medium and Heavy Armor","selected":false,"data":"W2DY:W2D2=1","cost":2},"option_4b":{"name":"Toughened","avd12_id":"115_4b","custom":false,"description":"Gain +1 Resilience and +1 Strength","selected":false,"data":"AS2=1:AS6=1","cost":2},"option_5":{"name":"Unencumbered","avd12_id":"115_5","custom":false,"description":"Remove 1 Level of Casting Penalty from Medium and Heavy Armor and gain +1 Block and +1 Dodge while wearing Medium or Heavy Armor.","selected":false,"data":"W2DZ=1:W2D2=1:W2D3=1","cost":2},"option_6a":{"name":"Action : Charging Sprint","avd12_id":"115_6a","custom":false,"description":"You can move your Movement Speed plus an additional 2 Units but you can only move in a straight line. If you collide with any Creature your size or smaller, you can make a Shove Attack against them. Until you fail a Shove Attack, you can continue to move in the straight line.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Surprisingly Nimble","avd12_id":"115_6b","custom":false,"description":"Gain +1 Movement Speed while wearing Medium or Heavy Armor and +1 Acrobatics","selected":false,"data":"AS3=1:W2DB=1","cost":2},"option_7":{"name":"Armored Expert","avd12_id":"115_7","custom":false,"description":"Gain +2 Physical and +1 Elemental Mitigation on all Medium and Heavy Armor","selected":false,"data":"W2D4=2:W2DA=1","cost":3},"option_8a":{"name":"Free Action : Counterguard","avd12_id":"115_8a","custom":false,"description":"You make an Attack with a melee weapon without applying your damage bonus modifier. If the attack hits, it counts as if you had taken the Defense Action until the start of your next turn.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Reaction : Versatile Armor","avd12_id":"115_8b","custom":false,"description":"In response to taking any Damage type besides Psychic and True Damage, further reduce the damage by an amount equal to your Physical Mitigation.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Metal Skin","avd12_id":"115_9","custom":false,"description":"You have Immunity to the Dazed condition and gain +1 Block and +2 Physical Mitigation","selected":false,"data":"I=6:AD4=2:AD3=1","cost":4},"option_10a":{"name":"Reflective Surface","avd12_id":"115_10a","custom":false,"description":"Gain +3 Arcane Mitigation and +1 Resistance","selected":false,"data":"ADC=3:AD1=1","cost":3},"option_10b":{"name":"Free Action : Body Check","avd12_id":"115_10b","custom":false,"description":"Make a Shove Attack by using your body, dealing Damage equal to your Physical Mitigation regardless if you succeed or not.","selected":false,"data":"Y","cost":3},"option_11":{"name":"Master Armorer","avd12_id":"115_11","custom":false,"description":"Gain +1 Block, +1 Dodge, +1 Resist while wearing Armor and Gain +1 Movement Speed","selected":false,"data":"W2D1=1:W2D2=1:W2D3=1:AV=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"af4f3702427b4a64","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Armsman","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"252","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action : Diverting Strike","avd12_id":"252_1","custom":false,"description":"You make an Attack with a Heavy Melee Weapon with a 1d4 Attack Bonus. If you miss, make a seperate Attack with a Light 1-Handed Weapon.","selected":true,"data":"XX3","cost":2},"option_2a":{"name":"Weapon Expert","avd12_id":"252_2a","custom":false,"description":"Gain +1 Smithing and +1 Damage to Attacks with Slashing, Piercing and Crushing Weapons","selected":false,"data":"AC1=1:AZA=1:AZB=1:AZC=1","cost":2},"option_2b":{"name":"Armsman Stance","avd12_id":"252_2b","custom":false,"description":"Gain the Armsman Stance","selected":false,"data":"H=15","cost":2},"option_3":{"name":"Recurring Blows","avd12_id":"252_3","custom":false,"description":"When you miss a Creature with a Melee Attack, the next Attack you make before the start of your next turn gains a 1d4 Bonus.","selected":false,"data":"TO","cost":2},"option_4a":{"name":"Reaction : Change Stance","avd12_id":"252_4a","custom":false,"description":"You can use your Reaction at any point to change your Stance instead of an Action. As part of the Reaction, you can make an Attack with a Melee Weapon with a 1d4 Attack Penalty.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Follow-up","avd12_id":"252_4b","custom":false,"description":"After making an Attack with a 1 Handed Melee Weapon, you quickly fire an Ultra-Light Ranged Weapon and Reload it if it has an Ammunition Capacity.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Weapon Master","avd12_id":"252_5","custom":false,"description":"Your Ranged Attack, Slashing Attack, Piercing Attack and Bludgeoning Attack Modifier all become equal to your highest value Ranged or Melee Attack Modifier","selected":false,"data":"AZR=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"1848e5c628964a97","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Assassin","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"203","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Skulker","avd12_id":"203_1","custom":false,"description":"Gain +1 Stealth and +1 Thievery","selected":true,"data":"AS4=1:ASA=1","cost":2},"option_2a":{"name":"Action : Deadly Poison","avd12_id":"203_2a","custom":false,"description":"You make an Attack with a Weapon or piece of Ammunition that is coated in Poison and roll a 1d4. If the Attack hits, instead of your Target becoming Poisoned, they take instantaneous Poison Damage as if the Poison lasted a number of rounds equal to the result of the d4.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Free Action : From the Shadows","avd12_id":"203_2b","custom":false,"description":"After making an Attack while Hidden, you roll a Stealth Check with a 1d4 Penalty and attempt to remain Hidden.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Quick and Silent","avd12_id":"203_3","custom":false,"description":"Gain +1 Steath and +1 Movement Speed","selected":false,"data":"AS4=1:AV=1","cost":2},"option_4a":{"name":"Stealth Specialist","avd12_id":"203_4a","custom":false,"description":"Gain +2 Attack when Hidden or Invisbile and your True Hit threshold is increased by 1.","selected":false,"data":"TO","cost":2},"option_4b":{"name":"Poisoned Blade","avd12_id":"203_4b","custom":false,"description":"Gain +1 Alchemy and +1 Damage to Piercing Weapons","selected":false,"data":"AC5=2:AZC=1","cost":2},"option_5":{"name":"Action: Assassinate","avd12_id":"203_5","custom":false,"description":"You make a quick and deadly attack with a Light 1 Handed Weapon. If you are Hidden deal an additional 2d8 Damage which is doubled in the event of a True Hit. If you are not Hidden, this Attack deals an extra 1d8 Damage and is also doubled in the event of a True Hit.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"fcabeecd4c7046a3","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Athlete","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"233","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Athlete","avd12_id":"233_1","custom":false,"description":"Gain +1 Athletics and +3 Health","selected":true,"data":"AS1=1:AH=3","cost":2},"option_2a":{"name":"Bodybuilding","avd12_id":"233_2a","custom":false,"description":"Gain +1 Strength. You can use your Strength Skill to avoid Grapples and Shove Attacks.","selected":false,"data":"AS2=1:TD","cost":2},"option_2b":{"name":"Overpowering Strikes","avd12_id":"233_2b","custom":false,"description":"Gain +1 Damage to Melee Attacks","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_3":{"name":"Athletic Prowess","avd12_id":"233_3","custom":false,"description":"Become Good at one Might Skill","selected":false,"data":"","cost":2},"option_4a":{"name":"Endurance Training","avd12_id":"233_4a","custom":false,"description":"Gain +1 Resilience. You do not suffer any new effects of Exhaustion until the end of Combat.","selected":false,"data":"AS6=1:TG","cost":2},"option_4b":{"name":"Sprinter","avd12_id":"233_4b","custom":false,"description":"Gain +1 Movement Speed. You can take the Move Action as a Free Action.","selected":false,"data":"AV=1:TG","cost":2},"option_5":{"name":"Mind and Body","avd12_id":"233_5","custom":false,"description":"Gain +1 Block, Dodge and Resistance","selected":false,"data":"AZ1=1:AZ3=1:AZ2=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"fb7a6b6b3c414f17","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Augaration Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"106","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Auger","avd12_id":"106_1","custom":false,"description":"You can research Beginner Level Auguration Spells and gain +1 Power.","selected":true,"data":"S51=4:FP=1","cost":2},"option_2a":{"name":"All Seeing","avd12_id":"106_2a","custom":false,"description":"Gain +1 Insight and +1 Search","selected":false,"data":"ASD=1:ASG=1","cost":2},"option_2b":{"name":"Foresight","avd12_id":"106_2b","custom":false,"description":"Gain +1 Initiative and +1 Resilience","selected":false,"data":"ASH=1:AS6=1","cost":2},"option_3":{"name":"Reaction : Rewind","avd12_id":"106_3","custom":false,"description":"At any point during your turn, you can use a Reaction to revert your last Action, refunding any resources that were used and any Health that was lost.","selected":false,"data":"","cost":2},"option_4a":{"name":"Potent Spells","avd12_id":"106_4a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_4b":{"name":"Fate Avoided","avd12_id":"106_4b","custom":false,"description":"Any time you roll a 1 on a Skill Check, roll a d4. If the result is a 4, treat the original 1 as a 12 instead.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Novice Auger","avd12_id":"106_5","custom":false,"description":"You can research Novice Level Auguration Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S52=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"A Touch of Luck","avd12_id":"106_6a","custom":false,"description":"Gain 1 Luck Dice","selected":false,"data":"L1","cost":2},"option_6b":{"name":"Predictive Defenses","avd12_id":"106_6b","custom":false,"description":"Gain +1 Dodge and +1 Block","selected":false,"data":"AD2=1:AD3=1","cost":2},"option_7":{"name":"Journeyman Auger","avd12_id":"106_7","custom":false,"description":"You can research Journeyman Level Druidic Spells, gain +5 Power and +1 Physical Mitigation","selected":false,"data":"S53=3:AD4=1:FP=5","cost":3},"option_8a":{"name":"Action : Split Fate","avd12_id":"106_8a","custom":false,"description":"The next Auguration Spell that you Channel before the end of your next turn that targets one Creature targets an additional Creature within range but costs double the Power.","selected":false,"data":"XX3","cost":2},"option_8b":{"name":"Visions in the Night","avd12_id":"106_8b","custom":false,"description":"When you complete a Full Rest with that you started with Full Health, you have dreams about possible futures and omens. When you wake, you roll a 1d12 Omen Dice which will affect your Crafting Checks and Skill Checks, with the exception of Defense and Attack Rolls. On a 1, your Checks suffer a 1d4 Penalty until the end of your next Full Rest. On a 9 or higher, they receive a 1d4 Bonus.","selected":false,"data":"TG","cost":2},"option_9":{"name":"Expert Auger","avd12_id":"106_9","custom":false,"description":"You can research Expert Level Auguration Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S54=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Free Action [Daily] : Reality Surge","avd12_id":"106_10a","custom":false,"description":"Whenever you would take your next Action, gain 1d4 Actions instead. When you roll a 4, you gain 1 Tier of Exhaustion after the Actions end.","selected":false,"data":"Y","cost":3},"option_10b":{"name":"Echoes of the Past","avd12_id":"106_10b","custom":false,"description":"When you handle Objects, you can identify any magical properties on them just by touching them. Additionally, if you spend 1 Hour interacting with an Object you can pick up echoes that grant more information about the item such as its history, previous owners or lore associated with it.","selected":false,"data":"TG","cost":3},"option_11":{"name":"Master Auger","avd12_id":"106_11","custom":false,"description":"You can research Master Level Auguration Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Auguration Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"711e974cb920462f","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Barbarian","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"243","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Barbarian Armor","avd12_id":"243_1","custom":false,"description":"You cannot wear Medium or Heavy Armor. Gain +1 Damage to Melee Attacks and +1 Physical Mitigation","selected":true,"data":"AZA=1:AZB=1:AZC=1:AZN=1:AD4=1","cost":2},"option_2a":{"name":"Whole of Body","avd12_id":"243_2a","custom":false,"description":"Gain +1 Strength and +3 Health","selected":false,"data":"AS2=1:AH=3","cost":2},"option_2b":{"name":"Mental Endurance","avd12_id":"243_2b","custom":false,"description":"Gain +1 Resilience and +2 Psychic Mitigation","selected":false,"data":"A6=1:AD9=1","cost":2},"option_3":{"name":"Path of the Barbarian","avd12_id":"243_3","custom":false,"description":"Become Good at Strength or Resilience","selected":false,"data":"","cost":2},"option_4a":{"name":"Reaction : Primal Fury","avd12_id":"243_4a","custom":false,"description":"When you are the Target of a True Hit, downgrade it to a normal hit but gain the Maddened Condition until the end of your next turn. This Condition cannot be nullified by Spells or Traits that cause Immunity to the Maddened Condition.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Reaction : Retaliate","avd12_id":"243_4b","custom":false,"description":"After taking Damage by a Creature within your Melee Range, you can make a Melee Attack as a Reaction.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Action : In the Thick","avd12_id":"243_5","custom":false,"description":"You gain a bonus equal to your Resilience Modifier to all Mitigations and a 1d4 Bonus to your Melee Attacks until the end of your next turn.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"2322b05566124113","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Bard","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"125","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Ballads","avd12_id":"125_1","custom":false,"description":"You gain the ability to play Ballads which require an Action to start and your Focus to maintain which affect anyone within 4 Units who can hear. Learn 1 Ballad of your choice.","selected":true,"data":"TB","cost":2},"option_2a":{"name":"Showmanship","avd12_id":"125_2a","custom":false,"description":"You become Good at the Performance Skill","selected":false,"data":"","cost":2},"option_2b":{"name":"Prodigy","avd12_id":"125_2b","custom":false,"description":"Gain +1 Concentration and +1 Academics","selected":false,"data":"AS5=1:AS9=1","cost":2},"option_3":{"name":"Growing Repertoire","avd12_id":"125_3","custom":false,"description":"Learn 2 Ballads","selected":false,"data":"","cost":2},"option_4a":{"name":"Reaction : Segue","avd12_id":"125_4a","custom":false,"description":"You seamlessly change the Ballad you are playing which takes effect immediately.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Attacca","avd12_id":"125_4b","custom":false,"description":"You quickly start a new Ballad","selected":false,"data":"Y","cost":2},"option_5":{"name":"Reaction : Motif","avd12_id":"125_5","custom":false,"description":"You Target an allied Creature who can hear a Ballad you are playing and use one of their listed Reactions. This does not count against their usage limit or consume their Reaction for this round.","selected":false,"data":"ZX2","cost":2},"option_6a":{"name":"Immune to Critique","avd12_id":"125_6a","custom":false,"description":"Gain +1 Resistance and +2 Psychic Mitigation","selected":false,"data":"AD1=1:AD9=2","cost":2},"option_6b":{"name":"Versatile Musician","avd12_id":"125_6b","custom":false,"description":"Learn 2 Ballads","selected":false,"data":"","cost":2},"option_7":{"name":"Medley","avd12_id":"125_7","custom":false,"description":"While you are Focusing on a Ballad, you can use another Action to start an additional Ballad. If you lose your Focus on one, both end.","selected":false,"data":"TG","cost":2},"option_8a":{"name":"Reaction : Inspire","avd12_id":"125_8a","custom":false,"description":"As a Reaction to a Creature who can hear your Ballad making a Defense, Attack or Skill Check, add 1d4 to that Check. If you are Good at Performance, add 1d6 instead.","selected":false,"data":"ZX2","cost":2},"option_8b":{"name":"Action : Dissonance","avd12_id":"125_8b","custom":false,"description":"You suddenly end a Ballad with a harsh note or chord, forcing all Creatures that can hear your Ballad to make a Resistance Check against your Performance Check or take Psychic Damage equal to your Performance Check","selected":false,"data":"XX3","cost":2},"option_9":{"name":"Reaction : Resonating Powerchord","avd12_id":"125_9","custom":false,"description":"You finish a Ballad you have been playing for one or more rounds with an expert powerchord. This causes the effect of your Ballad to last 1 minute instead of ending instantly.","selected":false,"data":"ZX2","cost":3},"option_10a":{"name":"Action : Accelerando","avd12_id":"125_10a","custom":false,"description":"You speed up a Ballad you are currently playing, granting all allies who can hear it an additional Free Action until the start of your next turn.","selected":false,"data":"XX3","cost":3},"option_10b":{"name":"Star of the Show","avd12_id":"125_10b","custom":false,"description":"Gain +1 Performance, +1 Persuasion and +4 Psychic Mitigation","selected":false,"data":"ASC=1:ASE=1:AD9=4","cost":3},"option_11":{"name":"Masterpiece","avd12_id":"125_11","custom":false,"description":"Learn 1 Masterpiece Ballad","selected":false,"data":"","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d3e80454b7a6426d","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Battledancer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"273","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"The Way of the Battle Dancer","avd12_id":"273_1","custom":false,"description":"Gain +1 Athletics and +1 to Damage with Unarmed Strikes","selected":true,"data":"AZN=1:AS1=1","cost":2},"option_2a":{"name":"Action : Circle Kick","avd12_id":"273_2a","custom":false,"description":"Make an Unarmed Attack against a Creature. You can then Move up to your Movement Speed as long as remain Adjacent to your initial Target regardless if the Attack is successful. Your next Melee Attack this turn against a Creature other than the original Target has a 1d4 Attack Bonus.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Action : Sweeping Kick","avd12_id":"273_2b","custom":false,"description":"Make a Contested Check against a Target one Size Larger than you or smaller using your Performance against their Acrobatics or Athletics Skill. If successful, the Creature becomes Prone and takes Physical Damage equal to the result of your Check.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Performer","avd12_id":"273_3","custom":false,"description":"Gain +1 Performance and +1 Acrobatics","selected":false,"data":"ASE=1:AS3=1","cost":2},"option_4a":{"name":"Dancing Strikes","avd12_id":"273_4a","custom":false,"description":"Gain +1 Attack with Unarmed Strikes","selected":false,"data":"AZM=1","cost":2},"option_4b":{"name":"Elusive Dance","avd12_id":"273_4b","custom":false,"description":"Gain +1 Dodge","selected":false,"data":"AD2=1","cost":2},"option_5":{"name":"Reaction : Lunging Kick","avd12_id":"273_5","custom":false,"description":"When an Ally within 4 Units is the Target of a Melee Attack, quickly dash without provoking Reactions to a Tile that is Adjacent to both your Ally and the provoking Creature and make an Unarmed Attack. If the Attack Hits, the Attacking Creature suffers a 1d4 Penalty to their Attack.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"42fc3d8d851f48fb","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Battlemage","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"204","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Close Combat Specialist","avd12_id":"204_1","custom":false,"description":"Gain +1 Concentration and Gain +1 Strength","selected":true,"data":"AS5=1:AS2=1","cost":2},"option_2a":{"name":"Quick Cast","avd12_id":"204_2a","custom":false,"description":"Removes 1 Action of Cast Penalty from Medium or Heavy Armor","selected":false,"data":"W3DZ:W2DZ","cost":2},"option_2b":{"name":"Innate Spells","avd12_id":"204_2b","custom":false,"description":"Learn Two Beginner Spells and Two Novice Spells from any one Traditional School of Magic","selected":false,"data":"SV1=2","cost":2},"option_3":{"name":"Reaction : Endure","avd12_id":"204_3","custom":false,"description":"If you are forced to make a Concentration Check after taking Damage to maintain your Focus, choose to succeed automatically.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Dual Training","avd12_id":"204_4a","custom":false,"description":"Gain +1 to Melee Attacks and +1 Spell Attack","selected":false,"data":"AZ6=1:AZ7=1:AZ8=1:AZM=1:AZ2=1","cost":2},"option_4b":{"name":"Battlemagic","avd12_id":"204_4b","custom":false,"description":"Gain +1 Spell Damage and +1 Physical Mitigation","selected":false,"data":"AZ4=1:AD4=1","cost":2},"option_5":{"name":"Free Action : Spell Combo","avd12_id":"204_5","custom":false,"description":"If you hit an enemy with a Melee Weapon, you Channel a Spell that takes only 1 Action. This Spell cannot be Charged.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9c4a3e44a2004870","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Beast Friend","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"257","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action : Calm Beast","avd12_id":"257_1","custom":false,"description":"You target a Hostile Beast and attempt to calm it by making an Animal Check against a Required Check of 3 + the Level of the Beast. If successful, the Creature is considered Charmed by you for 1 Hour where it will attempt to follow your commands to the best of its ability. Only one Beast can be Charmed in this way at a time.","selected":true,"data":"XX3","cost":2},"option_2a":{"name":"Safe Animal Handling","avd12_id":"257_2a","custom":false,"description":"Gain +1 Animals and +1 Stealth","selected":false,"data":"ASF=2:AS4=1","cost":2},"option_2b":{"name":"Primal Knowledge","avd12_id":"257_2b","custom":false,"description":"Gain +1 Wilderness and +1 Initiative","selected":false,"data":"ASB=1:ASH=1","cost":2},"option_3":{"name":"Tamer","avd12_id":"257_3","custom":false,"description":"Your Maximum Pet Level for Beasts becomes equal to your Level - 2 with a minimum of 2.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Unburdened Pet","avd12_id":"257_4a","custom":false,"description":"Your Pets are not subjected to the Pet Action Limits and can utilize their full Statblock.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Durable Pet","avd12_id":"257_4b","custom":false,"description":"Your Pets gain maximum Health equal to your Level and +2 Physical Mitigation.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Extra Pet","avd12_id":"257_5","custom":false,"description":"The maximum amount of Pets you can have is increased by 1. Additionally, you can keep one Level 0 Pet that does not count against your Pet limit.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"74263aa45e43404c","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Berserker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"207","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Savage","avd12_id":"207_1","custom":false,"description":"Lose 2 Dodge and Block while gaining +2 Damage to all Melee Weapons and +1 to Melee Attacks","selected":true,"data":"AD2=-2:AD3=-2:AZ3=2:AZ6=1:AZ7=1:AZ8=1:AZM=1","cost":2},"option_2a":{"name":"Ferocious Strikes","avd12_id":"207_2a","custom":false,"description":"Gain +1 Damage to Melee Attacks and +1 Strength","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1:AS2=1","cost":2},"option_2b":{"name":"Warrior","avd12_id":"207_2b","custom":false,"description":"Gain +1 Resilience and +3 Health","selected":false,"data":"AS6=1:AH=3","cost":2},"option_3":{"name":"Reaction : Berserker Endurance","avd12_id":"207_3","custom":false,"description":"In response to being the target of a Melee Attack, you make a Resilience Check instead of a Block or Dodge Check agains the Attack Check. On a success, you do not take any Damage. On a failure, you reduce the Damage by a result equal to your Resilience Check.","selected":false,"data":"AD4=1:ADA=1","cost":2},"option_4a":{"name":"Unyielding","avd12_id":"207_4a","custom":false,"description":"You do not suffer the negative effects of being in Lifeline until you reach 1 Lifeline point, at which point you fall Unconcious","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Executer","avd12_id":"207_4b","custom":false,"description":"You can Critically Hit with any Melee Weapon or Unarmed Attack.","selected":false,"data":"TO","cost":2},"option_5":{"name":"Free Action : Fury Swipe","avd12_id":"207_5","custom":false,"description":"Directly after taking the Attack Action, you make an additional Attack with a 1d4 Penalty.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"4f127f415eec4f76","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Bloodmage","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"276","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Toughened","avd12_id":"276_1","custom":false,"description":"Gain +1 Resilience and +2 Dark Mitigation","selected":true,"data":"AS6=1:AD7=2","cost":2},"option_2a":{"name":"Siphon","avd12_id":"276_2a","custom":false,"description":"When a Creature other than you takes Damage from Bleeding while Adjacent to you, you gain Health equal to the damage they took. If this brings you to full Health or over, gain Temporary Health equal to your Level that lasts until the start of your next turn.","selected":false,"data":"TD","cost":2},"option_2b":{"name":"Lesser Fiend Magic","avd12_id":"276_2b","custom":false,"description":"Learn 2 Beginner and 2 Novice Fiend Spells","selected":false,"data":"","cost":2},"option_3":{"name":"Action : Bloodlet","avd12_id":"276_3","custom":false,"description":"Make an Attack or use the Channel Action to cast a Spell that takes 1 Action. If the Attack deals Physical Damage after Mitigation is calculated, the target gains the Bleeding Condition.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Improved Essence Burn","avd12_id":"276_4a","custom":false,"description":"Your Essence Burns are more efficient, lowering the damage die from 1d8 to 1d4 per Power you are attempting to restore. On a failure, the damage dice becomes 1d8 instead of 1d12.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Free Action : Bloodmagic","avd12_id":"276_4b","custom":false,"description":"You let your own blood with a Light 1-Handed Weapon, dealing 1d6 True Damage to yourself. The next Spell that you complete on this turn becomes Charged and the Spell Damage Bonus Modifier is doubled.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Master Bloodmage","avd12_id":"276_5","custom":false,"description":"Gain +1 Spell Attack, +1 Spell Damage and +2 Health","selected":false,"data":"AZ2=1:AZ4=1:AH=2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"c6f214a7622841b2","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Bounty Hunter","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"278","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action : Focused Hunt","avd12_id":"278_1","custom":false,"description":"You use your Focus to concentrate on eliminating or capturing one Creature within 20 Units. While you maintain your Focus, you gain +2 Movement Speed towards that Creature and gain a +2 Attack Bonus Modifier but have a -2 Attack Bonus Modifier against all other Creatures.","selected":true,"data":"XX3","cost":2},"option_2a":{"name":"First to Act","avd12_id":"278_2a","custom":false,"description":"You become Good at Initiative","selected":false,"data":"","cost":2},"option_2b":{"name":"Improved Nets","avd12_id":"278_2b","custom":false,"description":"When you use a Net, the Required Check for avoiding a Grapple is increased by 2 and the Structure Points are doubled.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Information Gatherer","avd12_id":"278_3","custom":false,"description":"Gain +1 Search and +1 Insight","selected":false,"data":"ASG=1:ASD=1","cost":2},"option_4a":{"name":"Action : Wanted Alive","avd12_id":"278_4a","custom":false,"description":"You Touch a Creature that is in Lifeline and cause them to become Unconscious and no longer lose Lifeline Points at the end of their turn. You can also make this Check against a Humanoid that has Died after the end of your last turn by making a Medicine Check of 10 or higher.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Reaction : Quick Draw","avd12_id":"278_4b","custom":false,"description":"Before your turn in Initiative Order, you can take the Use Action or make a Ranged Attack with a Light or Ultra-Light Ranged Weapon.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Craft : Trophy Infusion","avd12_id":"278_5","custom":false,"description":"You can collect a trophy from a corpse and use it as an Infusion while crafting a Weapon, Shield or piece of Armor that does not increase the difficulty of the Required Check. While you have this item equipped, you gain a +2 Bonus to Block, Dodge and Resistance against Creatures that are equal to or lower Level and the same Creature Type as the trophy.","selected":false,"data":"O","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"fba4dafa79ef4485","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Brawler","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"224","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Free Action : Kick","avd12_id":"224_1","custom":false,"description":"When you successfully hit a Target with a Slashing, Crushing or Piercing Weapon, you can follow it up with an Unarmed Strike.","selected":true,"data":"Y","cost":2},"option_2a":{"name":"Action : Windup","avd12_id":"224_2a","custom":false,"description":"You prepare a vicious strike, winding up for a powerful blow. Until the end of your turn, you cannot Move but gain a +1d4 Bonus on your next Attack with a Unarmed or Melee Weapon. If that attack hits, it is upgraded to a Brutal Critical.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Tough as Nails","avd12_id":"224_2b","custom":false,"description":"Gain +1 Resilience and +3 Health","selected":false,"data":"AH=3:AS6=1","cost":2},"option_3":{"name":"Melee Specialist","avd12_id":"224_3","custom":false,"description":"Gain +1 Attack with Slashing, Piercing, Crushing and Unarmed Strikes","selected":false,"data":"AZ6=1:AZ7=1:AZ8=1:AZM=1","cost":2},"option_4a":{"name":"Scrapper","avd12_id":"224_4a","custom":false,"description":"Your Unarmed Attack Modifier becomes equal to the highest of your Slashing, Piercing or Crushing Attack Modifiers","selected":false,"data":"TYB","cost":2},"option_4b":{"name":"Impact Fighting","avd12_id":"224_4b","custom":false,"description":"Gain +1 Damage to all Melee Attacks","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_5":{"name":"Effective Blows","avd12_id":"224_5","custom":false,"description":"Your Unarmed Strikes deal extra damage equal to your Strength Bonus Modifier instead of your Unarmed Bonus Modifier. Additionally, your True Hits with Slashing, Crushing, Piercing and Unarmed Strikes are upgraded to Critical Hits.","selected":false,"data":"TYA","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"250444fbdabf48f6","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Bruiser","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"231","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Enforcer","avd12_id":"231_1","custom":false,"description":"Lose 1 Block and Dodge while gaining +2 Physical Mitigation and +1 Elemental Mitigation.","selected":true,"data":"AD4=2:AD2=-1:AD3=-1:ADA=1","cost":2},"option_2a":{"name":"Unforgiving Strikes","avd12_id":"231_2a","custom":false,"description":"Gain +1 Damage to Melee Attacks","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_2b":{"name":"Engager","avd12_id":"231_2b","custom":false,"description":"Gain +1 Movement Speed and +1 Athletics","selected":false,"data":"AV=1:AS1=1","cost":2},"option_3":{"name":"Vigorous","avd12_id":"231_3","custom":false,"description":"Gain +2 Health and +1 Resilience","selected":false,"data":"AH=2:AS6=1","cost":2},"option_4a":{"name":"Free Action : Pummel","avd12_id":"231_4a","custom":false,"description":"When you score a True Hit on a Creature, roll a Contested Athletics Check against their Resilience. On a failure, the Creature becomes Stunned.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Action : Shieldbreaker","avd12_id":"231_4b","custom":false,"description":"Make an Attack with a Melee Weapon with a 1d4 Bonus Modifier. If your Attack hits, the affected Creature has a Penalty to their next Block Check before the start of their next turn equal to the result of the d4.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Frontliner","avd12_id":"231_5","custom":false,"description":"Gain +1 to all Mitigations","selected":false,"data":"ADA=1:AD7=1:AD8=1:AD4=1:AD9=1:ADC=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"adc1d8f220f047f2","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Bulwark","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"253","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Bulwark","avd12_id":"253_1","custom":false,"description":"While you are wielding a Heavy Shield, you also gain partial cover from Ray Attacks. Additionally, if you take the Defense Action, the bonus you receive from partial cover is doubled until the start of your next turn while you are wielding a Heavy Shield.","selected":true,"data":"TD","cost":2},"option_2a":{"name":"Shield Expert","avd12_id":"253_2a","custom":false,"description":"Remove Dodge, Stealth and Movement Speed Penalties while using Shields","selected":false,"data":"W5DR=1","cost":2},"option_2b":{"name":"Hearty","avd12_id":"253_2b","custom":false,"description":"Gain +5 Health","selected":false,"data":"AH=5","cost":2},"option_3":{"name":"Shield Master","avd12_id":"253_3","custom":false,"description":"Gain +1 Block while wielding a Shield","selected":false,"data":"W5D3=1","cost":2},"option_4a":{"name":"Action : Hold the Line","avd12_id":"253_4a","custom":false,"description":"Your Movement Speed becomes 0. You can maintain this indefinitely until you are Knocked Prone, or Stunned.  It costs 1 Action per turn to round the line, otherwise the effect ends.  While this ability is active, hostile Creatures cannot pass through an area in a 1 Unit radius around you.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Shield Charge","avd12_id":"253_4b","custom":false,"description":"You Move up to your Movement Speed, but at least 4 Units towards a Creature and make a Shove Attack. If successful, the Creature takes 1d6 Fall Damage and lands prone 1 Unit behind you.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Reaction : Critical Block","avd12_id":"253_5","custom":false,"description":"When you roll a 12 on a Block Check, the Attack misses, regardless of the enemy roll. Additionally, if the Creature that Attacked you is within your Melee Range, you can make a counter Attack with a 1-Handed Weapon that is upgraded to a True Hit if it hits.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"4a67acf234374430","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Cavalier","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"221","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Free Action : As One","avd12_id":"221_1","custom":false,"description":"You control your Mount with a Free Action instead of an Action, allowing it to use two actions.","selected":true,"data":"Y","cost":2},"option_2a":{"name":"Skilled Rider","avd12_id":"221_2a","custom":false,"description":"Gain +1 Animals and +1 Athletics","selected":false,"data":"AS1=1:ASF=1","cost":2},"option_2b":{"name":"Saddle Shot","avd12_id":"221_2b","custom":false,"description":"While mounted, you are not penalized for using ranged weapons against targets closer than your minimum range.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Cavalier Stance","avd12_id":"221_3","custom":false,"description":"You gain the Cavalier Stance, which you automatically assume when you Mount a friendly Creature.","selected":false,"data":"H=21","cost":2},"option_4a":{"name":"Mount Tamer","avd12_id":"221_4a","custom":false,"description":"Gain +1 Animals. When you Mount a Pet for the first time after a Full Rest, it gains Temporary Health equal to your Level.","selected":false,"data":"ASF=1:TG","cost":2},"option_4b":{"name":"Reigns of Steel","avd12_id":"221_4b","custom":false,"description":"Gain +1 Athletics. When you or your Mount take the Defense Action, the other also gets the benefit.","selected":false,"data":"AS1=1:TD","cost":2},"option_5":{"name":"Reaction : Mounted Maneuver","avd12_id":"221_5","custom":false,"description":"In response to an Attack against you or the Creature you currently have Mounted that requires a contested Block or Dodge Check, make a Check with your Athletics Skill instead. If the Attack still hits, it is Mitigated by an amount equal to both you and your Mounts combined Mitigation to that Damage.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"b5ab92b98de94006","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Champion","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"213","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Glory Shield","avd12_id":"213_1","custom":false,"description":"When you kill an enemy with a Melee Weapon, you gain Temporary Health equal to the Level of the Enemy killed that lasts for 1 minute.","selected":true,"data":"TO","cost":2},"option_2a":{"name":"Flexible Armor","avd12_id":"213_2a","custom":false,"description":"Gain +2 Dodge while wearing Medium Armor or Heavy Armor","selected":false,"data":"W2D2=2","cost":2},"option_2b":{"name":"Champion","avd12_id":"213_2b","custom":false,"description":"Gain +1 Damage to Melee Attacks and +1 Athletics","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1:AS1=1","cost":2},"option_3":{"name":"Free Action : Brutalize","avd12_id":"213_3","custom":false,"description":"When you deal a killing blow to an Enemy, you can use your Free Action to brutally savage them. You make a Contested Performance Check against the Resilience of any Enemy within 4 Units. On a success, they become Afraid of you until the start of your next turn.","selected":false,"data":"Y","cost":2},"option_4a":{"name":"Shotcaller","avd12_id":"213_4a","custom":false,"description":"Your Called Shots do not suffer an Attack Penalty","selected":false,"data":"TO","cost":2},"option_4b":{"name":"Gladiator","avd12_id":"213_4b","custom":false,"description":"Gain +1 Block and +1 Damage to Piercing Weapons","selected":false,"data":"AD3=1:AZC=1","cost":2},"option_5":{"name":"Action [Daily]: Finisher","avd12_id":"213_5","custom":false,"description":"Make an Attack against a Creature which is an automatic True Hit if it lands. If the Target is Afraid, this Attack gains a 1d4 Bonus. If you use the Brutalize Free Action after making this Attack, this Action is refunded.","selected":false,"data":"XD1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"0c156a55b5624555","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Chef","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"127","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Chef","avd12_id":"127_1","custom":false,"description":"Gain +2 Cooking","selected":true,"data":"TC:AC2=2","cost":2},"option_2a":{"name":"Snack Crafter","avd12_id":"127_2a","custom":false,"description":"Add 1 Dice to any Temporary Health bonuses provided by consuming Snacks cooked by you.","selected":false,"data":"TC","cost":2},"option_2b":{"name":"Meal Crafter","avd12_id":"127_2b","custom":false,"description":"Add 1 Dice to any Health recovery bonuses provided by consuming Meals cooked by you.","selected":false,"data":"TC","cost":2},"option_3":{"name":"Mixologist","avd12_id":"127_3","custom":false,"description":"Gain +1 Alchemy and +1 Cooking","selected":false,"data":"AC5=1:AC2=1","cost":2},"option_4a":{"name":"Spice Up Your Life","avd12_id":"127_4a","custom":false,"description":"Gain +1 Resilience and +2 Fire Mitigation","selected":false,"data":"AS6=1:AD6=2","cost":2},"option_4b":{"name":"Salvager","avd12_id":"127_4b","custom":false,"description":"Whenever you fail making a Snack or Meal, you can make one additional attempt before losing all the ingredients.","selected":false,"data":"TC","cost":2},"option_5":{"name":"Fortifying Food","avd12_id":"127_5","custom":false,"description":"Anyone who consumes a Snack or Meal cooked by you gains +1 Resistance and Power equal to your Cooking Modifier the next time they take a Breather. A creature can only benefit from this once per day and it expires after their next Full Rest.","selected":false,"data":"TC","cost":2},"option_6a":{"name":"Efficient Chef","avd12_id":"127_6a","custom":false,"description":"You create twice the amount of Snacks and Meals with the same amount of ingredients and time.","selected":false,"data":"TC","cost":2},"option_6b":{"name":"Hide with Flavor","avd12_id":"127_6b","custom":false,"description":"You can combine a Potion with a Meal or Snack. When a Creature consumes the Meal or Snack, they gain the effects of the Potion. If the effect is negative and has a Required Check to avoid, that Check is increased by 2.","selected":false,"data":"TC","cost":2},"option_7":{"name":"Advanced Cooking","avd12_id":"127_7","custom":false,"description":"Gain +1 Cooking and access to Cooking Augmentations","selected":false,"data":"TC:AC2=1","cost":2},"option_8a":{"name":"Reaction : Lucky Pan","avd12_id":"127_8a","custom":false,"description":"When you are forced to make a Block Check, add a +3 if you have a Cooking Pan in your inventory.","selected":false,"data":"ZX2","cost":2},"option_8b":{"name":"Healthy Eating, Healthy Life","avd12_id":"127_8b","custom":false,"description":"Gain +5 Health","selected":false,"data":"AH=5","cost":2},"option_9":{"name":"Critical Cook","avd12_id":"127_9","custom":false,"description":"Gain +1 Cooking. When you Overcraft on a Cooking Check, your Cooking Modifier is doubled when it is applied to bonuses on your Meals and Snacks.","selected":false,"data":"TC","cost":3},"option_10a":{"name":"Nutritionist","avd12_id":"127_10a","custom":false,"description":"Gain +1 Alchemy, +1 Medicine and +1 Cooking.","selected":false,"data":"AS8=1:AC2=1:AC5=1","cost":3},"option_10b":{"name":"Good Food, Sweet Dreams","avd12_id":"127_10b","custom":false,"description":"Anyone who consumes a Meal cooked by you gets credit for Favorable Rest no matter the conditions. Additionally, they recover extra Power on their Conduit equal to your Cooking Modifier.","selected":false,"data":"TC","cost":3},"option_11":{"name":"Perfect Meals","avd12_id":"127_11","custom":false,"description":"Gain +1 Cooking. Any Meal or Snack created by you always gives the maximum amount of Temporary Health, Health Recovery and Healing instead of rolling.","selected":false,"data":"AC2=1:TC","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"24a622832a4344fe","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Chucker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"222","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Precise Throwing","avd12_id":"222_1","custom":false,"description":"Your Throwing Attacks with Weapons gain a +2 Bonus to their Attack Check.","selected":true,"data":"TYT","cost":2},"option_2a":{"name":"Boomerang","avd12_id":"222_2a","custom":false,"description":"When you throw a Light 1-Handed Weapon or Throwing Ammunition, it returns to your hand if the Attack hits.","selected":false,"data":"TO","cost":2},"option_2b":{"name":"Throwing Arm","avd12_id":"222_2b","custom":false,"description":"You use your Athletics Modifier as the Attack Check for throwing Weapons, instead of the Weapon Skill Modifier.","selected":false,"data":"TYS","cost":2},"option_3":{"name":"Improved Throw","avd12_id":"222_3","custom":false,"description":"You can throw Heavy 1-Handed Weapons and gain +2 Range on all Throwing Attacks. Addtionally, gain +1 Athletics.","selected":false,"data":"TYU:AS1=1","cost":2},"option_4a":{"name":"Action : Skillshot","avd12_id":"222_4a","custom":false,"description":"Make a Throwing Weapon Attack or Throw a Small Object with no Penalty while throwing outside your Minimum or Maximum Range up to twice your Maximum Range, ignoring Partial Cover. The True Hit threshold on this Attack is increased by 2.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Ricochet","avd12_id":"222_4b","custom":false,"description":"Make a Throwing Weapon Attack and target an additional Creature within 2 units of your original target.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Reaction : Throwback","avd12_id":"222_5","custom":false,"description":"In response to being the single Target of a Projectile Attack, gain a 1d4 Bonus to your Defense Check. If you successfully Block or Dodge the Projectile, you can redirect it to a Target within your Throwing Range using your initial Defense Check as the Attack Check. If this Attack hits, it is upgraded to a True Hit.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"2e5eeb3d2e374eab","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Clearmind","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"254","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Clearmind","avd12_id":"254_1","custom":false,"description":"You are proficient in relaxing your mind and recharging and can maintain a Full Rest within half the usual time.  Additionally, when you complete a Full Rest, you cannot gain less than twice your level in Health even if you are Wounded.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Focused","avd12_id":"254_2a","custom":false,"description":"Gain +1 Concentration and +1 Resilience ","selected":false,"data":"AS6=1:AS5=1","cost":2},"option_2b":{"name":"Mental Protection","avd12_id":"254_2b","custom":false,"description":"Gain +4 Psychic Mitigation","selected":false,"data":"AD9=4","cost":2},"option_3":{"name":"Action [Daily] : Center","avd12_id":"254_3","custom":false,"description":"You spend an Action to remove any Poison, Ignited, Diseased, Blinded, Dazed, Stunned or Deafened Conditions affecting you.","selected":false,"data":"XD1","cost":2},"option_4a":{"name":"Free Action : Manifest Success","avd12_id":"254_4a","custom":false,"description":"After rolling an Attack as part of an Action where the number on the die is less than a 6, add an additional 1d4 to your total.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Never Tired","avd12_id":"254_4b","custom":false,"description":"You are Immune to becoming Exhausted and effects that make you Sleep.","selected":false,"data":"I=21:I=10","cost":2},"option_5":{"name":"Reaction : Mind Over Matter","avd12_id":"254_5","custom":false,"description":"When you take Damage as part of an Attack, convert all the damage to Psychic and halve it before applying the Mitigation.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"40bc0d4cac164ed7","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Commander","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"210","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Leadership","avd12_id":"210_1","custom":false,"description":"Gain +1 Persuasion and +1 Insight","selected":true,"data":"ASC=1:ASD=1","cost":2},"option_2a":{"name":"Reaction : Guidance","avd12_id":"210_2a","custom":false,"description":"In response to an Ally being the Target of an Attack Roll, grant them a 1d4 Bonus to their Defensive Checks until the start of their turn.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Free Action : Forced March","avd12_id":"210_2b","custom":false,"description":"You command an Ally to Move up to 2 Units without provoking Reactions.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Lead from the Front","avd12_id":"210_3","custom":false,"description":"Gain +1 Physical Mitigation, +2 Psychic Mitigation and +2 Health","selected":false,"data":"AD4=1:AD9=2:AH=2","cost":2},"option_4a":{"name":"Born Commander","avd12_id":"210_4a","custom":false,"description":"Become Good at Persuasion","selected":false,"data":"","cost":2},"option_4b":{"name":"Free Action : Lead by Example","avd12_id":"210_4b","custom":false,"description":"When you land a killing blow on an Enemy, you can grant an Ally within 10 Units Temporary Health equal to your Persuasion Modifier. If the killing blow was a True Hit, you gain a Heroic Action.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Coordinator","avd12_id":"210_5","custom":false,"description":"If two or more Allies are within 1 Unit of a target, all Melee Attacks on that target have a +2 Attack Bonus","selected":false,"data":"TO","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"bc63aa91061a4e7d","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Companion","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"268","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action [Daily] : Designitate Companion","avd12_id":"268_1","custom":false,"description":"You Choose an Ally with 10 Units and designate them as your Companion until a new one is picked using this Action again. When you or your Companion makes a Lifeline Check within 10 Units of each other, gain a 1d4 Bonus.","selected":true,"data":"XD1","cost":2},"option_2a":{"name":"Helpful","avd12_id":"268_2a","custom":false,"description":"Skill Checks that you Assist your Companion on do not suffer a Negative Modifier when failing and successful use of an Assisted Check adds a +3 Bonus Modifier instead of +2.","selected":false,"data":"TG","cost":2},"option_2b":{"name":"Empathetic","avd12_id":"268_2b","custom":false,"description":"Gain +1 Insight and +1 Animals","selected":false,"data":"ASD=1:ASF=1","cost":2},"option_3":{"name":"Confidence in Allies","avd12_id":"268_3","custom":false,"description":"Your Companion gains a 1d4 Bonus to all Resistance Checks while within 15 Units of you.","selected":false,"data":"TD","cost":2},"option_4a":{"name":"Action : Coordinate","avd12_id":"268_4a","custom":false,"description":"If your Companion is within 20 Units, you move their Initiative Order to yours. This can only be used once per Engagement.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Free Action : Coordinated Assault","avd12_id":"268_4b","custom":false,"description":"Your Companion gains an extra 1d4 Attack Bonus to their next Weapon Attack.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Reaction : Motivate","avd12_id":"268_5","custom":false,"description":"Your Companion immediately takes an Action.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"286a9fd68a5441a9","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Conduit","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"286","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Natural Magic","avd12_id":"286_1","custom":false,"description":"You cannot benefit from a conduit, but instead become your own conduit, gaining a base power and power regeneration equal to double your level.","selected":true,"data":"TYN","cost":2},"option_2a":{"name":"Free Action : Amplify","avd12_id":"286_2a","custom":false,"description":"After Channeling a Spell, spend an additional 1 power to charge it","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Magical Instinct","avd12_id":"286_2b","custom":false,"description":"Gain +1 Initiative and +1 Spell Damage","selected":false,"data":"ASH=1:AZ4=1","cost":2},"option_3":{"name":"Focused Power","avd12_id":"286_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Action [Daily] : Restorance","avd12_id":"286_4a","custom":false,"description":"Once per day, you restore power to either yourself or a conduit in an amount equal to 2d4 + your Spell Damage. The dice increases to 2d8 at level 7 and 3d10 at level 9.","selected":false,"data":"XD1","cost":2},"option_4b":{"name":"Mind for Magic","avd12_id":"286_4b","custom":false,"description":"Gain +1 Arcanum, +1 Resistance and +2 Psychic Mitigation","selected":false,"data":"AS7=1:AD1=1:AD9=2","cost":2},"option_5":{"name":"Reaction : Absorption","avd12_id":"286_5","custom":false,"description":"In response to a spell being channeled against you, use resistance as your defense check. On a failure, if the spell has a damage component, reduce that by half before applying mitigations. On a success, the spell does not affect you and you gain power equal to the amount used to channel the spell.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"139981a4ba87410b","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Control Mage","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"263","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Potent Knowledge","avd12_id":"263_1","custom":false,"description":"Gain +1 Spell Damage and +1 Arcanum","selected":true,"data":"AZ4=1:AS7=1","cost":2},"option_2a":{"name":"Free Action : Spellsnipe","avd12_id":"263_2a","custom":false,"description":"Directly after Channeling a Spell, you spend 1 Power to double the Range of it.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Free Action : Spellsculpt","avd12_id":"263_2b","custom":false,"description":"Directly after Channeling a Spell, you spend 1 Power to change the Damage Type to Arcane or any Elemental Damage Type.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Tamed Magic","avd12_id":"263_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Free Action : Careful Spell","avd12_id":"263_4a","custom":false,"description":"Directly after Channeling a Line, Area or Cone Spell, you spend 2 Power, causing the Spell to ignores allies until the start of your next turn.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Free Action : Expanded Spell","avd12_id":"263_4b","custom":false,"description":"Directly after Channeling a Line, Area or Cone Spell, you spend 2 Power to increase the Radius, Width or Size of the Spell by 2 Units.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Master of Control","avd12_id":"263_5","custom":false,"description":"Any time you use a Free Action from the Control Mage Module to cast a Spell, that Spell automatically becomes charged.","selected":false,"data":"TO","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"abd04195ef8642b2","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Cosmic Knight","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"262","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Innate Cosmic Magic","avd12_id":"262_1","custom":false,"description":"Learn 2 Beginner and 2 Novice Spells from the Cosmic School of magic","selected":true,"data":"","cost":2},"option_2a":{"name":"Free Action : Cosmic Charge","avd12_id":"262_2a","custom":false,"description":"You spend 2 Power to Charge a Cosmic Spell that is being Channeled. If under Direct Starlight, this charge does not consume power.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Free Action : Cosmic Wrath","avd12_id":"262_2b","custom":false,"description":"You spend one Power and make an infused Melee or Ranged Attack. If in Direct Sunlight, the Physical Damage of the Weapon is converted to Fire. Otherwise, the Damage becomes Arcane.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Expansive Mind","avd12_id":"262_3","custom":false,"description":"Gain +1 Resistance and +2 Arcane Mitigation","selected":false,"data":"AD1=1:ADC=1","cost":2},"option_4a":{"name":"Armor of the Cosmic Knight","avd12_id":"262_4a","custom":false,"description":"Gain +1 Block while wielding a Shield and +1 Physical Mitigation when wearing Medium or Heavy armor.","selected":false,"data":"W2D4=1:W5D3=1","cost":2},"option_4b":{"name":"Weapons of the Cosmic Knight","avd12_id":"262_4b","custom":false,"description":"Gain +1 Attack with Ranged, Slashing, Piercing and Crushing Weapons","selected":false,"data":"AZ6=1:AZ8=1:AZ7=1:AZ5=1","cost":2},"option_5":{"name":"Action : Flight of Ahkaris","avd12_id":"262_5","custom":false,"description":"Until the end of your next turn, you gain a Magical Flight Speed of 4 while in Direct Sunlight or Starlight. Each time you use Cosmic Wrath or Cosmic Charge Free Actions, this effect is extended until the end of your next Turn.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"73d96ee5bb4544f9","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Crusher","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"110","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Crusher","avd12_id":"110_1","custom":false,"description":"Gain +1 Attack and +1 Damage with Crushing Weapons. Gain a Fighting Stance.","selected":true,"data":"AZ7=1:AZB=1","cost":2},"option_2a":{"name":"Reaction : Flank","avd12_id":"110_2a","custom":false,"description":"When an Allied Creature makes a Melee Attack against a target within your Melee Range, you can make an Attack against that same target with a 1d4 Bonus.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Increased Damage","avd12_id":"110_2b","custom":false,"description":"Gain +1 Damage with Crushing Weapons","selected":false,"data":"AZB=1","cost":2},"option_3":{"name":"Novice Crusher","avd12_id":"110_3","custom":false,"description":"Gain +1 Attack with Crushing Weapons and Learn a Fighting Stance from the Stance Table","selected":false,"data":"H=Z:AZ7=1","cost":2},"option_4a":{"name":"Action : Double Tap","avd12_id":"110_4a","custom":false,"description":"Roll 2 Attack Dice and use the higher result. If one is a True Hit, add an additional 1d8 Damage to the Attack. If both are True Hits, add 3d8.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Reaction : Batter Aside","avd12_id":"110_4b","custom":false,"description":"When a Creature makes a Melee Attack against you, make an Attack against them as a Reaction. If your Attack would hit, instead of dealing Damage, the Attack roll that triggered this Reaction takes a 1d4 penalty and cannot be used again until the start of your next turn.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Journeyman Crusher","avd12_id":"110_5","custom":false,"description":"Gain +1 Attack with Crushing Weapons and gain access to the Attack of Opportunity Reaction","selected":false,"data":"AZ7=1:AZU=0","cost":2},"option_6a":{"name":"Reaction : Kneecap","avd12_id":"110_6a","custom":false,"description":"When a Creature moves out of your Area of Control willfully, make a Bludgeoning Attack against them. If the Attack hit, it lowers their Movement Speed by a number of Units equal to your Bludgeoning Damage Bonus Modifier, to a minimum of 2, until the start of their next turn.","selected":false,"data":"ZX2","cost":2},"option_6b":{"name":"Free Action : Forceful Blow","avd12_id":"110_6b","custom":false,"description":"When you hit a Target with a Bludgeoning Weapon, deal extra Damage equal to your Strength Modifier.","selected":false,"data":"Y","cost":2},"option_7":{"name":"Expert Crusher","avd12_id":"110_7","custom":false,"description":"Gain Critical Hits and Gain +1 Attack with Crushing Weapons","selected":false,"data":"AZF:AZ7=1","cost":3},"option_8a":{"name":"Action : Bludgeon","avd12_id":"110_8a","custom":false,"description":"Make an Attack with a -1d4 Modifier.  If the Attack hits, the Target suffers a Penalty equal to your 1d4 roll to their Block, Dodge and Resistance until the start of your next turn.","selected":false,"data":"XX3","cost":2},"option_8b":{"name":"Stunning Blow","avd12_id":"110_8b","custom":false,"description":"Large and smaller Creatures that you score a True Hit on with Crushing Weapons give your target the Stunned Condition.","selected":false,"data":"TO","cost":2},"option_9":{"name":"Master Crusher","avd12_id":"110_9","custom":false,"description":"Gain Brutal Critical Hits with Crushing Weapons and Gain +1 Attack with Crushing Weapons","selected":false,"data":"AZK:AZ1=1:AZ3=1","cost":4},"option_10a":{"name":"Improvised Weapons","avd12_id":"110_10a","custom":false,"description":"Any Object over 5 Mass or any Creature Grappled by you that is 2 Sizes Smaller or more, becomes a Crushing Weapon. A Creature held in this way takes Damage equal to your Crushing Damage Bonus Modifier when used to make an Attack.","selected":false,"data":"TO","cost":3},"option_10b":{"name":"Action : Power Crush","avd12_id":"110_10b","custom":false,"description":"Make a Shove Attack against a Large or Smaller Creature. If Successful, you push the Creature Back 2 Units and Leap towards them and make a Weapon Attack with a +3 Attack Bonus.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Grandmaster Crusher","avd12_id":"110_11","custom":false,"description":"Your Damage Die for Crushing Weapons are upgraded (1-Handed Light: 2d6, 1-Handed Heavy: 2d8, 2-Handed Light: 3d6, 2-Handed Heavy: 3d8)","selected":false,"data":"AZX","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"79d7637fbb5a4ed9","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Dark Cultist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"227","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Dark Dabblings","avd12_id":"227_1","custom":false,"description":"Learn 2 Beginner and 2 Novice Spells from the Witchcraft or Necromancy Schools of Magic","selected":true,"data":"","cost":2},"option_2a":{"name":"Twisted Sorcery","avd12_id":"227_2a","custom":false,"description":"Gain +1 Arcanum and +1 Arcane, Divine and Dark Mitigation","selected":false,"data":"AS7=1:ADC=1:AD8=1:AD7=1","cost":2},"option_2b":{"name":"Empowered Conduit","avd12_id":"227_2b","custom":false,"description":"Your Conduit gains +4 Power and +4 Power Regeneration","selected":false,"data":"FP=4:FR=4","cost":2},"option_3":{"name":"Tainted Magic","avd12_id":"227_3","custom":false,"description":"Gain +1 Spell Attack and +1 Spell Damage but lose -1 Resilience","selected":false,"data":"AZ2=1:AZ4=1:AS6=-1","cost":2},"option_4a":{"name":"Free Action : Dark Gift","avd12_id":"227_4a","custom":false,"description":"After rolling a Spell Attack from Channeling a Necromancy or Witchraft Spell, Reroll the Attack. If the result is the same or worse, take Psychic Damage equal to twice your level.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Action : Dark Prayer","avd12_id":"227_4b","custom":false,"description":"You utter a Dark Prayer and roll a 1d4. You gain a Bonus to Resistance, Spell Attack and Attack until the start of your next turn equal to the result of the d4.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Dark Research","avd12_id":"227_5","custom":false,"description":"You can research and scribe Beginner and Novice spells from the Witchcraft and Necromancy schools of magic. At level 7, this extends to Journeyman spells and Expert spells at level 10. Additionally, gain +1 Scribing.","selected":false,"data":"TC:AC3=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"278df20eca794f3f","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Demolitionist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"271","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Improved Firebomb Potions","avd12_id":"271_1","custom":false,"description":"Firebomb Potions you craft gain an additional die of Damage and deal an additional 1d8 Damage to Structures and Constructs.","selected":true,"data":"TC","cost":2},"option_2a":{"name":"Experimental Potions","avd12_id":"271_2a","custom":false,"description":"Gain +1 Engineering and +1 Alchemy","selected":false,"data":"AC7=1:AC5=1","cost":2},"option_2b":{"name":"Volatile Explosives","avd12_id":"271_2b","custom":false,"description":"Increase the Radius of the Firebomb Potions and Explosive Ammunition you Craft by 1 Unit","selected":false,"data":"TC","cost":2},"option_3":{"name":"Double Improved Firebombs","avd12_id":"271_3","custom":false,"description":"Add your Alchemy Bonus Modifier to the Damage your Firebomb Potions do at the time of Crafting.","selected":false,"data":"TC","cost":2},"option_4a":{"name":"Action : Timed Fuse","avd12_id":"271_4a","custom":false,"description":"When you use a Potion, you can set a fuse, delaying the activation to the end of your Turn, 1 minute or 1 Hour.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Precise Throw","avd12_id":"271_4b","custom":false,"description":"You throw a Firebomb Potion. Any Creature that avoids the Attack takes Splash Damage.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Controlled Chemistry","avd12_id":"271_5","custom":false,"description":"Gain +5 Fire Mitigation. Additionally, you always succeed on Checks against your Firebomb Potions.","selected":false,"data":"AD6=1:TD","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"309536e4d6f8401e","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Devout","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"256","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Devout","avd12_id":"256_1","custom":false,"description":"You dedicate your channeling to a diety or entity that empowers your magic. You can only Cast Spells from the Abjuration and Divine Schools of Magic, however your Damage Bonus Modifiers are doubled on those Spells.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Crusader","avd12_id":"256_2a","custom":false,"description":"Gain +1 Damage with Slashing and Crushing Weapons","selected":false,"data":"AZA=1:AZB=1","cost":2},"option_2b":{"name":"Radiant Shield","avd12_id":"256_2b","custom":false,"description":"Gain +1 Resistance and +2 Dark Mitigation","selected":false,"data":"AD1=1:AD7=1","cost":2},"option_3":{"name":"Dedication of Faith","avd12_id":"256_3","custom":false,"description":"Your Melee Weapons deal 1d4 Divine Damage which increases to 1d8 at level 7 and 2d8 at level 11. Roll an additional Dice against Undead and Dark Creatures.","selected":false,"data":"TO","cost":2},"option_4a":{"name":"Reaction : Healing Words","avd12_id":"256_4a","custom":false,"description":"You Channel a Touch Healing Spell that requires 1 Action to Heal a Creature within 6 Units if they are able to hear you.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Turn the Unfaithful","avd12_id":"256_4b","custom":false,"description":"When you deal Divine Damage to a Dark or Undead Creature, you force them to make a Resilience Check against half the total Damage taken after Mitigations, or they become Afraid of you.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Improved Healing and Shielding","avd12_id":"256_5","custom":false,"description":"Your Healing and Shielding Spells are improved by 1 Dice.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"266b3af47f60497a","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Divine Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"101","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Priest","avd12_id":"101_1","custom":false,"description":"You can research Beginner Level Divine Spells and gain +1 Power.","selected":true,"data":"S41=4:FP=1","cost":2},"option_2a":{"name":"Natural Healer","avd12_id":"101_2a","custom":false,"description":"Gain +1 Medicine and +3 Health","selected":false,"data":"AS8=1:AH=3","cost":2},"option_2b":{"name":"Potent Spells","avd12_id":"101_2b","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_3":{"name":"Action : Bless","avd12_id":"101_3","custom":false,"description":"You touch a Weapon, causing it to glow with radiant energy. The next time this weapon hits a creature, the primary damage is converted to Divine damage. If you elect to Focus on this Action, you can recharge the weapon with a Reaction.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Improved Focus","avd12_id":"101_4a","custom":false,"description":"Gain +1 Concentration and +2 Psychic Mitigation","selected":false,"data":"AS5=1:AD9=2","cost":2},"option_4b":{"name":"Cleanse the Darkness","avd12_id":"101_4b","custom":false,"description":"Gain +4 Dark Mitigation","selected":false,"data":"AD7=4","cost":2},"option_5":{"name":"Novice Priest","avd12_id":"101_5","custom":false,"description":"You can research Novice Level Divine Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S42=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Action [Daily] : Lay Hands","avd12_id":"101_6a","custom":false,"description":"You touch a target, restoring them to half of their Maximum Health.","selected":false,"data":"XD1","cost":2},"option_6b":{"name":"Reaction [Daily] : Faith in Allies","avd12_id":"101_6b","custom":false,"description":"If you are at 0 Health, you can use your Reaction, regardless of limitations, to immediately grant up to 3 Allies within 10 Units a Heroic Action.","selected":false,"data":"ZD1","cost":2},"option_7":{"name":"Journeyman Priest","avd12_id":"101_7","custom":false,"description":"You can research Journeyman Level Divine Spells, gain +5 Power and +2 Divine Mitigation","selected":false,"data":"S43=3:AD8=2:FP=5","cost":3},"option_8a":{"name":"Mass Bless","avd12_id":"101_8a","custom":false,"description":"Your Bless Action can be used on Weapons within 10 Units and affects 3 Weapons instead of 1.","selected":false,"data":"TG","cost":2},"option_8b":{"name":"Blessed Mind","avd12_id":"101_8b","custom":false,"description":"Gain +1 Resistance","selected":false,"data":"AD1=1","cost":2},"option_9":{"name":"Expert Priest","avd12_id":"101_9","custom":false,"description":"You can research Expert Level Divine Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S44=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Action : Celestial Wings","avd12_id":"101_10a","custom":false,"description":"You sprout Celestial Wings, granting you a Fly Speed of 6 for the next Hour. While you fly in this way, you must spend at least 1 Move Action per Round or you will begin falling.","selected":false,"data":"XX3","cost":3},"option_10b":{"name":"Divine Wrath","avd12_id":"101_10b","custom":false,"description":"Your Divine Spells become Brutal Criticals on a True Hit against Dark and Undead Creatures.","selected":false,"data":"TO","cost":3},"option_11":{"name":"Master Priest","avd12_id":"101_11","custom":false,"description":"You can research Master Level Divine Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Divine Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"23a17825831b44cd","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Dragon Slayer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"228","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Bane of Dragons","avd12_id":"228_1","custom":false,"description":"Gain +1 Cold Mitigation, +1 Fire Mitigation and +1 Resilience","selected":true,"data":"AS6=1:AD5=1:AD6=1","cost":2},"option_2a":{"name":"Toughened","avd12_id":"228_2a","custom":false,"description":"Gain +1 Physical Mitigation","selected":false,"data":"AD5=4:AD4=1","cost":2},"option_2b":{"name":"Piercer","avd12_id":"228_2b","custom":false,"description":"Gain +1 Attack with Piercing Weapons","selected":false,"data":"AZ8=1","cost":2},"option_3":{"name":"Slayer","avd12_id":"228_3","custom":false,"description":"Gain +1 Damage to Melee Attacks and +1 Lightning Mitigation","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1:ADB=1","cost":2},"option_4a":{"name":"Giant Slayer","avd12_id":"228_4a","custom":false,"description":"You gain a +2 Bonus to Block and Dodge Checks against Huge or larger Creatures","selected":false,"data":"TD","cost":3},"option_4b":{"name":"Reaction : Immobile","avd12_id":"228_4b","custom":false,"description":"In response to being Shoved or Displaced, you catch yourself by jamming a Piercing Weapon into the ground, a Mounted Creature or other surface, preventing any Movement. This Reaction can also be used while Falling if there is a parallel wall or terrain within your Melee Reach.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Free Action : Spear Plunge","avd12_id":"228_5","custom":false,"description":"Directly after using the Jump Action, you crash into the ground making an Attack with a 2 Handed Piercing Weapon against all Creatures within your Melee Range. The Damage for this Attack is equal to 1d4 for each Unit of your Jump. If this Attack is against a Creature that is 2 Sizes larger than you, you automatically Mount it if it takes Damage after Mitgations.","selected":false,"data":"Y","cost":2}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"46189a149d614890","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Dragonkind","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"1","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Volatile Diet","avd12_id":"1_1","custom":false,"description":"You have survived on a diet most would consider exotic. You gain +1 Resilience and cannot become Poisoned or Diseased from consuming a substance.","selected":true,"data":"ALJ:TA","cost":2},"option_2a":{"name":"The Bonds of Truth","avd12_id":"1_2a","custom":false,"description":"The Dragonkind are known for honorbound honesty and can easily pick out a lie. Gain +2 Insight, but telling a lie or breaking a promise causes you to take 1d12 Psychic Damage.","selected":false,"data":"ASD=2:TG","cost":2},"option_2b":{"name":"Considerate Diplomats","avd12_id":"1_2b","custom":false,"description":"The Dragonkind are used to treating with others and learning the tongues of other cultures. Gain +1 Persuasion and Learn a non-Magical Language.","selected":false,"data":"TG:ASC=1","cost":2},"option_3":{"name":"Culture of Magic","avd12_id":"1_3","custom":false,"description":"The Dragonkind study the Arcane at a young age. Gain +1 Spell Damage and +1 Arcanum.","selected":false,"data":"AZ4=1:AS7=1","cost":2},"option_4a":{"name":"Trophy Hunters","avd12_id":"1_4a","custom":false,"description":"The Dragonkind protect their homelands, slaying beasts and taking trophies. You can adorn Armor and Weapons by applying permanent Augments to them after they are Crafted without requiring a Check.","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Draconic Magic","avd12_id":"1_4b","custom":false,"description":"Dragonkind celebrate the magic gifted to them by their ancient ancestors. Learn 3 Beginner and 3 Novice Draconic Spells","selected":false,"data":"","cost":2},"option_5":{"name":"Blessing of the Great Wyrm","avd12_id":"1_5","custom":false,"description":"Those who have spent time with the Dragonkind gain an ancient blessing. Gain +2 Elemental Mitigation and +2 Arcane Mitigation.","selected":false,"data":"ADA=1:ADC=2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8445efae26544e7e","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Druidic Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"102","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Druid","avd12_id":"102_1","custom":false,"description":"You can research Beginner Level Druidic Spells and gain +1 Power.","selected":true,"data":"S21=4:FP=1","cost":2},"option_2a":{"name":"Attuned to Nature","avd12_id":"102_2a","custom":false,"description":"Gain +1 Animals and +1 Wilderness ","selected":false,"data":"ASF=1:ASB=1","cost":2},"option_2b":{"name":"Attuned to Elements","avd12_id":"102_2b","custom":false,"description":"Gain +2 Elemental Mitigation","selected":false,"data":"ADA=2","cost":2},"option_3":{"name":"Reaction : Balanced Elements","avd12_id":"102_3","custom":false,"description":"In response to taking Elemental Damage, reduce the amount you take by [Level]d4","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Potent Spells","avd12_id":"102_4a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_4b":{"name":"Druidcraft","avd12_id":"102_4b","custom":false,"description":"Gain +1 Alchemy and +1 Medicine","selected":false,"data":"AC5=1:AS8=1","cost":2},"option_5":{"name":"Novice Druid","avd12_id":"102_5","custom":false,"description":"You can research Novice Level Druidic Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S22=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Animal Companion","avd12_id":"102_6a","custom":false,"description":"Gain a Druidic Familiar","selected":false,"data":"FD","cost":2},"option_6b":{"name":"Speak with Animals","avd12_id":"102_6b","custom":false,"description":"Gain the Sylvan Language, allowing you to communicate basic ideas to animals.","selected":false,"data":"ALS=0:TG","cost":2},"option_7":{"name":"Journeyman Druid","avd12_id":"102_7","custom":false,"description":"You can research Journeyman Level Druidic Spells, gain +5 Power and +1 Elemental Mitigation","selected":false,"data":"S23=3:ADA=1:FP=5","cost":3},"option_8a":{"name":"Free Action : Beast Conduit","avd12_id":"102_8a","custom":false,"description":"The next Spell you Channel this turn can use a non-hostile Beast within 10 Units as the point of origin.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Natural Armor","avd12_id":"102_8b","custom":false,"description":"While you are wearing Light or no Armor, you gain +2 Physical Mitigation and +1 Block","selected":false,"data":"W1D3=1:W1D4=2:W0D3=1:W0D4=2","cost":2},"option_9":{"name":"Expert Druid","avd12_id":"102_9","custom":false,"description":"You can research Expert Level Druidic Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S24=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Spirit of Nature","avd12_id":"102_10a","custom":false,"description":"Gain +1 Movement Speed, +1 Search and +1 Initiative","selected":false,"data":"AV=1:ASG=1:ASH=1","cost":3},"option_10b":{"name":"Innate Regeneration","avd12_id":"102_10b","custom":false,"description":"When you complete a Full Rest, you regenerate all your Health, remove any conditions that are affecting you and regenerate any missing limbs. Any Creature who completes a Full Rest inside your Grove benefits from this as well.","selected":false,"data":"TG","cost":3},"option_11":{"name":"Master Druid","avd12_id":"102_11","custom":false,"description":"You can research Master Level Druidic Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Druidic Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a760eb5b36974ed1","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Dual Wielder","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"264","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Dualwielder","avd12_id":"264_1","custom":false,"description":"Gain the Dual Wielding Stance which allows you to Equip a Light 1-Handed Melee Weapon weapon in your Offhand. Once per turn, you can make an Attack with your Offhand that does not consume an Action and does not apply your Damage Bonus Modifier.","selected":true,"data":"TC:H=20","cost":2},"option_2a":{"name":"Action : Disengaging Strike","avd12_id":"264_2a","custom":false,"description":"You make an Attack with only your Offhand, using your Primary Weapon to fend off Attacks, granting you a +2 Dodge and Block until the end of your turn and allowing you to Immedietly move 3 Units.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Action : Synchronized Strike","avd12_id":"264_2b","custom":false,"description":"Make an Attack with your Primary Hand. If the Attack hits, your next Offhand Attack until the end of your current turn has a +2 Attack Modifier and ignores Physical Mitigation.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Ambidextrous","avd12_id":"264_3","custom":false,"description":"You add your Weapon Damage Bonus Modifier to your Offhand Attacks.","selected":false,"data":"","cost":2},"option_4a":{"name":"Reaction : Cross Block","avd12_id":"264_4a","custom":false,"description":"In response to being the Target of a Melee Attack, roll two Block Checks and take the higher of the two values. If the Attack is Botched, the Creature becomes Stunned.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Reaction : Dual Attack of Opportuntity","avd12_id":"264_4b","custom":false,"description":"When a Creature leaves Area of Control, you can make an Attack of Opportunity with both your main and offhand Weapon.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Skilled Defense","avd12_id":"264_5","custom":false,"description":"Gain +1 Block, Dodge and Resist","selected":false,"data":"AD1=1:AD2=1:AD3=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"beb1d6d1f1cb4707","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Duelist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"202","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Duelist Stance","avd12_id":"202_1","custom":false,"description":"Gain the Dueling Fighting Stance","selected":true,"data":"H=8","cost":2},"option_2a":{"name":"Flourish","avd12_id":"202_2a","custom":false,"description":"Gain +1 Performance and +1 Damage to Weapon Attacks","selected":false,"data":"ASE=1:AZ3=1","cost":2},"option_2b":{"name":"Lean Fighter","avd12_id":"202_2b","custom":false,"description":"Gain +1 Athletics and +3 Health","selected":false,"data":"AS1=1:AH=3","cost":2},"option_3":{"name":"Reaction : Parry","avd12_id":"202_3","custom":false,"description":"After a Creature makes a Melee Attack roll on you or against a Creature that is Adjacent to you, roll a 1d4 subtract that amount from the Attack Check.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Action : Make Space","avd12_id":"202_4a","custom":false,"description":"If there are two or more enemies adjacent to you, make a sweeping Attack, making a single roll against all adjacent targets. You can immediately move 2 units without provoking Reactions.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Challenge","avd12_id":"202_4b","custom":false,"description":"You use your Focus issue a challenge to to a Creature, causing your Attacks to deal an extra 1d8 Damage.  This effect persists until someone other than you does Damage to this Creature. This Focus cannot be broken by taking damage.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Master Duelist","avd12_id":"202_5","custom":false,"description":"Gain +1 to Melee Attacks and +1 Block.","selected":false,"data":"AZ6=1:AZ7=1:AZ8=1:AZM=1:AD3=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"cd8ebddadca14c66","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Elemental Ammocraft","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"214","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Elemental Ammocrafter","avd12_id":"214_1","custom":false,"description":"Gain Access to Elemental Ammocrafting. You can use Beginner and Novice Level Catalysts in your Elemental Ammocrafter Recipes.","selected":true,"data":"TC","cost":2},"option_2a":{"name":"Double Infused Ammunition","avd12_id":"214_2a","custom":false,"description":"When you Infuse Ammunition with both an Elemental Infusion and the cooresponding Area Infusion (Shocking,Shockwave,Burning,Frosted) of the same Subschool, the Primary Damage is negated, but everyone within the Area takes the Elemental Damage as Splash Damage.","selected":false,"data":"TC","cost":2},"option_2b":{"name":"Action : Purify Elements","avd12_id":"214_2b","custom":false,"description":"You fire a piece of Ammunition with the Elemental Infusion on it, converting all of the Primary Damage to the Damage Type of your Infusion.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Improved Elemental Ammocrafting","avd12_id":"214_3","custom":false,"description":"Gain +1 Elemental Mitigation and +1 Ammocraft","selected":false,"data":"ADA=1:AC6=1","cost":2},"option_4a":{"name":"Action : Lineshot","avd12_id":"214_4a","custom":false,"description":"You fire a piece of Ammunition Infused with one of the Area Infusions (Shocking,Shockwave,Burning,Frosted), converting them into a Line with a Radius of 1 Unit and Length equal to your Ammocraft Modifier at the time of Crafting. Additionally, the Area persists until the end of your next turn, causing any Creature who moves through the affected Area to have to make the Check against the effects again.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Critical Elemental Infusion","avd12_id":"214_4b","custom":false,"description":"On True Hits, the Dice for the Secondary Damage on your Elemental Infusions are doubled, including usages of Double Infused Ammuntion.","selected":false,"data":"TC","cost":2},"option_5":{"name":"Improved Elemental Ammocraft","avd12_id":"214_5","custom":false,"description":"Gain +1 Ammocraft. Additionally, you can use Journeyman Catalysts in your Elemental Ammocraft Recipes at Level 7 and Expert at Level 9.","selected":false,"data":"TG:AC6=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"93973b156921484a","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Elf","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"10","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Elven Striders","avd12_id":"10_1","custom":false,"description":"Elven culture requires quick feet and decision making to survive their harsh homeland. Gain +1 Movement Speed and +1 Initiative.","selected":true,"data":"AV=1:ASH=1:AL2","cost":2},"option_2a":{"name":"Action : Bladedancing","avd12_id":"10_2a","custom":false,"description":"As part of the Elven culture, you have perfected the Bladedancer form. Make an Attack with a Slashing Weapon and gain a 1d4 Bonus to Dodge Checks until the start of your next turn.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Naturopathy","avd12_id":"10_2b","custom":false,"description":"Living in the wilderness has caused a more homegrown focus on healing. Gain +1 Alchemy and +1 Medicine.","selected":false,"data":"AS8=1:AC5=1","cost":2},"option_3":{"name":"Astral Navigators","avd12_id":"10_3","custom":false,"description":"The Elven culture are trained to move with the guidance of celestial bodies and cannot get lost while under the stars. Gain +1 Search and +1 Wilderness.","selected":false,"data":"ASG=1:ASB=1","cost":2},"option_4a":{"name":"Gift from the Stars","avd12_id":"10_4a","custom":false,"description":"Those who grow up within the Elven culture are exposed to the magic of the stars. You Learn 3 Beginner and 3 Novice Level Cosmic Spells and gain +2 Arcane Mitigation.","selected":false,"data":"ADC=2","cost":2},"option_4b":{"name":"Efficient Archery","avd12_id":"10_4b","custom":false,"description":"The Elven culture teaches bowmanship at a young age. Gain +1 Attack and +1 Damage with Ranged Weapons. Additionally, Basic Ammunition you make gains 1 Infusion Slot.","selected":false,"data":"AZ5=1:AZ9=1:TC","cost":2},"option_5":{"name":"Elven Woads","avd12_id":"10_5","custom":false,"description":"Cumbersome armor is rare within Elven Society and most fight with little in the way of protection, often opting to show painted skin. Gain +2 Dodge while not wearing armor.","selected":false,"data":"W0D2=2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f9d8240493e94dae","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Empath","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"225","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action : Telepathy","avd12_id":"225_1","custom":false,"description":"You can speak into another Creatures mind that is within 10 units of you using your choice of Language. Magical Languages extend this Distance to 20 Units.","selected":true,"data":"XX3","cost":2},"option_2a":{"name":"People Pleaser","avd12_id":"225_2a","custom":false,"description":"Gain +1 Persuasion and +1 Insight","selected":false,"data":"ASC=1:ASD=1","cost":2},"option_2b":{"name":"Helpful","avd12_id":"225_2b","custom":false,"description":"Gain +1 Academics and +1 Medicine","selected":false,"data":"AS9=1:AS8=1","cost":2},"option_3":{"name":"Interference","avd12_id":"225_3","custom":false,"description":"Gain +1 Resistance and +2 Psychic Mitigation","selected":false,"data":"AD1=1:AD9=2","cost":2},"option_4a":{"name":"Action : Mind Aura","avd12_id":"225_4a","custom":false,"description":"You reach out in an area with a radius equal to your level. You can sense the minds of any Humanoid or Beast and have a vague idea of their intent such as if they are hostile, scared or friendly.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Reaction : Empathy","avd12_id":"225_4b","custom":false,"description":"When an Ally within 10 Units of you that you have Line of Sight on takes Physical or Psychic Damage, you can shield their mind with yours and split the Damage in half before applying Mitigation, with you taking one half, and your ally the other.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Action : Mindreader","avd12_id":"225_5","custom":false,"description":"You attempt to read the mind of a Creature that speaks a Language you understand by making a Contested Insight Check against their Resistance. On a success, you can read the most immediate thoughts of the Creature. Additionally, you can elect to deal psychic damage to them equal to twice your Level. On a failure, the Creature is aware that you are attempting to read their mind and you take Psychic Damage equal to the value of their Resistance Check and you cannot use this ability again until you take a Breather.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"fa39b7ba9b8542bc","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Engineer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"128","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Engineering","avd12_id":"128_1","custom":false,"description":"Gain +2 Engineering","selected":true,"data":"AC7=2","cost":2},"option_2a":{"name":"Tinkerer","avd12_id":"128_2a","custom":false,"description":"Gain +1 Smithing and +1 Ammocraft ","selected":false,"data":"AC1=1:AC6=1","cost":2},"option_2b":{"name":"Superior Tools","avd12_id":"128_2b","custom":false,"description":"Lock Picks, Compasses, Crowbars and Climbing Kits you craft add a 1d4 Bonus instead of +1","selected":false,"data":"TC","cost":2},"option_3":{"name":"Craft : Strong Start","avd12_id":"128_3","custom":false,"description":"You can reroll your first Crafting Skill Check when attempting to create an Object that has a Cumulative Check.","selected":false,"data":"O","cost":2},"option_4a":{"name":"Action : Undermine","avd12_id":"128_4a","custom":false,"description":"You interact with an Object or Structure, examining it for weaknesses by making an Engineering Check. On an 11 or higher, you lower the Durability Tier by 1 for a minute. You can only attempt to Undermine a unique Object or Structure once per Day.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Disarming","avd12_id":"128_4b","custom":false,"description":"You gain a 1d4 Bonus to disarming and defending against Traps","selected":false,"data":"TG","cost":2},"option_5":{"name":"Novice Engineering","avd12_id":"128_5","custom":false,"description":"Gain +1 Engineering and +1 Academics","selected":false,"data":"AC7=1:AS9=1","cost":2},"option_6a":{"name":"Locksmith","avd12_id":"128_6a","custom":false,"description":"You are a master Locksmith, gaining a +2 Bonus when using Lockpicks and increasing the Required Check to open any Locks you Craft by an amount equal to your Engineering Bonus Modifier.","selected":false,"data":"TC","cost":2},"option_6b":{"name":"Trapmaster","avd12_id":"128_6b","custom":false,"description":"Traps you make have the Required Checks for spotting and avoiding them increased by 2 at the time you craft them. Additionally, add an extra Dice to the Damage of your Traps.","selected":false,"data":"TC","cost":2},"option_7":{"name":"Upgrades","avd12_id":"128_7","custom":false,"description":"You are able to add one unique Infusion onto Weapons, Armor, Gloves or Boots after they have been Crafted, requiring an Engineering Check of 12 or higher or the materials are lost.","selected":false,"data":"TC","cost":2},"option_8a":{"name":"Inventor","avd12_id":"128_8a","custom":false,"description":"You can install Grapple, Net and Bola Launcher Infusions on hand armor. Additionally, each infusion has its Range increased by 2 Units.","selected":false,"data":"TC","cost":2},"option_8b":{"name":"Craft : Reverse Engineer","avd12_id":"128_8b","custom":false,"description":"You choose an Object that has a Crafting Recipe and attempt to deconstruct it. Roll an Engineering Check. If the Check is above a 14, you recover all the ingredients. On a success, if you recreate this Object on the same day, you gain a +3 Bonus on your first Craft Check.","selected":false,"data":"O","cost":2},"option_9":{"name":"Free Action : Use","avd12_id":"128_9","custom":false,"description":"You can interact with an object without expending an Action on your turn.","selected":false,"data":"Y","cost":3},"option_10a":{"name":"Precise Fabrication","avd12_id":"128_10a","custom":false,"description":"Ranged Weapons that you Craft gain +1 Attack and +2 Units of Maximum Range.","selected":false,"data":"TC","cost":3},"option_10b":{"name":"Construct Crafting","avd12_id":"128_10b","custom":false,"description":"You can create Constructs of the Mechanical subtype up to a Level less than your Engineering Bonus Modifier. For each Level of the Target Construct, you must spend 1 Day and 100 Gold for parts and fabrication","selected":false,"data":"TC","cost":3},"option_11":{"name":"Master Engineer","avd12_id":"128_11","custom":false,"description":"You Gain +2 Engineering and Infusions, including those from other Crafting Skills, no longer add to the Cumulative Check of an item.","selected":false,"data":"TC:AC7=2","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d648174677fe4d58","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Evocation Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"103","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Evoker","avd12_id":"103_1","custom":false,"description":"You can research Beginner Level Evocation Spells and gain +1 Power.","selected":true,"data":"S11=4:FP=1","cost":2},"option_2a":{"name":"Potent Spells","avd12_id":"103_2a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"Free Action : Elemental Charge","avd12_id":"103_2b","custom":false,"description":"You charge an Evocation Spell with a Subschool using one Power. Until your next Full Rest, you are not able to Channel Spells from other Evocation Subschools.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Reaction : Absorb Energy","avd12_id":"103_3","custom":false,"description":"In response to taking Elemental Damage, you empower your Conduit. The next Evocation Spell you Channel before the end of your next turn is automatically Charged and takes 2 less Power.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Aptitude","avd12_id":"103_4a","custom":false,"description":"Gain +1 Arcanum and +1 Academics","selected":false,"data":"AS7=1:AS9=1","cost":2},"option_4b":{"name":"Spellwriter","avd12_id":"103_4b","custom":false,"description":"Gain +1 Scribing and +1 Runecarving","selected":false,"data":"AC3=1:AC4=1","cost":2},"option_5":{"name":"Novice Evoker","avd12_id":"103_5","custom":false,"description":"You can research Novice Level Evocation Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S12=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Free Action : Elemental Weapon","avd12_id":"103_6a","custom":false,"description":"When you deal Elemental Damage using an Evocation Spell, you can make an Attack with a Light or Ultra-Light Weapon. If you hit your Target, the Primary Damage on the weapon is converted to the same type of Damage as your Channeled Spell.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Destructive Evocation","avd12_id":"103_6b","custom":false,"description":"Your Evocation Spells Critically Hit when you roll a True Hit","selected":false,"data":"TO","cost":2},"option_7":{"name":"Journeyman Evoker","avd12_id":"103_7","custom":false,"description":"You can research Journeyman Level Evocation Spells, gain +5 Power and +1 Elemental Mitigation","selected":false,"data":"S13=3:ADA=1:FP=5","cost":3},"option_8a":{"name":"Gathering Power","avd12_id":"103_8a","custom":false,"description":"Gain +1 Spell Damage and +4 Power","selected":false,"data":"AZ4=1:FP=4","cost":2},"option_8b":{"name":"Free Action : Expanded Spell","avd12_id":"103_8b","custom":false,"description":"When you Channel an Evocation Spell, increase the Radius of an Area Spell or the Width of a Line Spell by 1 Unit.","selected":false,"data":"Y","cost":2},"option_9":{"name":"Expert Evoker","avd12_id":"103_9","custom":false,"description":"You can research Expert Level Evocation Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S14=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Reaction : Seeker","avd12_id":"103_10a","custom":false,"description":"As a Reaction, you can mark a Target. Until the end of your next turn, that Target does not benefit from Partial or Full Cover against your Projectile Spells and your Projectile Spells against that target have +10 Units of Extra Range. Any requirements for needing to see your Target are removed.","selected":false,"data":"ZX2","cost":3},"option_10b":{"name":"Action [Daily] : Arcane Cataclysm","avd12_id":"103_10b","custom":false,"description":"You make an Area Spell Attack with your Focus that is centered on your location with a Radius of 3 Units. Spend up to your Level in Focus Points, dealing 1d6 Arcane Damage for each point spent.","selected":false,"data":"XD1","cost":3},"option_11":{"name":"Master Evoker","avd12_id":"103_11","custom":false,"description":"You can research Master Level Evocation Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Evocation Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f86439c062c2456a","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Gloxy","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"19","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Trained Assistants","avd12_id":"19_1","custom":false,"description":"The origin of the Gloxy involves being assistants, and that has carried into their culture. Gain +1 Scribing and +1 Arcanum","selected":true,"data":"AS7=1:AC3=1:ALZ","cost":2},"option_2a":{"name":"Protection Magic","avd12_id":"19_2a","custom":false,"description":"The Gloxy culture heavily favors Abjuratation Magic which was used to protect their former Vethi masters. Learn 2 Beginner and Novice Abjuration Spells and gain +1 Spell Damage.","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"A Desire to Help","avd12_id":"19_2b","custom":false,"description":"The Gloxy culture believes in helping those with less experience. When you make an Assisted Check with a Skill that has a Bonus Modifier equal to or higher than the Bonus Modifier of the Skill you are Assisting, add a 1d4 to their check instead of rolling an Assisted Check.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Always Free","avd12_id":"19_3","custom":false,"description":"The Gloxy cherish freedom and are particularly suspicious when they feel as if their liberty is threatened. Gain +1 Insight and +1 Resistance.","selected":false,"data":"AD1=1:ASD=1","cost":2},"option_4a":{"name":"Holistic Medicine","avd12_id":"19_4a","custom":false,"description":"The Gloxy culture values an all-around approach to healing, requiring good food, medicine and alchemical concoctions. Gain +1 Alchemy, +1 Medicine and +1 Cooking.","selected":false,"data":"AD8=1:AC2=1:AC5=1","cost":2},"option_4b":{"name":"Skilled Linguists","avd12_id":"19_4b","custom":false,"description":"The Gloxy culture prides itself on learning new Languages and accurately reproducing the dialects. Gain +1 Performance and learn 2 non-Magical Languages.","selected":false,"data":"ASE=1","cost":2},"option_5":{"name":"Manipulators of Magic","avd12_id":"19_5","custom":false,"description":"You cannot fail an Essence Burn and can additionally perform an Essence Burn on a Conduit that is not bound to you. Additionally, when you Bond with a Conduit, you get credit for a Bond that is one tier higher.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"4e1a9da99af3419e","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Gnoll","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"14","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"The Eternal Hunt","avd12_id":"14_1","custom":false,"description":"The Gnollish culture is built upon the concept of the great, unending hunt. Gain +1 Wilderness and +1 Resilience ","selected":true,"data":"ASB=1:AS6=1:ALP","cost":2},"option_2a":{"name":"Never Complacent","avd12_id":"14_2a","custom":false,"description":"Gnolls are trained to keep tabs on their surroundings, as well as sleep lightly. You always have the Alerted Condition without requiring your Focus, even when Unconscious or Sleeping.","selected":false,"data":"TG","cost":2},"option_2b":{"name":"Oracle Guidance","avd12_id":"14_2b","custom":false,"description":"The Gnollish culture is guided by mysterious oracles, and interpreting signs is an important facet of life. Gain +1 Insight and 1 Luck Dice.","selected":false,"data":"L1:ASD=1","cost":2},"option_3":{"name":"Trained Hunters","avd12_id":"14_3","custom":false,"description":"Becoming a hunter is something nearly all are expected do within Gnollish society as a right of passage. Gain +1 Stealth, +1 Initiative and +1 Insight.","selected":false,"data":"AS4=1:ASH=1:ASD=1","cost":2},"option_4a":{"name":"Path of the Shaman","avd12_id":"14_4a","custom":false,"description":"Many within the Gnollish culture rely on shamanism for healing. Gain +1 Alchemy, +1 Medicine, and Learn 2 Beginner and 2 Novice Druidic Spells.","selected":false,"data":"AS8=1:AC5=1","cost":2},"option_4b":{"name":"Pack Fighter","avd12_id":"14_4b","custom":false,"description":"The Gnollish culture is based on moving in large packs and hunting together. Once per turn, you can add a 1d4 Bonus to an Attack Roll when at least 2 Allies are within 4 Units of you.","selected":false,"data":"TO","cost":2},"option_5":{"name":"Action [Daily] : Mark of the Hunt","avd12_id":"14_5","custom":false,"description":"You Mark a target you can see within 30 Units lasting until the end of a Full Rest. You gain +2 Movement Speed towards your target and deal an extra 1d10 Damage whenever you deal Physical Damage to them.","selected":false,"data":"XD1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3e2ae767e97d484e","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Gnome","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"6","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Whimsical Engineering","avd12_id":"6_1","custom":false,"description":"Gnomish cultures take great pride in their tinkering with both magic and machines. Gain +1 Arcanum and +1 Engineering","selected":true,"data":"AS7=1:AC7=1:ALH","cost":2},"option_2a":{"name":"Merchants","avd12_id":"6_2a","custom":false,"description":"Gnomish cultures are famous for their merchants and making trades. Gain +1 Persuasion and +1 Insight. Gain an Additional 1d4 Persuasion when making a deal that involves trade or procuring services for money.","selected":false,"data":"ASC=1:ASD=1:TG","cost":2},"option_2b":{"name":"Polite","avd12_id":"6_2b","custom":false,"description":"Gnomish cultures preach both patience and speaking quietly, always staying focused and never disturbing their elders. Gain +1 Stealth and +1 Concentration.","selected":false,"data":"AS4=1:AS5=1","cost":2},"option_3":{"name":"Evasion Training","avd12_id":"6_3","custom":false,"description":"Gnomish cultures tend to start avoidance training at a young age to resist the many dangers in their homeland. Gain +1 Dodge and +1 Initiative.","selected":false,"data":"AD2=2:ASH=1","cost":2},"option_4a":{"name":"Higher Education","avd12_id":"6_4a","custom":false,"description":"Gnomish culture values expertise in a single subject rather than broad learning. Become Good at one Knowledge Skill and the learn the Arcanascript Language.","selected":false,"data":"ALA","cost":2},"option_4b":{"name":"Gnomish Ingenuity","avd12_id":"6_4b","custom":false,"description":"Gnomish cultures are capable and clever engineers and take great pride in their creations. Gain +1 Engineering and +1 Ammocraft. Additionally, Ranged Weapons that you produce have a +1 Damage Bonus and +2 Maximum Range.","selected":false,"data":"TC:AC7=1:AC6=1","cost":2},"option_5":{"name":"Conduit Attunement","avd12_id":"6_5","custom":false,"description":"Gnomish cultures value the bonds between a Conduit and its owner and are taught how to precicely attune to them. When you bond with a Conduit, start with a Common Bond and gain +6 Power and +6 Power Regen.","selected":false,"data":"TG:FP=6:FR=6","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d826ec8e4a364c5e","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Goblin","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"9","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Culture of Festivals","avd12_id":"9_1","custom":false,"description":"The Goblin culture is happy to celebrate even minor occassions. Gain +1 Persuasion and Gain +1 Performance","selected":true,"data":"ASE=1:ASC=1:AL4","cost":2},"option_2a":{"name":"Studier of Artifacts","avd12_id":"9_2a","custom":false,"description":"You gain +1 Academics and +1 Runecarving. You gain a 1d4 Bonus to Checks when attempting to deduce the origin of an Object or Structure.","selected":false,"data":"AS9=1:AC4=1:TG","cost":2},"option_2b":{"name":"Magical Builders","avd12_id":"9_2b","custom":false,"description":"The masons and architects in the Goblin culture build and design with magic. Learn 3 Beginner and 3 Novice Transmutation Spells.","selected":false,"data":"","cost":2},"option_3":{"name":"Appreciation for the Arts","avd12_id":"9_3","custom":false,"description":"The Goblin culture is enamored by beauty. You can spend a minute admiring either an artifact, a piece of art or architecture to borrow inspiration. The object in question must be at least 100 years old, valued over 100 gold and something that has not been the target of this ability in the past. If you are successfully inspired, you gain a 1d4 Bonus to Performance Checks for the rest of the day and a 1d4 Bonus to your next Craft Check. If the 1d4 on the Craft Check results in a 4, add 1 Overcraft to the Object.","selected":false,"data":"TC","cost":2},"option_4a":{"name":"Meritocracy","avd12_id":"9_4a","custom":false,"description":"Those who excel in crafting beautiful objects are the ones who advance within the Goblin society. Gain +1 to all Crafting Skills.","selected":false,"data":"ACA=1","cost":2},"option_4b":{"name":"Those Who Covet","avd12_id":"9_4b","custom":false,"description":"With a culture defined by such beautiful and expensive art, there are those who make ends meet by taking. Gain +1 Stealth and +1 Thievery","selected":false,"data":"ASA=1:AS4:1","cost":2},"option_5":{"name":"Trained in Magic","avd12_id":"9_5","custom":false,"description":"The elite of Goblin society are trained in powerful magic. Gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ2=1:AZ4=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"dcb48bfd4f4f4eed","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Guardian","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"216","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Free Action : Shield Bash","avd12_id":"216_1","custom":false,"description":"After making a Successful Melee Attack with a 1 Handed Weapon, you slam the same Target with your Shield, adding 1d6 Damage to your Attack.","selected":true,"data":"Y","cost":2},"option_2a":{"name":"Quick Guard","avd12_id":"216_2a","custom":false,"description":"You can use a Block Check against Ray Attacks instead of your Resistance.","selected":false,"data":"TD","cost":2},"option_2b":{"name":"Savage Shield Bash","avd12_id":"216_2b","custom":false,"description":"Your Shield Bash Damage becomes equal to your Strength Bonus Modifier.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Reaction : Cover","avd12_id":"216_3","custom":false,"description":"In response to an Ally that is Adjacent to you being Targeted by an Attack that is eligible to be Blocked, you make a Block Check for that Ally.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Shield Guardian","avd12_id":"216_4a","custom":false,"description":"Gain +1 Block while wielding a Shield","selected":false,"data":"W5D3=1","cost":2},"option_4b":{"name":"Reaction : Spellshield","avd12_id":"216_4b","custom":false,"description":"In response to being Targeted with a Spell, you gain a 1d4 Bonus to your Block Check. If a Line, Projectile or Cone Spell was successfully blocked, all Creatures within a 4 Unit Cone who are behind you in relation to the Direction of the Spell only take Splash Damage if they fail their Checks.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Dazing Shield","avd12_id":"216_5","custom":false,"description":"When you hit a Creature with the Shield Bash ability, they must make a Concentration against Half the Damage after Mitigation or become Dazed. If the initial Attack that prompted the Shield bash was a True Hit, the Target becomes Stunned instead if they fail.","selected":false,"data":"TO","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"48ad3e5093d2493b","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Half Giant","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"8","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Giant Heritage","avd12_id":"8_1","custom":false,"description":"Living within the Half Giant culture requires toughness as the weak do not survive. Gain +2 Health and +1 Damage on Melee Attacks.","selected":true,"data":"AH=2:ALF:AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_2a":{"name":"Born of Winter","avd12_id":"8_2a","custom":false,"description":"The Half Giant culture thrives in the coldest regions. Gain +4 Cold Mitigation. Additionally, when you Craft any piece of Light Armor, it gains +1 Cold Mitigation.","selected":false,"data":"AD5=4:TC","cost":2},"option_2b":{"name":"Fearless","avd12_id":"8_2b","custom":false,"description":"The Half Giant culture do not accept weakness within their clans. Gain Immunity to the Afraid Condition","selected":false,"data":"I=1","cost":2},"option_3":{"name":"Free Action : Body over Mind","avd12_id":"8_3","custom":false,"description":"Until the end of your next turn, you ignore the effects of the Wounded, Exhausted, Poisoned and Bleeding Conditions.","selected":false,"data":"Y","cost":2},"option_4a":{"name":"Beast Alliances","avd12_id":"8_4a","custom":false,"description":"Half Giant cultures rely on domesticating Beasts to survive in their harsh climates. Gain +1 Animals and you can tame Beasts that are 2 Levels over your Taming Threshold.","selected":false,"data":"TG:ASF=1","cost":2},"option_4b":{"name":"Honor in Grit","avd12_id":"8_4b","custom":false,"description":"The Half Giant cultures value grit above all. Gain +1 Strength and +1 Resilience.","selected":false,"data":"AS2=1:AS6=1","cost":2},"option_5":{"name":"Nomads","avd12_id":"8_5","custom":false,"description":"Individuals within the Half Giant culture spend their lives migrating across vast plains of frost. Gain +1 Wilderness, +1 Movement Speed and +1 Athletics.","selected":false,"data":"ASB=1:AS1=1:AV=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f959d95f9f694835","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Headsman","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"209","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Menacing Presence","avd12_id":"209_1","custom":false,"description":"Gain +1 Persuasion and +1 Strength","selected":true,"data":"ASC=1:AS2=1","cost":2},"option_2a":{"name":"Action : Hamstring","avd12_id":"209_2a","custom":false,"description":"You make an Attack with a Slashing Weapon at a Huge or smaller Creature that has legs in an attempt to Damage them. If the Attack hits, the Creature has a maximum Movement Speed of 2 Units until the end of their next turn.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Reaction : Sharp Parry","avd12_id":"209_2b","custom":false,"description":"In response to being the Target of a Melee Attack, you make an Attack with a Heavy Slashing Weapon instead of a Defense Check. If the result of your Check is higher, you deal Damage to the Target equal to your Bonus Damage Modifier and avoid the Attack.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Executor","avd12_id":"209_3","custom":false,"description":"Gain +1 Attack with Slashing Weapons","selected":false,"data":"AZ6=1","cost":2},"option_4a":{"name":"Sharpened Blade","avd12_id":"209_4a","custom":false,"description":"Gain +1 Slashing Damage","selected":false,"data":"AZA=1","cost":2},"option_4b":{"name":"Sense Weakness","avd12_id":"209_4b","custom":false,"description":"Gain 1d4 Attack to Creatures that have at least 3 Conditions on them. Additionally, if a Creature is Unconscious, the Damage on your Attack is doubled.","selected":false,"data":"TO","cost":2},"option_5":{"name":"Action : Guillotine","avd12_id":"209_5","custom":false,"description":"You make an Attack against a Creature that is Prone, dealing an extra 2d10 Primary Damage on a hit. The Dice become 4d10 if you score a Critical Hit.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"55fd97e7b5f946b1","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Historian","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"247","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Appraiser","avd12_id":"247_1","custom":false,"description":"You can appraise and study Objects by making an Academics Check during a Full Rest. On a 13 or higher, you can reasonably deduce the approximate age of the Object and how much it is worth. If you possess an Object either in your Inventory or Storage that is at least 100 years old, you gain a 1d4 Bonus to any Academics Checks when recalling information about the group that created it, if the creators or original owners are known.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Linguist","avd12_id":"247_2a","custom":false,"description":"Gain +1 Academics and Learn a non-Magical Language","selected":false,"data":"AS9=1","cost":2},"option_2b":{"name":"Archaeologist","avd12_id":"247_2b","custom":false,"description":"Gain +1 Search and +1 Wilderness","selected":false,"data":"ASG=1:ASB=1","cost":2},"option_3":{"name":"Free Action : Exploit Weakness","avd12_id":"247_3","custom":false,"description":"If you deal Damage to a Creature as part of an Action, you can Learn its Mitigation to Damage Type(s) you did. If that Mitigation is less than your Academics Modifier, the next time your Target takes Damage of that Type before the start of your next turn they take an additional 1d8 Damage. If you possess an Object belonging to the Creatures culture, religion or nation that is at least 100 Years old, the Damage becomes 1d8 + your Academics Modifier. ","selected":false,"data":"Y","cost":2},"option_4a":{"name":"Student of War","avd12_id":"247_4a","custom":false,"description":"Gain +1 Damage to Weapon Attacks and +1 Persuasion","selected":false,"data":"AZ3=1:AZ9=2:ASC=1","cost":2},"option_4b":{"name":"Student of Magic","avd12_id":"247_4b","custom":false,"description":"Gain +1 Spell Attack and Learn a Magical Language","selected":false,"data":"AS2=2","cost":2},"option_5":{"name":"Antiquarian","avd12_id":"247_5","custom":false,"description":"Gain +1 Academics. Additionally, your Appraiser Trait grants a 1d4 Bonus to all Knowledge Checks instead of just Academics.","selected":false,"data":"AS9=1:TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d6e0d60e42ee4ff3","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Hordeslayer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"274","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Area of Control","avd12_id":"274_1","custom":false,"description":"Your Area of Control is increased to a 2 unit radius from your center. This causes your attack of opportunities to trigger against any creature that leaves this area.","selected":true,"data":"","cost":2},"option_2a":{"name":"Free Action : Challenge","avd12_id":"274_2a","custom":false,"description":"Until the Start of your next turn, any Creature within your Area of Control that Attacks a Creature other than you, suffers a 1d4 Penalty to the first Melee or Weapon attack they make on their turn.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Action [Daily] : Battleshout","avd12_id":"274_2b","custom":false,"description":"You shout a rallying battle cry and make an Attack with a Melee Weapon. For each hostile creature within your Area of Control, you and all allies within 10 units gain 1d4 Temporary Health that lasts for 1 Minute. If the Melee Attack results in a True Hit, your allies gain 1d6 Temporary Health for each enemy, instead of 1d4.","selected":false,"data":"XD1","cost":2},"option_3":{"name":"Yield to None","avd12_id":"274_3","custom":false,"description":"Gain +1 Block and +1 Dodge","selected":false,"data":"AD3=1:AD2=1","cost":2},"option_4a":{"name":"Chaos of Battle","avd12_id":"274_4a","custom":false,"description":"For each hostile creature within your Area of Control, your True Hit threshold is lowered by 1.","selected":false,"data":"TO","cost":2},"option_4b":{"name":"Battle Scarred","avd12_id":"274_4b","custom":false,"description":"Gain +1 Physical Mitigation and +1 Resilience","selected":false,"data":"AD4=1:AS6=1","cost":2},"option_5":{"name":"Action : Weapon Storm","avd12_id":"274_5","custom":false,"description":"You make a single Melee Attack with a Heavy Weapon against all creatures within your Area of Control. If the Damage from this Attack brings a Creature to 0 Health, your Free Action is refunded.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"bf2da51057ee47cd","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Human","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"7","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Heritage of Will","avd12_id":"7_1","custom":false,"description":"Humans have a willful culture, and become endurant and resistant to magic. Gain +1 Resistance and +1 Resilience ","selected":true,"data":"AS6=1:AD1=1:AL8","cost":2},"option_2a":{"name":"Pride in Diversity","avd12_id":"7_2a","custom":false,"description":"Humans have many sub-cultures and intermingle with other ancestries and culture groups. Gain +1 Persuasion and learn a non-Magical Language.","selected":false,"data":"ASC=1","cost":2},"option_2b":{"name":"Paladin Orders","avd12_id":"7_2b","custom":false,"description":"Human cultures are impacted heavily by faith, often bordering on fanaticism. Learn 2 Beginner and 2 Novice Divine Spells and gain +1 Damage with Slashing Weapons.","selected":false,"data":"AZA=1","cost":2},"option_3":{"name":"Adaptive","avd12_id":"7_3","custom":false,"description":"Human culture demands adaptation to thrive. Gain +1 Elemental Mitigation, +1 Arcane Mitigation and +1 Psychic Mitigation","selected":false,"data":"ADA=1:ADC=1:AD9=1","cost":2},"option_4a":{"name":"Folk Hero","avd12_id":"7_4a","custom":false,"description":"Human cultures place heroes on pedestals so that others seek to replicate their glory. Gain +1 Block to all shields and +1 Physical Mitigation","selected":false,"data":"W5D3=1:AD4=1","cost":2},"option_4b":{"name":"Corrupted by Temptation","avd12_id":"7_4b","custom":false,"description":"Zealotry is always a danger within Human culture, and can lead to dangerous beliefs. Learn 3 Beginner and 3 Novice Fiend Spell and gain +2 Divine Mitigation.","selected":false,"data":"AD8=2","cost":2},"option_5":{"name":"Free Action : Glorykill","avd12_id":"7_5","custom":false,"description":"Whenever you land a killing blow on a Creature your Level or higher, you can grant an allied player a Heroic Action","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"ab935241f54b4455","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Hunter","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"206","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Wildchild","avd12_id":"206_1","custom":false,"description":"Gain +1 Wilderness and +1 Stealth","selected":true,"data":"AS4=1:ASB=1","cost":2},"option_2a":{"name":"Falconry","avd12_id":"206_2a","custom":false,"description":"Gain +1 Animals. If you utilize a Pet with a Flight Speed to make an Assisted Check while Searching, gain a 1d4 Bonus to your Check.","selected":false,"data":"ASF=1:TG","cost":2},"option_2b":{"name":"Fletcher","avd12_id":"206_2b","custom":false,"description":"Gain +1 Ammocraft and +1 Damage to Ranged Weapons","selected":false,"data":"AC6=1:AZ9=1","cost":2},"option_3":{"name":"Of the Land","avd12_id":"206_3","custom":false,"description":"Gain +1 Movement Speed. Your Swim and Climb Speed become equal to your Movement Speed and you take Half Damage from falling.","selected":false,"data":"AV=1:TG","cost":3},"option_4a":{"name":"Action : Hunters Instinct","avd12_id":"206_4a","custom":false,"description":"You make a Ranged Attack against a Creature. If the Attack hits, you make a Contested Initiative Check against the Target. On a success, the Creature takes an extra 1d10 Damage. If the Creature is a Beast, the extra damage becomes 2d12.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Reaction : Quick Shot","avd12_id":"206_4b","custom":false,"description":"In response to a Creature Attacks makes a Melee Attack against you, make an uncoordinated Attack at them with a 1d4 Penalty, lowering their Attack by the same amount.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Ranger of the Wilds","avd12_id":"206_5","custom":false,"description":"Gain +1 Attack with Slashing, Piercing, Crushing and Ranged Weapons and +1 Wilderness","selected":false,"data":"AZ6=1:AZ8=1:AZ7=1:AZ5=1:ASB=1","cost":2}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d7450272c5fa46a3","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Illusion Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"107","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Illusionist","avd12_id":"107_1","custom":false,"description":"You can research Beginner Level Illusion Spells and gain +1 Power.","selected":true,"data":"S61=4:FP=1","cost":2},"option_2a":{"name":"Path of Deception","avd12_id":"107_2a","custom":false,"description":"Gain +1 Thievery and +1 Stealth","selected":false,"data":"ASA=1","cost":2},"option_2b":{"name":"Path of Entertainment","avd12_id":"107_2b","custom":false,"description":"Gain +1 Performance and +1 Persuasion","selected":false,"data":"ASE=1:ASC=1","cost":2},"option_3":{"name":"Reaction : Escape Artist","avd12_id":"107_3","custom":false,"description":"You move up to 2 Units without provoking Reactions. If you are Grappled, you gain a 2d4 Bonus to your Check to attempt to escape it or if you are Prone, you become upright.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Potent Spells","avd12_id":"107_4a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_4b":{"name":"Skeptic","avd12_id":"107_4b","custom":false,"description":"Gain +1 Insight and +2 Psychic Mitigation","selected":false,"data":"ASD=1:AD9=2","cost":2},"option_5":{"name":"Novice Illusionist","avd12_id":"107_5","custom":false,"description":"You can research Novice Level Illusion Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S62=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Mind Palace","avd12_id":"107_6a","custom":false,"description":"You can use illusions to help calm your mind. When rolling on the Confusion Table, the Condition ends on you when you roll a 6 or higher instead of just an 8. Additionally, you gain +2 on Resistance Checks while Charmed. Finally, when you are Maddened and attack an Ally, you do not apply your Damage Bonus Modifier.","selected":false,"data":"TD","cost":2},"option_6b":{"name":"Vivid Imagination","avd12_id":"107_6b","custom":false,"description":"You become Immune to the Afraid Condition and gain +1 Resilience","selected":false,"data":"AS6=1:I=1","cost":2},"option_7":{"name":"Journeyman Illusionist","avd12_id":"107_7","custom":false,"description":"You can research Journeyman Level Illusion Spells, gain +5 Power and +2 Psychic Mitigation","selected":false,"data":"S63=3:AD9=2:FP=5","cost":3},"option_8a":{"name":"Sleight of Hand","avd12_id":"107_8a","custom":false,"description":"You can Channel Illusion Spells that require 1 Action effortlessly by using your hands to gesture instead of requiring speaking.","selected":false,"data":"TG","cost":2},"option_8b":{"name":"Reaction : Bend Light","avd12_id":"107_8b","custom":false,"description":"In response to a Ray Attack striking within 4 Units of you, roll a Spell Attack. If your roll is higher than the initial Attack, you redirect the Ray to a point within 6 Units. Otherwise, reduce the Attack roll of the Ray by 1d4.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Expert Illusionist","avd12_id":"107_9","custom":false,"description":"You can research Expert Level Illusion Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S64=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Free Action : Mind Wrack","avd12_id":"107_10a","custom":false,"description":"When you deal Psychic Damage to a Creature, you can force them to make a Resilience Check against half the Psychic Damage taken after Mitigation or give them your choice of the the Afraid or Stunned Condition.","selected":false,"data":"Y","cost":3},"option_10b":{"name":"Action : Will Breaker","avd12_id":"107_10b","custom":false,"description":"You Target a Creature within 20 Units and erode at their will, lowering any Resistance and Resilience Checks by 1d4 until the end of your next turn.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Master Illusionist","avd12_id":"107_11","custom":false,"description":"You can research Master Level Illusion Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Illusion Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"408930025dd9432e","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Improved Familiar","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"235","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Improved Familiar","avd12_id":"235_1","custom":false,"description":"Your Familiar takes the form of a Level 1 Beast, inheriting its Statblock with a Knowledge and Social skill of -1.","selected":true,"data":"TF","cost":2},"option_2a":{"name":"Shared Magic","avd12_id":"235_2a","custom":false,"description":"Your Familiar can Channel Beginner and Novice Spells that you know which do not require Focus or Components using your Conduit.","selected":false,"data":"TF","cost":2},"option_2b":{"name":"Battle Familiar","avd12_id":"235_2b","custom":false,"description":"Your Familiar gains 5 Health, +2 Attack and +3 Damage.","selected":false,"data":"TF","cost":2},"option_3":{"name":"Action : Familar Bond","avd12_id":"235_3","custom":false,"description":"You fall Unconscious and place your mind within your Familiar. For the next 10 Minutes, you can control the Familiar and use its senses.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Elemental","avd12_id":"235_4a","custom":false,"description":"Your Familiar gains an Elemental Type, causing Physical Damage to be converted to that element and granting them a +5 Mitigation to that Damage Type.","selected":false,"data":"TF","cost":2},"option_4b":{"name":"Shared Connection","avd12_id":"235_4b","custom":false,"description":"You and your Familiar gain Temporary Health equal to your Level at the end of a Full Rest. However, if your Familiar dies, you immediately take True Damage equal to your Level.","selected":false,"data":"TF","cost":2},"option_5":{"name":"Ethereal Movement","avd12_id":"235_5","custom":false,"description":"Your Familiar gains +2 Movement Speed. Additionally, it gains a Fly and Swim Speed of 6 unless it is higher already.","selected":false,"data":"TF","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8c966ab29d9a4c95","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Infiltrator","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"267","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Reliable Disguises","avd12_id":"267_1","custom":false,"description":"You can create 3 Personas the same Size as you that each require a Disguise Kit which does not get consumed upon use. Each Persona can consist of mannerisms and accurate accents that you are able to replicate. While you are disguised with one of the Personas, it is not possible for a Creature to identify your other identities through non-magical means.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Action : Sabotage","avd12_id":"267_2a","custom":false,"description":"You make a Thievery or Engineering Check and touch an Object such as a mechanism, door, lever or other object that can be used, activated or triggered.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Free Action : Stride","avd12_id":"267_2b","custom":false,"description":"You quickly dash up to 4 Units, allowing you to pass through a Creature that is Large or smaller without making a Check or provoking Reactions.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Blend In","avd12_id":"267_3","custom":false,"description":"Gain +1 Performance, +1 Thievery and +1 Stealth","selected":false,"data":"AS4=1:ASE=1:ADA=1","cost":2},"option_4a":{"name":"Action : Quick Change","avd12_id":"267_4a","custom":false,"description":"In repsonse to breaking Line of Sight with a Creature or multiple Creatures, you quickly change Personas. If a Creature gains Line of Sight on your new Persona before the start of your next turn and the circumstances could be considered suspicious, you make a Contested Performance Check against their Insight in an attempt to fool them.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Action : Incapacitate","avd12_id":"267_4b","custom":false,"description":"You attempt to apply a Tranquilizer Serum to a Beast, Humanoid or Monster by making a Contested Initiative Check. If successful, the Required Check on the Tranquilizer Serum is increased by 2. If you are Hidden, gain a 1d4 Bonus to your Initiatve Check and increase the Required Check on the Serum by 4.","selected":false,"data":"XX3","cost":3},"option_5":{"name":"Blown Cover","avd12_id":"267_5","custom":false,"description":"Gain +1 Movement Speed, +1 Acrobatics and +1 Dodge","selected":false,"data":"AD2=1:AS3=1:AV=1","cost":2}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"1c5627fa13194863","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Inquisitor","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"251","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Inquisitive","avd12_id":"251_1","custom":false,"description":"Gain +1 Search and +1 Insight","selected":true,"data":"ASG=1:ASD=1","cost":2},"option_2a":{"name":"Defense Against Darkness","avd12_id":"251_2a","custom":false,"description":"You Learn 2 Beginner and 2 Novice Abjuration Spell","selected":false,"data":"","cost":2},"option_2b":{"name":"Seeker of Zealots","avd12_id":"251_2b","custom":false,"description":"Gain +2 Dark Mitigation and +2 Divine Mitigation","selected":false,"data":"AD7=2:AD8=2","cost":2},"option_3":{"name":"Action : Condemn","avd12_id":"251_3","custom":false,"description":"You declare an Attack against a Creature, and then make that Attack with a +2 Bonus as part of the same Action. If you deal Damage to the Creature, you gain a 1d4 Bonus on your next Attack or Defense Check before the start of your next turn. If you miss, the Creature has a 1d4 Bonus to the next Attack or Defense Check it makes against you.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Insightful","avd12_id":"251_4a","custom":false,"description":"You become Good at Insight","selected":false,"data":"","cost":2},"option_4b":{"name":"Holy Sight","avd12_id":"251_4b","custom":false,"description":"You become Immune to the Blinded Condition and gain +1 Resistance","selected":false,"data":"I=3:AD1=1","cost":2},"option_5":{"name":"Free Action : Trial By Fire","avd12_id":"251_5","custom":false,"description":"If a Creature has dealt Dark Damage, is a Dark Creature or has Channeled a Necromancy, Fiend or Witchcraft Spell within the past minute, you can force a Contested Insight Check against their Persuasion. On a success, the Target takes Fire Damage equal to the total value of your Insight Check. This ability can be used without the prerequisites when you True Hit any Creature with an Action.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e0f711988d4544f3","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Investigator","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"249","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Investigator","avd12_id":"249_1","custom":false,"description":"Gain +1 Search and +1 Insight","selected":true,"data":"ASG=1:ASD=1","cost":2},"option_2a":{"name":"Investigative Research","avd12_id":"249_2a","custom":false,"description":"At the end of a Full Rest, you choose one Knowledge Skill. Until the end of your next Full Rest, you become Good at that Skill.","selected":false,"data":"","cost":2},"option_2b":{"name":"Quick Evaluations","avd12_id":"249_2b","custom":false,"description":"Whenever an Initiative Check or Modifier is used, you can use your Insight Skill instead","selected":false,"data":"TG","cost":2},"option_3":{"name":"Specialist","avd12_id":"249_3","custom":false,"description":"You choose a Creature Type besides a Beast or Construct. When you are on the receiving end of a True Hit from a Creature of this Type, it is downgraded 1 Tier. Additionally you gain a +2 Bonus when making Search and Insight Checks against this Creature Type. You can change this Creature Type when you Level or spend at least 1 Week of down time in a Settlement.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Good Cop","avd12_id":"249_4a","custom":false,"description":"Gain +1 Persuasion and +1 Performance","selected":false,"data":"ASC=1:ACE=1","cost":2},"option_4b":{"name":"Bad Cop","avd12_id":"249_4b","custom":false,"description":"When you have dealt Damage to a Creature within the last minute, you gain a 1d4 Bonus to Insight and Persuasion Checks against them.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Free Action : Deduction","avd12_id":"249_5","custom":false,"description":"You attempt to read a Creatures body language and predict their most likely move by rolling a Contested Insight Check against their Performance. On a success, you gain a 1d4 Bonus to any Defensive Check you make against that Creature until the start of your next turn. This ability does not work on Beasts or Constructs.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"73a27d68e1fa45e7","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Juggernaut","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"244","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Juggernaut Stance","avd12_id":"244_1","custom":false,"description":"Gain the Juggernaut Fighting Stance","selected":true,"data":"H=14","cost":2},"option_2a":{"name":"Walking Fortress","avd12_id":"244_2a","custom":false,"description":"Gain +1 Elemental Mitigation and +3 Health","selected":false,"data":"ADA=1:AH=3","cost":2},"option_2b":{"name":"Power Rush","avd12_id":"244_2b","custom":false,"description":"Gain +1 Initiative and +1 Strength","selected":false,"data":"ASH=1:AS2=1","cost":2},"option_3":{"name":"Power Strikes","avd12_id":"244_3","custom":false,"description":"Gain +1 Damage with Melee Attacks","selected":false,"data":"AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_4a":{"name":"Action : Multislash","avd12_id":"244_4a","custom":false,"description":"On your next Attack action this Turn, you can make 3 Attacks with a Heavy 2-Handed Weapon.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Leaping Slash","avd12_id":"244_4b","custom":false,"description":"You leap 3 Units and make an Attack against the closest enemy without provoking Reactions.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Free Action : Brutal Strike","avd12_id":"244_5","custom":false,"description":"While in the Juggernaut Fighting Stance, make a Shove Attack that can only be used to Displace. If the Shove Attack is successful, deal Physical Damage equal your Strength Modifier.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"dce5bfb84c2942cc","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Kinetic Mage","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"261","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action : Kinetic Shot","avd12_id":"261_1","custom":false,"description":"You fire energy from your Conduit by making a Projectile Spell Attack at a Target within 6 Units, dealing 1d8 Physical Damage plus your Spell Damage Bonus Modifier. This Action does not have usage limits.","selected":true,"data":"XX3","cost":2},"option_2a":{"name":"Potent Spells","avd12_id":"261_2a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"Kinetic Force","avd12_id":"261_2b","custom":false,"description":"The True Hit threshold on your Kinetic Shot is reduced by 1. Additionally, when you True Hit with your Kinetic Shot Action, you can displace a Large or smaller creature 1 Unit.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Precision Blasts","avd12_id":"261_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Free Action : Charged Shots","avd12_id":"261_4a","custom":false,"description":"You empower your next Kinetic Shot this turn to become a Ray Attack that is a 1 Unit wide line, dealing Arcane Damage.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Free Action : Repeating Blast","avd12_id":"261_4b","custom":false,"description":"After using your Kinetic Shot Action or Channeling a Spell against a target that has a channel time of 1 Action, use the Kinetic Shot Action against that same target.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Improved Kinetic Shot","avd12_id":"261_5","custom":false,"description":"The Damage on your Kinetic Shot is upgraded to 2d6 and the Range is increased to 10 Units. Additionally, your Kinetic Shot and Charged Kinetic Shot variant can Critically Hit","selected":false,"data":"TO","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"0b59df24773a4b87","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Klaktil Integrant","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"28","origin":true,"type":"alteration","description":"undefined","options":{"option_1":{"name":"Knowledge of the Hive","avd12_id":"28_1","custom":false,"description":"Gain +1 to all Knowledge Skills","selected":true,"data":"AS7=1:AS8=1:AS9=1:ASA=1:ASB=1","cost":2},"option_2a":{"name":"Action : Calming Pheromones","avd12_id":"28_2a","custom":false,"description":"For 5 turns, you emit pheromones in a 3-unit radius. At the start of their turn, humanoids and beasts within the area must make a contested Resilience check against 1d12 + half your level. On a failure, they cannot act aggressively unless they or their allies are harmed or threatened. A successful check grants immunity until their next full rest. Additionally, Gain +1d4 to social checks against affected creatures.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Crafting Aura","avd12_id":"28_2b","custom":false,"description":"Gain +1 to all Crafting Skills. You can also assist others with recipes, granting them a +1 bonus to all Craft Checks.","selected":false,"data":"AC1=1:AC2=1:AC3=1:AC4=1:AC5=1:AC6=1:AC7=1","cost":2},"option_3":{"name":"Party Link","avd12_id":"28_3","custom":false,"description":"When you spend a full rest within an enclosed space with one or more humanoids, you can share thoughts and ideas with them telepathically within 10 units until your next full rest.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Multifaceted Eyes","avd12_id":"28_4a","custom":false,"description":"Your connection to the hive has resulted in a physical evolution of your eyes granting you Ultravision.","selected":false,"data":"DU","cost":2},"option_4b":{"name":"Feelers","avd12_id":"28_4b","custom":false,"description":"You have developed extrasensory feelers that grant you Tremorsense and the ability to determine if a creature or object is diseased or poisoned by touching it.","selected":false,"data":"DT:TG","cost":2},"option_5":{"name":"Free Action : Orchestrate","avd12_id":"28_5","custom":false,"description":"You telepathically coordinate an action with an allied creature within 8 units that is under the effect of your Party Link trait. You coordinate one of the following actions: Use, Attack, Shove.","selected":false,"data":"Y","cost":3},"option_6a":{"name":"Improved Link","avd12_id":"28_6a","custom":false,"description":"Your Party Link trait allows two-way communication and no longer has a maximum range as long as the target is on the same celestial body as you. This additionally grants you a 2d4 bonus to insight checks against humanoids you are linked with.","selected":false,"data":"TG","cost":2},"option_6b":{"name":"Reaction : Shared Knowledge","avd12_id":"28_6b","custom":false,"description":"In response to a humanoid under the effect of your Party Link trait that you can see making a Defense or Knowledge Check, grant them a 1d4 bonus.","selected":false,"data":"ZX2","cost":2},"option_7":{"name":"Hive Elite","avd12_id":"28_7","custom":false,"description":"You have absorbed skills from the hive to make you a more proficient protector. Gain +1 Attack and +1 Spell Attack","selected":false,"data":"AZ2=1:AZ6=1:AZ7=1:AZ8=1:AZ9=1:AZM=1","cost":3},"option_8a":{"name":"Chitinous Growths","avd12_id":"28_8a","custom":false,"description":"Gain +1 Physical and +1 Elemental Mitigation while not wearing armor","selected":false,"data":"W0D4=1:W0DA=1","cost":2},"option_8b":{"name":"Action [Daily] : Agitating Pheromones","avd12_id":"28_8b","custom":false,"description":"You release pheromones within a radius equal to half your level that affects all Monsters, Beasts and Humanoids within the area who are not under the effect of your Party Link trait. Each creature must make a Resilience Check against 1d12 plus half your level or become either Maddened or Confused, which you must specifiy before using this ability.","selected":false,"data":"XD1","cost":2},"option_9":{"name":"Action [Daily] : Hive Recruiter","avd12_id":"28_9","custom":false,"description":"You attempt to bring a humanoid under the effect of your party link closer to the hivemind by making a 1d12 check plus half your level against their resilience modifier. If successful, they are charmed by you until the end of your next full rest. If you successfully charm this humanoid three days in a row, they are absorbed into the hive.","selected":false,"data":"XD1","cost":4},"option_a":{"name":"Reaction [Daily] : Consult the Hive","avd12_id":"28_a","custom":false,"description":"In response to making a Skill Check, you consult the hive and gain their combined skills to aid you, granting you a 2d4 bonus.","selected":true,"data":"ZD1","cost":0},"option_b":{"name":"Hivemind","avd12_id":"28_b","custom":false,"description":"You are a member of a Klaktil Hive and have been absorbed into their unified mind. While the king or queen of the hive is alive and on the same celestial body as you, you are considered permanently charmed by the hive and are immune to charm effects from other sources. You no longer have the ability to focus but are considered to be alerted when you are conscious but are immune to the confused and maddened condition.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"14dde86c87784ec4","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Knight","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"229","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Vow","avd12_id":"229_1","custom":false,"description":"You make a Vow to an Order that is willing to accept you, agreeing to abide by their code and rules. While your Vow is satisifed, you can take refuge within any establishment dedicated to your order, in which you are fed and boarded. A Full Rest within any establishment associated with your order is Favorable and you gain extra Health and Power equal to your Level.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Armored Knight","avd12_id":"229_2a","custom":false,"description":"Gain +1 Resilience and gain +1 Physical Mitigation while wearing Medium and Heavy Armor.","selected":false,"data":"AS6=1:W2D4=1","cost":2},"option_2b":{"name":"Beacon of the Order","avd12_id":"229_2b","custom":false,"description":"Gain +1 Persuasion and +1 Strength","selected":false,"data":"ASC=1:AS2=1","cost":2},"option_3":{"name":"Squire","avd12_id":"229_3","custom":false,"description":"You are appointed a Squire by your Order who follows your commands as long as it does not break your Vow. Should the Squire die, you can be assigned another within any establishment dedicated to your order at the cost of 50 Gold. Upon reaching Level 9, your Squire can be upgraded to a Knight for 500 Gold.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Know No Fear","avd12_id":"229_4a","custom":false,"description":"While you are not Maddened or Confused, you and any Ally within 6 Units are Immune to the Afraid Condition, ending the Condition if an Afraid Ally moves within this Radius.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Boon of the Vanguard","avd12_id":"229_4b","custom":false,"description":"While you and your Squire are within 4 Units of each other, your True Hit threshold is increased by 1 and you gain a 1d4 Bonus to Resilience Checks. If your Squire is a Knight, they get this Bonus as well.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Free Action : Honor Strike","avd12_id":"229_5","custom":false,"description":"Make an Attack with a Weapon with no Bonus Damage Modifier. If the Attack hits, that Target has a 1d4 Penalty to Attacks against anyone other than you on their next Action or Bonus Action.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"298e35b57142439a","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Kobold","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"12","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Foolishly Brave","avd12_id":"12_1","custom":false,"description":"The Kobold culture is built upon banding together and being fearless in the face of certain death. While there are 2 or more Allies within 6 Units, you are Immune to being Afraid.","selected":true,"data":"ALJ:TD","cost":2},"option_2a":{"name":"Natural Throwing Arm","avd12_id":"12_2a","custom":false,"description":"Often short of weaponry to support such a large population, it is commonplace in the Kobold culture to perfect accurate throwing to deter predators. Small Objects that you throw and Throwing Ammunition deal an additional 2 Damage and are upgraded to Critical Hits on a True Hit.","selected":false,"data":"T9","cost":2},"option_2b":{"name":"Good with Traps","avd12_id":"12_2b","custom":false,"description":"The Kobold culture typically employs traps to protect their property and hard-won treasure. Gain +1 Thievery and +1 Engineering","selected":false,"data":"ASA=1:AC7=1","cost":2},"option_3":{"name":"Action : Skitterstrike","avd12_id":"12_3","custom":false,"description":"You move up to Half your Movement Speed. For every Creature you come within 1 Unit of, you can make an Attack with a Light or Unarmed Weapon.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"The Draconic Legacy","avd12_id":"12_4a","custom":false,"description":"The kobold culture was shaped by the dragons of old, and some knowledge of that magic still remains. Gain 3 Beginner and 3 Novice Draconic Spells.","selected":false,"data":"","cost":2},"option_4b":{"name":"Cavedwellers","avd12_id":"12_4b","custom":false,"description":"Kobold societies are built underground, and those who dwell within learn to listen for subtle sounds to detect enemies. You gain +1 Search and Tremorsense up to 6 Units.","selected":false,"data":"TG:ASG=1:DT","cost":2},"option_5":{"name":"Free Action : Reckless Abandon","avd12_id":"12_5","custom":false,"description":"You dedicate yourself to all out aggression against a Creature that is two sizes or more larger than you. Until the start of your next turn, you gain a 1d4 Bonus to Attacks against this Creature but suffer a 1d4 Penalty to all Defense Checks against them.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"ec00a96979934a66","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Leader","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"215","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Initiative Taker","avd12_id":"215_1","custom":false,"description":"Gain +1 Persuasion and +1 Initiative","selected":true,"data":"ASC=1:ASH=1","cost":2},"option_2a":{"name":"Action : Charge Ahead","avd12_id":"215_2a","custom":false,"description":"All allies within 10 Units of you who are lower in the Initiatve Order gain +2 Units of Movement Speed on their next Turn. If they use the Move Action on their turn, they gain Bonus Damage on the next Weapon Attack they make equal to your Persuasion Modifier","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Reaction : Advise","avd12_id":"215_2b","custom":false,"description":"When a Contested Check is made against an Ally within 10 Units, add a 1d4 to their Check if you you can speak and they can hear you.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Sociable","avd12_id":"215_3","custom":false,"description":"Become Good at one Social Skill","selected":false,"data":"","cost":2},"option_4a":{"name":"Free Action : Lead the Charge","avd12_id":"215_4a","custom":false,"description":"After using the Move Action, grant all Allies within 10 Units that can hear you extra Movement Speed equal to your Persuasion Modifier on their next Move Action before the start of your next turn. If an Ally makes an Attack Roll after utilizing this extra Speed and is closer to you than they were at the start of their turn, they gain a 1d4 Bonus to it.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Action : To the Death","avd12_id":"215_4b","custom":false,"description":"You make a Persuasion Check and drop into Lifeline, gaining Lifeline Points equal to your Check to a maximum of 12. Allied Creature who can hear you within 8 Units are not affected by the penalties associated with Lifeline until they reach 1 Lifeline Point. This lasts until you are no longer in Lifeline or fall Unconscious. If an Enemy dies within 8 Units of an Ally, all allies within that Radius gain 1 Lifeline Point.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Steadfast Presence","avd12_id":"215_5","custom":false,"description":"When an Allied Creature is within 8 Units of you, they gain a 1d4 Bonus to Resistance and Resilience Checks.","selected":false,"data":"TD","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"341952ea2fb841a8","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Light Armored Fighting","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"114","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Light Armored Fighting","avd12_id":"114_1","custom":false,"description":"Gain +1 Dodge and +1 Block while wearing Light Armor","selected":true,"data":"W1D2=1:W1D3=1","cost":2},"option_2a":{"name":"Physical Defense","avd12_id":"114_2a","custom":false,"description":"Gain +1 Physical Mitigation on all Light Armor","selected":false,"data":"W1D4=1","cost":2},"option_2b":{"name":"Elemental Defense","avd12_id":"114_2b","custom":false,"description":"Gain +1 Elemental Mitigation on all Light Armor","selected":false,"data":"W1DA=1","cost":2},"option_3":{"name":"Unencumbered Leather","avd12_id":"114_3","custom":false,"description":"Remove the Block and Dodge Penalties from Light Armor","selected":false,"data":"W1DR=1","cost":2},"option_4a":{"name":"Leatherworker","avd12_id":"114_4a","custom":false,"description":"Gain +2 Smithing when crafting Light Armor","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Freedom of Movement","avd12_id":"114_4b","custom":false,"description":"Gain +1 Movement Speed","selected":false,"data":"AV=1","cost":2},"option_5":{"name":"Improved Mitigation","avd12_id":"114_5","custom":false,"description":"Gain +2 Physical Mitigation on all Light Armor","selected":false,"data":"W1D4=2","cost":2},"option_6a":{"name":"Free Action : Quick Defense","avd12_id":"114_6a","custom":false,"description":"You take the Defend Action by using a Free Action and gain an additional +1 Bonus to Defense Checks before the start of your next turn while wearing Light Armor.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Training Payoff","avd12_id":"114_6b","custom":false,"description":"Gain +1 Stealth, +1 Acrobatics and +1 Athletics","selected":false,"data":"AS1=1:AS3=1:AS4=1","cost":2},"option_7":{"name":"Light Armor Expert","avd12_id":"114_7","custom":false,"description":"Gain +2 Elemental Mitigation and +1 Physical Mitigation on all Light Armor","selected":false,"data":"W1DA=2:W1D4=1","cost":3},"option_8a":{"name":"Reaction: Reliable Dodge","avd12_id":"114_8a","custom":false,"description":"When you take Damage, reduce it by half before calculating Mitigations.","selected":false,"data":"ZX2","cost":2},"option_8b":{"name":"Impact Protection","avd12_id":"114_8b","custom":false,"description":"When you are hit by a Critical or Brutal Critical Hit, double your Physical Mitigation against the Damage.","selected":false,"data":"TD","cost":2},"option_9":{"name":"Alternative Protection","avd12_id":"114_9","custom":false,"description":"Gain +4 Dark, Arcane and Divine Mitigation","selected":false,"data":"AD7=4:AD8=4:ADC=4","cost":4},"option_10a":{"name":"Unburdened Dodge","avd12_id":"114_10a","custom":false,"description":"Gain +1 Dodge and Immunity to the Prone condition","selected":false,"data":"AD2=1:I=20","cost":3},"option_10b":{"name":"Glancing Blows","avd12_id":"114_10b","custom":false,"description":"You gain a 1d4 Block and Dodge bonus against Projectile Attacks","selected":false,"data":"TD","cost":3},"option_11":{"name":"Light Armor Master","avd12_id":"114_11","custom":false,"description":"Gain +2 Physical and +2 Elemental Mitigation while wearing Light Armor. Additionally, gain +1 Dodge, Block and Resistance.","selected":false,"data":"W1D4=2:W1DA=2:AD1=1:AD2=1:AD3=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"68d2b704763f400b","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Lizardman","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"3","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Trained Hunters","avd12_id":"3_1","custom":false,"description":"Lizardmen are brought up from a young age hunting in harsh conditions and require keen senses and skills. Gain +1 Wilderness and +1 Search.","selected":true,"data":"ALE:ASG=1:ASB=1","cost":2},"option_2a":{"name":"Meat on a Stick","avd12_id":"3_2a","custom":false,"description":"Cooking is an essential part of Lizardman culture, gaining +1 Cooking. When you Craft a Basic Meal using 2 Meat, you produce an Improved Meal instead of a Basic one.","selected":false,"data":"AC1=1:TC","cost":2},"option_2b":{"name":"Steppe Brawlers","avd12_id":"3_2b","custom":false,"description":"The Lizardmen hunt massive Creatures at a distance with long spears and ranged weapons. Gain +1 Damage with Piercing and Ranged Weapons.","selected":false,"data":"AZC=1:AZ9=1","cost":2},"option_3":{"name":"Grand Migrations","avd12_id":"3_3","custom":false,"description":"The Lizardmen are migratory and are well equipped to deal with the wilderness. You gain +2 Fire and Cold Mitigation and get credit for a Favorable Rest when sleeping outside.","selected":false,"data":"TG:AD5=2:AD6=2","cost":2},"option_4a":{"name":"Free Action : Savage Fighting","avd12_id":"3_4a","custom":false,"description":"When you miss with a Melee Attack, you make a quick and brutal Unarmed Attack against the same Target with a 1d4 Attack Penalty but an additional 2d6 damage.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Stalking","avd12_id":"3_4b","custom":false,"description":"The Lizardmen are trained at an early age to move both quickly and quietly to set up ambushes. Gain +1 Initiative, +1 Stealth and +1 Movement Speed.","selected":false,"data":"AV=1:ASH=1:AS4=1","cost":2},"option_5":{"name":"Vsthrii Honor Scout","avd12_id":"3_5","custom":false,"description":"The highest honor in the Lizardmen culture is being appointed an Honor Scout after proving yourself in the great hunt. Gain +1 Search, +1 Athletics, and +1 Attack with Ranged Weapons.","selected":false,"data":"AZ5=1:ASG=1:AS1=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9fd7ecaa2c914408","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Local Legend","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"208","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Just Lucky","avd12_id":"208_1","custom":false,"description":"Gain 1 Luck Dice","selected":true,"data":"L1","cost":2},"option_2a":{"name":"Comic Relief","avd12_id":"208_2a","custom":false,"description":"Gain +1 Performance. When you roll a 1 on a Defense or Attack Check, the next Ally to make a Defense or Attack Check within 8 Units of you gains a 1d4 Bonus.","selected":false,"data":"ASC=1","cost":2},"option_2b":{"name":"Reaction : Duck!","avd12_id":"208_2b","custom":false,"description":"In response to a Creature making a Melee or Projectile Attack at you, you roll an Initiative Check against the Attack instead in an attempt to redirect the Attack to a Creature that is Adjacent to you. If successful, the Adjacent Creature must make the Defense Check intead of you.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Scripted Fate","avd12_id":"208_3","custom":false,"description":"When you use a Luck Dice, you can instead roll a 1d4. On a 2 or higher, replace the original roll with an 11. Otherwise, the roll becomes a 1.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Reaction : Words of Wisdom","avd12_id":"208_4a","custom":false,"description":"When an Allied Humanoid within 4 Units of you rolls a Skill Check, you offer up words of wisdom in the form of a motto or advice. You then make the same Check with a 1d4 Bonus that replaces the Check made by the Ally.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Catch Phrase","avd12_id":"208_4b","custom":false,"description":"You Speak your catchphrase before making an Attack. If the Creature dies or falls Unconscious as a result of this Attack, you and everyone within 8 Units who can Hear you gains a Heroic Action.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Last Words","avd12_id":"208_5","custom":false,"description":"In response to being in Lifeline even if you are Unconscious, you gather the strength to offer your final words to anyone within 4 Units, forcing a Death Check. When making your Death Check, you add your Performance Modifier to a maximum of 6 to the Roll.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"988f2f6f663c4300","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Loremaster","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"266","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Booksmarts","avd12_id":"266_1","custom":false,"description":"Gain +1 Scribing. Additionally, gain +2 to Knowledge Checks when recalling historical events about Architecture, cultures and Famous Figures","selected":true,"data":"TG:AC3=1","cost":2},"option_2a":{"name":"Versed in Magic","avd12_id":"266_2a","custom":false,"description":"Gain +2 Arcane Mitigation and +2 Psychic Mitigation","selected":false,"data":"ADC=2:AD9=2","cost":2},"option_2b":{"name":"Lorekeeper","avd12_id":"266_2b","custom":false,"description":"Gain +1 Academics, +1 Wilderness and +1 Arcanum","selected":false,"data":"AS9=1:ASB=1:AS7=1","cost":2},"option_3":{"name":"Student of Magic","avd12_id":"266_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Master of Language","avd12_id":"266_4a","custom":false,"description":"You learn one Magical and one non-Magical Language.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Master of Artifacts","avd12_id":"266_4b","custom":false,"description":"You can attempt to Identify magical effets on an Object with an Arcanum or Academics Check of 12 and by spending 1 Hour studying it. With a 15 or higher, you recall information about any curses that may be associated with the Object.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Reaction : Student of Magic","avd12_id":"266_5","custom":false,"description":"When forced to make a Resistance Check against a Spell or Ability, you make an Arcanum Check instead.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f8f911a1d5f04445","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Lycanthropy","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"122","origin":true,"type":"alteration","description":"undefined","options":{"option_1":{"name":"Tearing Claws","avd12_id":"122_1","custom":false,"description":"While you are in Lycanthrope form, your claws count as Light 1 Handed Slashing Weapons and cause the Bleeding Condition on a True Hit.","selected":true,"data":"TA","cost":2},"option_2a":{"name":"Wild Tracker","avd12_id":"122_2a","custom":false,"description":"Your Lycanthropy has manifested in innate hunting skills. Gain +1 Search and +1 Wilderness","selected":false,"data":"ASG=1:ASB=1","cost":2},"option_2b":{"name":"Calming Allies","avd12_id":"122_2b","custom":false,"description":"Despite your savagery, you are still receptive to intervention from allies. While in Lycanthropy form, an Ally can use an Action to attempt to calm you down by making a Contested Persuasion Check against your Resilience. If they succeed, you lose any Maddened Condition affecting you. If they succeed with a result of 15 or higher, you revert back to your original form.","selected":false,"data":"TA","cost":2},"option_3":{"name":"Beastial Manifestations","avd12_id":"122_3","custom":false,"description":"Your Lycanthropy has advanced to a point where your body is subtly transformed. Gain +2 Cold Mitigation, +1 Strength and +1 Acrobatics.","selected":false,"data":"AD5=2:AS2=1:AS3=1","cost":2},"option_4a":{"name":"Action : Lunge","avd12_id":"122_4a","custom":false,"description":"While in Lycanthrope Form, you leap from a standing position a distance equal to your Athletics Modifier and make an Attack with one of your Claws.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Free Action : Blood Trail","avd12_id":"122_4b","custom":false,"description":"While in Lycanthrope Form, you Move up to your Movement Speed towards a Creature that has the Bleeding or Wounded Condition.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Inner Beast","avd12_id":"122_5","custom":false,"description":"Gain +1 Resilience, +1 Athletics and +1 Damage with Slashing Weapons","selected":false,"data":"AS1=1:AS6=1:AZA=1","cost":3},"option_6a":{"name":"Reaction : Resist","avd12_id":"122_6a","custom":false,"description":"After being forced to make a Resilience Check, add 1d6 to your Check.","selected":false,"data":"ZX2","cost":2},"option_6b":{"name":"Action [Daily] : Alphahowl","avd12_id":"122_6b","custom":false,"description":"While in Lycanthrope form, you let loose a devastating howl by making an Animals Check. Any hostile Beast within 20 Units must make a Resilience Check greater than or equal to your Animals Check or become Afraid of you. At the end of each turn, they can attempt to make the Check again against the initial Animals Check. Otherwise, the Afraid Condition lasts for 1 minute.","selected":false,"data":"XD1","cost":2},"option_7":{"name":"Fortified","avd12_id":"122_7","custom":false,"description":"When you transform into a Lycanthrope, the Temporary Health you gain is doubled.","selected":false,"data":"TA","cost":3},"option_8a":{"name":"Free Action : Offhand Claw","avd12_id":"122_8a","custom":false,"description":"When you make an Attack with one of your claws while in Lycanthropy Form, you can make an additional Attack with your offhand.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Overcome Weakness","avd12_id":"122_8b","custom":false,"description":"Your strength with your inner beast has grown to a point where you can remove your Lycanthropy Weakness Trait.","selected":false,"data":"TA","cost":2},"option_9":{"name":"Action [Daily] : Controlled Transformation","avd12_id":"122_9","custom":false,"description":"When a Creature has the Bleeding Condition within 20 Units if you, can you willfully transform into a Lycanthrope without making a Check or be subjected to the Maddened Condition.","selected":false,"data":"XD1","cost":4},"option_a":{"name":"Action : Lycanthrope Bite","avd12_id":"122_a","custom":false,"description":"While in Lycanthrope form, You make an Unarmed Attack against a Creature that deals an additional 1d10 Physical Damage. A Creature must make a Resilience Check against the total Physical Damage dealt after Mitigation or become Diseased. If the Disease Creature is a Humanoid and they are not cured within 1d20 days, they are inflicted with Lycanthropy.","selected":true,"data":"XX3","cost":0},"option_b":{"name":"Lycanthrope","avd12_id":"122_b","custom":false,"description":"You are afflicted with Lycanthropy and suffer the benefits and weaknesses. Whenever you are the Target of a True Hit, you must make a Resilience Check against half the total Damage taken after Mitigation or transform into your Lycanthrope Form, gaining Temporary Health equal to your Level and losing the ability to Speak. If there is a Creature within 20 Units has the Bleeding Condition, you become Maddened, which cannot be avoided or removed by any spells, immunities or effects. You remain in this form until you reach 0 Health, at which point you revert back to your original form, gain 1 Tier of Exhaustion, and make a LIfeline Check. The Lycanthrope transformation lasts 1d6 hours and you cannot transform again until you complete a Full Rest.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"aa3d1ae9e0974d31","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Mage Hunter","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"211","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Prepared Mind","avd12_id":"211_1","custom":false,"description":"Gain +1 Resistance and +2 Psychic Mitigation","selected":true,"data":"AD1=1:AS9=2","cost":2},"option_2a":{"name":"Free Action : Suppress","avd12_id":"211_2a","custom":false,"description":"You make a Sonic Attack at a Creature within 3 Units by making a Contested Check using your Arcanum against their Concentration. On a success, your Target has a 1d4 Penalty to all Spell Attacks until the start of your next turn.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Reaction : Mageslayer","avd12_id":"211_2b","custom":false,"description":"In response to a Creature Channeling a Spell within 3 Units that you have an unobstructed path to, you Move within your Melee Range and make a Melee Attack against them, dealing Bonus Damage equal to your Arcanum Bonus Modifier. The Creature must then make a Concentration Check to maintain Focus, or the Spell fails.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Hunter of Magic","avd12_id":"211_3","custom":false,"description":"Gain +1 Search and +1 Arcanum","selected":false,"data":"ASG=1:AS7=1","cost":2},"option_4a":{"name":"Magical Sense","avd12_id":"211_4a","custom":false,"description":"When a Spell is Channeled within 10 Units of you, you become accutely aware of other magic within the Area. This awareness extends to Spells of equal or lower Level than the initially Channeled Spell that are affecting Creatures or Objects.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Distracting Blows","avd12_id":"211_4b","custom":false,"description":"When you force a Creature to make a Concentration Check to maintain Focus, the Required Check is increased by an amount equal to your Arcanum Modifier.","selected":false,"data":"TO","cost":2},"option_5":{"name":"Spell Breaker","avd12_id":"211_5","custom":false,"description":"When you interrupt a Spell that is being Channeled or Maintained with Focus, you immediately gain an Action. This can occur once until the start of your next turn.","selected":false,"data":"TO","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"09dcad25b8f74087","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Magic Fist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"279","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Spellfist Conduit","avd12_id":"279_1","custom":false,"description":"When your conduit is installed on either Gloves or an Unarmed Weapon worn on the hand, all of your Ray, Projectile and Melee Attack Spells that target a single creature have their range reduced to adjacent targets, but use your Unarmed Attack modifier instead of your Spell Attack modifier.","selected":true,"data":"TF","cost":2},"option_2a":{"name":"Untamed Magic","avd12_id":"279_2a","custom":false,"description":"Gain +1 Arcanum and +1 Spell Damage","selected":false,"data":"AZ4=1:AS7=1","cost":2},"option_2b":{"name":"Disciplined Magic","avd12_id":"279_2b","custom":false,"description":"Gain +1 Elemental Mitigation and +1 Damage with Unarmed Strikes","selected":false,"data":"ADA=1:AZN=1","cost":2},"option_3":{"name":"Free Action : Spellfist Charge","avd12_id":"279_3","custom":false,"description":"When you Channel a Ray, Projectile or Melee Attack Spell using your Spellfist Conduit it becomes Charged.","selected":false,"data":"Y","cost":2},"option_4a":{"name":"Extended Spellfist","avd12_id":"279_4a","custom":false,"description":"The Range limitations on your Ray, Projectile and Melee Attack Spells from your Spellfist Conduit are removed.","selected":false,"data":"TF","cost":2},"option_4b":{"name":"Unarmed Accuracy","avd12_id":"279_4b","custom":false,"description":"Gain +1 Unarmed Attack","selected":false,"data":"AZM=1","cost":2},"option_5":{"name":"Form of the Elementals","avd12_id":"279_5","custom":false,"description":"You gain the Elemental Fist Stance.","selected":false,"data":"H=23","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"21f38cf2636f427e","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Magical Savant","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"201","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Magic Crafts","avd12_id":"201_1","custom":false,"description":"Gain +1 Runecarving, +1 Scribing and +1 Alchemy","selected":true,"data":"AC3=1:AC4=1:AC5=1","cost":2},"option_2a":{"name":"Subject Expert","avd12_id":"201_2a","custom":false,"description":"Become Good at one Knowledge Skill","selected":false,"data":"AS4=1:AS7=1","cost":2},"option_2b":{"name":"Polyglot","avd12_id":"201_2b","custom":false,"description":"Learn one non-Magical Language and one Magical Language","selected":false,"data":"","cost":2},"option_3":{"name":"Problem Solver","avd12_id":"201_3","custom":false,"description":"Gain +1 Concentration and +1 Arcanum","selected":false,"data":"AS5=1:AS7=1","cost":2},"option_4a":{"name":"Reaction : Hyperfocus","avd12_id":"201_4a","custom":false,"description":"In response to making a Concentration Check from taking Damage while Focusing on a Spell, gain a 1d4 Bonus to that Check. If you successfully maintain Focus, gain a Bonus to any Defense Checks until the start of your next turn equal to the result of the d4.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Reaction : Interception","avd12_id":"201_4b","custom":false,"description":"In response to a Creature making a Projectile or Ray Attack that travels within 10 Units of you, you Channel a Projectile or Ray Spell that takes 1 Action. Roll a 1d12 and add a +2 Bonus for each Level of the Spell you Channeled. If your Roll is greater than the initial Attack Roll, the Projectile or Ray is destroyed and does not reach its Target.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Exotic Magic","avd12_id":"201_5","custom":false,"description":"You choose one exotic school of magic which you can now research Beginner and Novice spells from. Journeyman spells can be researced at level 7 and Expert at level 9.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"5fb5dc21a52e4703","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Magismith","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"223","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Magismith","avd12_id":"223_1","custom":false,"description":"Gain Access to Magismithing. You can use Beginner and Novice Level Catalysts in your Magismithing Recipes.","selected":true,"data":"TC","cost":2},"option_2a":{"name":"Magismith Catalyst Expert","avd12_id":"223_2a","custom":false,"description":"Gain +1 Spell Damage. Additionally, Catalysts that you create count as 1 tier higher for the purpose of Magismith Recipes.","selected":false,"data":"TC:AZ4=1","cost":2},"option_2b":{"name":"Jewelry Infusions","avd12_id":"223_2b","custom":false,"description":"You can add an additional Infusion to Rings you Craft.","selected":false,"data":"TC","cost":2},"option_3":{"name":"Variable Mitigations","avd12_id":"223_3","custom":false,"description":"When you add a Magismithing Infusion to Chest Armor, a Shield or a Weapon, add +2 Mitigation of your choice against Dark, Divine, Arcane or Psychic to the Object.","selected":false,"data":"TC","cost":2},"option_4a":{"name":"Forged in Magic","avd12_id":"223_4a","custom":false,"description":"Any Object you Craft receives the Immutable and Conduit Slot Infusion without consuming an Infusion Slot when you add a Lead Ingot to the Recipes.","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Craft : Transfer Enchantment","avd12_id":"223_4b","custom":false,"description":"You spend 1 Day and a Pinch of Powdered Gold to transfer all of the magical effects from one piece of Equipment to another non-magical piece of Equipment that occupies the same Equipment Slot as the original.","selected":false,"data":"TC","cost":2},"option_5":{"name":"Improved Magismithing","avd12_id":"223_5","custom":false,"description":"Gain +1 Smithing. Additionally, you can use Journeyman Catalysts in your Magismithing Recipes at Level 7, Expert at 9 and Master at 11.","selected":false,"data":"TC:AC1=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"154f069f60cd4458","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Medic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"123","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Anatomical Expertise","avd12_id":"123_1","custom":false,"description":"Gain +1 Medicine and +2 Health","selected":true,"data":"AS8=1:AH=1","cost":2},"option_2a":{"name":"In Good Health","avd12_id":"123_2a","custom":false,"description":"Gain +1 Resilience and +1 Physical Mitigation","selected":false,"data":"AD4=1:AS6=1","cost":2},"option_2b":{"name":"Veterinarian","avd12_id":"123_2b","custom":false,"description":"Gain +1 Animals and you can use your Medic Skills that target Humanoids on Beasts.","selected":false,"data":"ASF=1:TG","cost":2},"option_3":{"name":"Action : Stabilize","avd12_id":"123_3","custom":false,"description":"You quickly apply a Sterile Bandage to a Creature, ending any Bleeding Condition and causing them to not lose Lifeline Points at the end of their turn while in Lifeline unless they take Damage.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Pharmacist","avd12_id":"123_4a","custom":false,"description":"Gain +1 Academics and +1 Alchemy","selected":false,"data":"AS9=1:AC5=1","cost":2},"option_4b":{"name":"Bedside Manner","avd12_id":"123_4b","custom":false,"description":"Gain +1 Insight and +1 Medicine","selected":false,"data":"AS8=1:ASD=1","cost":2},"option_5":{"name":"Treat Wounds","avd12_id":"123_5","custom":false,"description":"You spend 1 minute treating a Humanoid or Beast, restoring Health equal to a Medicine Check and using a Sterile Bandage. A Creature can only be affected by this ability once per Full Rest.","selected":false,"data":"TG","cost":2},"option_6a":{"name":"Action : Resuscitate","avd12_id":"123_6a","custom":false,"description":"If a Humanoid has been dead for less than 1 minute and is not missing any vital organs, you can attempt to revive them with a Cumulative Medicine Check of 28 over 3 Checks","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Action : Bloodletting","avd12_id":"123_6b","custom":false,"description":"Using a blade, you give a Creature the Bleeding Condition by making a small cut. If this is used in a hostile way, make a normal Attack with a Light Piercing or Slashing Weapon and foce the Target to make a Resilience Check against the Physical Damage dealt after Mitigation. If the Creature Bleeds for 4 turns, they are cured of any Disease or Poison affecting them.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Triage","avd12_id":"123_7","custom":false,"description":"You spend 10 Minutes tending to up to 5 allies, restoring Health equal to 1d12 + a Medicine Check by using a number of Sterile Bandages equal to the number of Creatures being treated. A Creature can only be affected by this ability once per day.","selected":false,"data":"TG","cost":2},"option_8a":{"name":"Reaction : Damage Control","avd12_id":"123_8a","custom":false,"description":"Using your knowledge of Medicine and Anatomy, when you take Physical Damage, you can reduce it by half before applying Mitigations.","selected":false,"data":"ZX2","cost":2},"option_8b":{"name":"Diagnosis","avd12_id":"123_8b","custom":false,"description":"When you restore a Creatures Health with Treat Wounds or Triage, you also remove any Blindness, Deafness or Wounded Condition from them.","selected":false,"data":"TG","cost":2},"option_9":{"name":"Embodiment of Health","avd12_id":"123_9","custom":false,"description":"Gain +5 Health and +2 Medicine","selected":false,"data":"AH=10:AS8=2","cost":3},"option_10a":{"name":"Vital Spot","avd12_id":"123_10a","custom":false,"description":"The True Hit threshold on your Weapon Attacks is increased by 1","selected":false,"data":"TO","cost":3},"option_10b":{"name":"Placebo Effect","avd12_id":"123_10b","custom":false,"description":"Whenever you restore Health or remove a Condition from a Creature, they receive Temporary Health equal to your Level.","selected":false,"data":"TG","cost":3},"option_11":{"name":"Master Healer","avd12_id":"123_11","custom":false,"description":"The limits on how many times you can treat a Creature with Triage and Treat Wounds are removed","selected":false,"data":"TG","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d801d4deaee545a5","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Melodic Mage","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"212","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Melodic Conduit","avd12_id":"212_1","custom":false,"description":"You can use a Musical Instrument as a Conduit, allowing you to play Magical Ballads and Channel Spells. You gain the ability to play Magical Ballads which require an Action to start and your Focus to maintain which affect anyone within 4 Units who can hear. Learn 1 Magical Ballad of your choice.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Composer","avd12_id":"212_2a","custom":false,"description":"Gain +1 Arcanum and +1 Scribing","selected":false,"data":"AS7=1:AC3=1","cost":2},"option_2b":{"name":"Enhanced Ballads","avd12_id":"212_2b","custom":false,"description":"The Range on your Ballads is increased by 2","selected":false,"data":"FB=2","cost":2},"option_3":{"name":"New Composition","avd12_id":"212_3","custom":false,"description":"Learn a Magical Ballad and gain +1 Concentration","selected":false,"data":"AS5=1","cost":2},"option_4a":{"name":"Action : Improvise","avd12_id":"212_4a","custom":false,"description":"You use your Melodic Conduit to Channel a Beginner or Novice Spell that requires your Focus without spending any Power or requiring you to be able to speak.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Free Action : Powerchord","avd12_id":"212_4b","custom":false,"description":"If you are currently Focusing on playing a Ballad, you play a powerful note on your instrument, causing the next Spell you complete Channeling on this turn to be Charged.","selected":false,"data":"Y","cost":2},"option_5":{"name":"The Magic of Music","avd12_id":"212_5","custom":false,"description":"Gain +1 Spell Damage, +1 Spell Attack and learn a Magical Ballad","selected":false,"data":"AZ4=1:AZ2=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"b9716e124ac943f6","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Minotaur","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"15","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Unrelenting","avd12_id":"15_1","custom":false,"description":"The Minotaur culture is one where things change slowly, if at all, giving them a reputation of legendary stubborness. Gain +1 Resilience and +1 Strength","selected":true,"data":"ALQ:A62=1:AS2=1","cost":2},"option_2a":{"name":"Reaction : Blood Fury","avd12_id":"15_2a","custom":false,"description":"In response to being the Target of a True Hit that deals Physical Damage, you enter a Blood Fury until you make your next Melee Attack. If the Attack hits, it is automatically upgraded to a True Hit. Until you make that Attack, you automatically fail all Defense Checks.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"The Dark Heresy","avd12_id":"15_2b","custom":false,"description":"The Minotaur culture have a long and storied history with Entities of the dark. Learn 3 Beginner and 3 Novice Fiend Spells.","selected":false,"data":"","cost":2},"option_3":{"name":"Bond with Death","avd12_id":"15_3","custom":false,"description":"The Minotaur culture does not fear death and is trained to endure under the harshest of conditions. You act normally within Lifeline until reaching 2 Lifeline Points. Additionally, you cannot be Frightened and do not suffer the effects of Exhaustion while in Lifeline.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Hard Headed","avd12_id":"15_4a","custom":false,"description":"The Minotaur culture settles many disputes by bashing heads together and clashing skulls. You can no longer unwillingly become Unconscious.","selected":false,"data":"TD","cost":2},"option_4b":{"name":"Legacy of Axes","avd12_id":"15_4b","custom":false,"description":"The axe is the weapon of the Minotaur people and they honor that legacy. Gain +1 Attack and +1 Damage with Slashing Weapons","selected":false,"data":"AZ6=1:AZA=1","cost":2},"option_5":{"name":"Brutal Fighter","avd12_id":"15_5","custom":false,"description":"You gain Critical Hits with all Melee and Ranged Weapons","selected":false,"data":"AZE:AZF:AZG:AZH:TA","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"09650550543a41db","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Monk","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"241","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Monk's Discipline","avd12_id":"241_1","custom":false,"description":"Gain +1 Damage with Unarmed Strikes and +1 Concentration.","selected":true,"data":"AS5=1:AZN=1","cost":2},"option_2a":{"name":"Free Action : Palm Strike","avd12_id":"241_2a","custom":false,"description":"After hitting a Creature with a Melee Attack, make an Unarmed Strike against the same Creature that deals no Damage against a contested Concentration Check. On a failure, the Target becomes Dazed until the end of their next Turn. On a True Hit, the Creature becomes Stunned.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Action : Flying Kick","avd12_id":"241_2b","custom":false,"description":"You make a leaping Unarmed Strike moving up to 3 Units towards a Creature using your Acrobatics Modifier as the Attack Check. If the Attack hits, it deals Physical Damage equal to the result of your Check.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Trained Form","avd12_id":"241_3","custom":false,"description":"Become Good at either Acrobatics, Athletics or Concentration","selected":false,"data":"","cost":2},"option_4a":{"name":"Unrestricted Movement","avd12_id":"241_4a","custom":false,"description":"Gain +1 Physical Mitigation and +1 Elemental Mitigation while wearing Light or no Armor.","selected":false,"data":"W0D4=1:W1D4=1:W0DA=1:W1DA=1","cost":2},"option_4b":{"name":"Trained Form","avd12_id":"241_4b","custom":false,"description":"Gain +1 Unarmed Attack and +1 Attack with Crushing Weapons","selected":false,"data":"AZM=1:AZ7=1","cost":2},"option_5":{"name":"Reaction [Daily] : Resilient Soul","avd12_id":"241_5","custom":false,"description":"In response to being the Target of an Attack, halve the Damage before applying mitigation. If the resulting Damage brings you to 0 Health, gain 1 Health instead. Additionally, you Gain Temorary Health equal to twice your Level that lasts for 1 minute.","selected":false,"data":"ZD1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a798078a3e5c464c","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Monster Slayer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"205","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Monster Bane","avd12_id":"205_1","custom":false,"description":"Gain a 1d4 Bonus to Defense Checks against Monsters and Beasts.","selected":true,"data":"TO","cost":2},"option_2a":{"name":"Monster Tracker","avd12_id":"205_2a","custom":false,"description":"Gain +1 Search and +1 Initiative","selected":false,"data":"ASH=1:ASG=1","cost":2},"option_2b":{"name":"Fearless Hunter","avd12_id":"205_2b","custom":false,"description":"Gain Immunity to the Afraid Condition","selected":false,"data":"I=1","cost":2},"option_3":{"name":"Action : Devastate","avd12_id":"205_3","custom":false,"description":"If you have Moved at least 4 Units on a turn, you can make a Melee Attack dealing bonus Damage equal to the distance in Units you moved. If the Target is a Monster or Beast, this bonus is doubled.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Increased Potency","avd12_id":"205_4a","custom":false,"description":"Gain +1 Spell Damage and Gain +1 Damage with Melee Attacks","selected":false,"data":"AZ4=1:AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_4b":{"name":"Monster Tamer","avd12_id":"205_4b","custom":false,"description":"You can Tame a Monster as a Pet within the Level of the Pet Taming Formula using your Persuasion Skill instead of your Animals Skill.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Action : Monster Harvest","avd12_id":"205_5","custom":false,"description":"You make an Attack with a Spell or Weapon. If this Attack brings a Creature to 8 or less Health, the Monster is executed. You gain Permanent Temporary Heath that recharges after each Full Rest equal to the Level of the Monster you killed. Other effects that grant Temporary Health no longer work on you.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"998b1438bd0d4d93","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Naturalist","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"269","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Wildborn","avd12_id":"269_1","custom":false,"description":"Gain +1 Animals and +1 Wilderness ","selected":true,"data":"ASF=1:ASB=1","cost":2},"option_2a":{"name":"Natural Weaponry","avd12_id":"269_2a","custom":false,"description":"Gain +1 Damage to Crushing Weapons and you can Smith Crushing Weapons with Treated Wood in place of Steel Ingots.","selected":false,"data":"AZB=1:TC","cost":2},"option_2b":{"name":"Tracker","avd12_id":"269_2b","custom":false,"description":"Gain +1 Search. Additionally, you can spend 10 Minutes examining an Area with a Radius of 20 Units to accurately determine what Beasts or Monsters passed through within the last day as well as acquiring their tracks.","selected":false,"data":"ASG=1:TG","cost":2},"option_3":{"name":"Action [Daily] : One with Nature","avd12_id":"269_3","custom":false,"description":"After ending a Full Rest in Wilderness, gain Temporary Health equal to [Level]d4 that expire after your next Full Rest.","selected":false,"data":"XD1","cost":2},"option_4a":{"name":"Proven Explorer","avd12_id":"269_4a","custom":false,"description":"Become Good at Wilderness and learn a non-Magical Language","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Reaction : Endurant Nature","avd12_id":"269_4b","custom":false,"description":"In response to being forced to make a Resilience or Resist Check, add 1d6 to the Roll.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Healthy Living","avd12_id":"269_5","custom":false,"description":"Whenever consume an Object that restores Health, such as a healing potion or food, gain extra Health equal to your Wilderness Modifier.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"de1a3785871747fd","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Naturally Gifted","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"226","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Quick Learner","avd12_id":"226_1","custom":false,"description":"When you gain access to a new tier of spells through a Core Module, learn 1 Spell from that tier automatically. This is retroactive for schools you already know.","selected":true,"data":"","cost":2},"option_2a":{"name":"Attuned","avd12_id":"226_2a","custom":false,"description":"Gain +1 Arcanum, +3 Power and +2 Power Regeneration","selected":false,"data":"AS7=1:FP=3:FR=2","cost":2},"option_2b":{"name":"Wisened","avd12_id":"226_2b","custom":false,"description":"Gain +1 Academics and +1 Wilderness","selected":false,"data":"AS9=1:ASB=1","cost":2},"option_3":{"name":"Natural Magic","avd12_id":"226_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Reaction : Inspire","avd12_id":"226_4a","custom":false,"description":"When you or an Ally make a Knowledge Check, you inspire them, adding a 1d6 Bonus to their Check. This ability can only be used a number of times per day equal to your Knowledge Attribute.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Artisan","avd12_id":"226_4b","custom":false,"description":"Gain +1 to all Crafting Skills","selected":false,"data":"ACA=1","cost":2},"option_5":{"name":"Superior Focus","avd12_id":"226_5","custom":false,"description":"While you are Focusing on a Spell or Ballad, gain +1 to all Defensive Checks and Immunity to the Maddened and Afraid Conditions","selected":false,"data":"TD","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"854858a2cbb1472e","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Necromantic Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"104","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Necromancer","avd12_id":"104_1","custom":false,"description":"You can research Beginner Level Necromancy Spells and gain +1 Power.","selected":true,"data":"S31=4:FP=1","cost":2},"option_2a":{"name":"Potent Spells","avd12_id":"104_2a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"Enduring Death","avd12_id":"104_2b","custom":false,"description":"Gain +1 Resilience and +2 Health","selected":false,"data":"AS6=1:AH=2","cost":2},"option_3":{"name":"Reaction : Death Pact","avd12_id":"104_3","custom":false,"description":"When you drop to 0 Health, instead drop to 1 Health and immediately gain one Action","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Dark Experiments","avd12_id":"104_4a","custom":false,"description":"Gain +1 Medicine and +1 Academics","selected":false,"data":"AS8=1:AS9=1","cost":2},"option_4b":{"name":"Dark Magic","avd12_id":"104_4b","custom":false,"description":"Gain +1 Arcanum and +2 Arcane Mitigation","selected":false,"data":"AS7=1:ADC=2","cost":2},"option_5":{"name":"Novice Necromancer","avd12_id":"104_5","custom":false,"description":"You can research Novice Level Necromancy Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S32=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Action [Daily] : Death Touch","avd12_id":"104_6a","custom":false,"description":"You make a Touch Spell Attack against a Creature, dealing Dark Damage equal to [Level]d6.","selected":false,"data":"XD1","cost":2},"option_6b":{"name":"Essence Theft","avd12_id":"104_6b","custom":false,"description":"When you bring a Creature to 0 Health, you gain Health and Power equal to half of their Level.","selected":false,"data":"TG","cost":2},"option_7":{"name":"Journeyman Necromancer","avd12_id":"104_7","custom":false,"description":"You can research Journeyman Level Necromancy Spells, gain +5 Power and +2 Dark Mitigation","selected":false,"data":"S33=3:AD7=2:FP=5","cost":3},"option_8a":{"name":"Free Action : Undead Service","avd12_id":"104_8a","custom":false,"description":"When you take a Creature down to 0 Health as a result of one of your Spells, the Creature comes under your command, taking its turn after yours ends. At the end of its turn, this effect ends. This Spell does not affect Elementals or Constructs.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Repurposed Horrors","avd12_id":"104_8b","custom":false,"description":"Your Spells that raise Beasts or Humanoids as Thralls also work on Monsters and Undead.","selected":false,"data":"T","cost":2},"option_9":{"name":"Expert Necromancer","avd12_id":"104_9","custom":false,"description":"You can research Expert Level Necromancy Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S34=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Lich","avd12_id":"104_10a","custom":false,"description":"You no longer require Sleeping, Drinking or Breathing. You do not require Food and it does not benefit you when you eat it. Additionally, you become Immune to Disease, Exhaustion, Poison and become Immune to effects that make you Sleep.","selected":false,"data":"I=8:I=10:I=20:I=21","cost":3},"option_10b":{"name":"Undead Conduit","avd12_id":"104_10b","custom":false,"description":"You can Channel Spells using a Thrall under your control as the point of origin. If the Spell requires Focus, it uses your Thralls Focus instead of yours.","selected":false,"data":"TG","cost":3},"option_11":{"name":"Master Necromancer","avd12_id":"104_11","custom":false,"description":"You can research Master Level Necromancy Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Necromancy Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"52af617da1b24b49","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Ninja","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"275","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"The Way of the Ninja","avd12_id":"275_1","custom":false,"description":"Gain +1 Acrobatics and +1 Initiative","selected":true,"data":"AS4=1:AC5=1","cost":2},"option_2a":{"name":"Wallrunner","avd12_id":"275_2a","custom":false,"description":"Gain +1 Movespeed. Use your Movement Speed to climb or move across walls and surfaces. If you reach a stable surface during your Move Action, you can attach to it. If not, you fall.","selected":false,"data":"TG:AV=1","cost":2},"option_2b":{"name":"Ambusher","avd12_id":"275_2b","custom":false,"description":"Gain +1 Initiative. When you start a Combat Hidden or Invisible, you gain an extra Action on your first turn of Combat and you remain Hidden or Invisible until the end of your turn.","selected":false,"data":"TO:ASH=1","cost":2},"option_3":{"name":"Coordinated Movement","avd12_id":"275_3","custom":false,"description":"Gain +1 Stealth and +1 Athletics","selected":false,"data":"AS4=1:AS1=1","cost":2},"option_4a":{"name":"Reaction : Lightning Reflexes","avd12_id":"275_4a","custom":false,"description":"When Targeted by a Projectile or Ray, you use your Initiative Check instead of the standard Defense Check until the start of your next turn.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Deadly Throwing","avd12_id":"275_4b","custom":false,"description":"When you use a Throwing Ammunition, the Dice is upgraded from a 1d6 to a 1d10. This Damage is doubled if you are Hidden.","selected":false,"data":"T8","cost":2},"option_5":{"name":"Master of Defense","avd12_id":"275_5","custom":false,"description":"Gain +1 Dodge, Block and Resistance","selected":false,"data":"AD3=1:AD1=1:AD2=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e2de7bff99704bf9","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Orc","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"5","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"One Purpose","avd12_id":"5_1","custom":false,"description":"Orcish culture is one of loyalty and perserverance to a greater cause. Gain +1 Resilience and +1 Initiative.","selected":true,"data":"AS6=1:ASH=1:AL3","cost":2},"option_2a":{"name":"Faithless","avd12_id":"5_2a","custom":false,"description":"The Orcish cultures have long since given up worshipping the Gods and insulate themselves from the temptations they offer. Gain +3 Dark and +3 Divine Mitigation.","selected":false,"data":"AD7=3:AD8=3","cost":2},"option_2b":{"name":"The Old Ways","avd12_id":"5_2b","custom":false,"description":"The Orcish culture still has small remnants of those who have dedicated themselves to shamanism. Gain 3 Beginner and 3 Novice Druidic Spells.","selected":false,"data":"","cost":2},"option_3":{"name":"Body and Mind","avd12_id":"5_3","custom":false,"description":"Orcish culture values a diverse eduction so that all who share in their lifestyle can find the correct path. Gain +1 Athletics and +1 Academics.","selected":false,"data":"AS1=1:AS9=1","cost":2},"option_4a":{"name":"Trained by the Thok-Ro","avd12_id":"5_4a","custom":false,"description":"You have training with the Thok-Ro Warriors. Gain +1 Block with Shields and +1 Damage with Slashing Weapons.","selected":false,"data":"W5D3=1:AZA=1","cost":2},"option_4b":{"name":"Craft : Refining","avd12_id":"5_4b","custom":false,"description":"The Orcish culture cherishes perfection and perfect metalwork. Once per executing a Recipe that requires an Ingot and before you attempt your Crafting Check, your next Check counts as an Overcraft on a Dice Roll of 9 or higher.","selected":false,"data":"O","cost":2},"option_5":{"name":"Orcish Industry","avd12_id":"5_5","custom":false,"description":"The Orcish culture believes in cross-trained artisans to secure their future. Gain +1 Smithing, +1 Ammocraft, +1 Alchemy and +1 Engineering.","selected":false,"data":"AC1=1:AC6=1:AC5=1:AC7=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"6e9f8c0abfbd4e70","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Orycotal","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"4","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Isolationist","avd12_id":"4_1","custom":false,"description":"The Orycotal culture is one of both suspicion and superstition. Gain +1 Initiative and +1 Insight","selected":true,"data":"ASH=1:ASD=1:AL6","cost":2},"option_2a":{"name":"Encouraged Curiousity","avd12_id":"4_2a","custom":false,"description":"The Orycotal are taught that the most curious are often the most rewarded. You gain +1 Search and become Good at either the Search or Initiative Skill","selected":false,"data":"ASG=1","cost":2},"option_2b":{"name":"Craft : Improved Accessory","avd12_id":"4_2b","custom":false,"description":"The Orycotal appreciate the beauty and power of accessories like rings. When you Craft an Accessory, it has an extra Infusion Slot.","selected":false,"data":"O","cost":2},"option_3":{"name":"Reaction : Trained against Darkness","avd12_id":"4_3","custom":false,"description":"In response to taking Dark Damage, reduce the amount by double your Level. If all the Dark Damage was Mitigated, gain Temporary Health equal to your Level until the end of your next turn.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Emnity of the Fey","avd12_id":"4_4a","custom":false,"description":"Certain factions within the Orycotal culture have an extreme distrust of the Fey and prepare to face them at every turn. Gain +1 Resistance and +2 Psychic Mitigation.","selected":false,"data":"AD1=1:AD9=2","cost":2},"option_4b":{"name":"Ally of the Fey","avd12_id":"4_4b","custom":false,"description":"Certain factions within  the Orycotal culture have allied themselves with the Fey. You Learn 3 Beginner and 3 Novice Fey Magic Spells.","selected":false,"data":"","cost":2},"option_5":{"name":"Culture of Tranquility","avd12_id":"4_5","custom":false,"description":"The Orycotal are taught not to act in anger. Through learning and practice, you have become Immune to the Maddened Condition.","selected":false,"data":"I=16","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f3b2634a5f0a45ea","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"124","origin":true,"type":"alteration","description":"undefined","options":{"option_1":{"name":"Contracted","avd12_id":"124_1","custom":false,"description":"Additionally, you learn 4 Beginner Spells from your Patron's school of magic","selected":true,"data":"TA","cost":2},"option_2a":{"name":"Martial Knowledge","avd12_id":"124_2a","custom":false,"description":"Gain +1 Damage to all Melee Weapons and +1 Strength","selected":false,"data":"AZ3=1:AS2=1","cost":2},"option_2b":{"name":"Arcane Knowledge","avd12_id":"124_2b","custom":false,"description":"Gain +1 Spell Damage and +1 Arcanum","selected":false,"data":"AZ4=1:AS7=1","cost":2},"option_3":{"name":"Guiding Hand","avd12_id":"124_3","custom":false,"description":"Gain +1 Spell Attack and +1 to Melee Attacks.","selected":false,"data":"AZ6=1:AZ7=1:AZ8=1:AZM=1:AZ2=1","cost":2},"option_4a":{"name":"Gift of Focus","avd12_id":"124_4a","custom":false,"description":"Gain +1 Concentration and Immunity to the Charmed Condition","selected":false,"data":"I=4:AS5=1","cost":2},"option_4b":{"name":"Gift of Comprehension","avd12_id":"124_4b","custom":false,"description":"Learn the Magical Language of your Patron and gain +1 Insight","selected":false,"data":"ASD=1","cost":2},"option_5":{"name":"Improved Pact","avd12_id":"124_5","custom":false,"description":"Learn 4 Novice Level Spells of your Patron's school of magic and gain a Pact Familiar.","selected":false,"data":"","cost":3},"option_6a":{"name":"Action : Infused Weapon","avd12_id":"124_6a","custom":false,"description":"You make a Weapon Attack but convert the Primary Damage to Arcane Damage. If you are fully aligned with your Patron, you gain a 1d4 Bonus to your Attack Roll.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Free Action : Infused Spell","avd12_id":"124_6b","custom":false,"description":"You Charge a Spell from your Patron's school of magic. If you are not fully aligned with your Patron, your Spell Attack has a 1d4 penalty.","selected":false,"data":"Y","cost":2},"option_7":{"name":"Journeyman Pact Magic","avd12_id":"124_7","custom":false,"description":"Learn 4 Journeyman Level Spells of your Patron's school of magic and gain +1 Spell Attack.","selected":false,"data":"AA2=1:AZ2=1","cost":3},"option_8a":{"name":"Enhanced Core","avd12_id":"124_8a","custom":false,"description":"Gain +12 Power and +12 Power Regeneration","selected":false,"data":"FP=12:FR=12","cost":2},"option_8b":{"name":"Reaction : Planar Defense","avd12_id":"124_8b","custom":false,"description":"In response to being targeted by an Attack, make a Persuasion Check instead of your normal Defense Check. On a success, your Patron defends you from the Attack and you take no Damage.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Pact Bound","avd12_id":"124_9","custom":false,"description":"Learn 4 Expert Level Spells of your Patron's School of Magic, At level 10, learn 2 Master Spells of your Patron's schools of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AA4=1:AZ2=1:AZ4=1","cost":4},"option_a":{"name":"Reaction [Daily] : Favor of the Patron","avd12_id":"124_a","custom":false,"description":"In response to making any Skill Check, add 2d4 to the result. This is decreased to a 1d4 if you have negative alignment with your Patron and does not add any bonus if you have -3 alignment.","selected":true,"data":"ZD1","cost":0},"option_b":{"name":"Pact Alignment","avd12_id":"124_b","custom":false,"description":"Your Patron lends you power with the expectation that your actions will align with their interests. You start your Pact fully aligned with your Patron. When you defy the wishes of your Patron, you lose an alignment, up to a maximum of 3. For each alignment you lose, your Spell Attacks from your Patron's School of Magic suffer a -1 Attack Penalty. At -3 alignment, you can no longer Channel Spells from your Patron's School. Alignment can be restored by fulfilling tasks for your Patron or taking significant actions that please them.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"62fa10c7dad94e9b","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Painseeker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"283","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Masochist","avd12_id":"283_1","custom":false,"description":"Your Maximum Health is increased in an amount equal to your Level, but you can no longer benefit from Temporary Health.","selected":true,"data":"AH=L:TG","cost":2},"option_2a":{"name":"Free Action : Reckless Onslaught","avd12_id":"283_2a","custom":false,"description":"You leap up to your Jump distance. If your next Melee Attack hits on this turn, it is upgraded to a True Hit. Until the start of your next turn, the first Melee Attack that hits you is also upgraded to a True Hit.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Action : Anguishing Strike","avd12_id":"283_2b","custom":false,"description":"You make an Attack with a melee weapon that deals an additional 1d8 Primary Damage if you are below your Maximum Health. This bonus is increaesd to 2d8 when below half your Maximum Health, and 4d8 while in lifeline.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Chase the Pain","avd12_id":"283_3","custom":false,"description":"While at or below half your maximum Health, you gain a 1d4 bonus to Melee Attacks but have a 1d4 Penalty when at your Health maximum.","selected":false,"data":"TO","cost":2},"option_4a":{"name":"Focused Agony","avd12_id":"283_4a","custom":false,"description":"Gain +1 Concentration. Additionally, While you are below half Health, you are immune to the Confused, Dazed and Stunned conditions.","selected":false,"data":"AS5=1:TD","cost":2},"option_4b":{"name":"Savored Death","avd12_id":"283_4b","custom":false,"description":"Gain +1 Resilience. Additionally, when you enter lifeline, you gain a Heroic Action.","selected":false,"data":"AS6=1:TG","cost":2},"option_5":{"name":"Reaction : Pain Threshold","avd12_id":"283_5","custom":false,"description":"In response to taking Damage, make a Resilience Check and reduce the damage by that amount. If you are below half your maximum Health before taking the damage, this does not count against your unique Reaction limit.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"beb335718ba24b65","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Piercer","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"111","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Piercer","avd12_id":"111_1","custom":false,"description":"Gain +1 Attack and +1 Damage with Piercing Weapons. Gain a Fighting Stance.","selected":true,"data":"AZ8=1:AZC=1","cost":2},"option_2a":{"name":"Reaction : Flank","avd12_id":"111_2a","custom":false,"description":"When an Allied Creature makes a Melee Attack against a target within your Melee Range, you can make an Attack against that same target with a 1d4 Bonus.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Increased Damage","avd12_id":"111_2b","custom":false,"description":"Gain +1 Damage with Piercing Weapons","selected":false,"data":"AZC=1","cost":2},"option_3":{"name":"Novice Piercer","avd12_id":"111_3","custom":false,"description":"Gain +1 Attack with Piercing Weapons and Learn a Fighting Stance from the Stance Table","selected":false,"data":"AZ8=1:H=Z","cost":2},"option_4a":{"name":"Free Action : Puncture","avd12_id":"111_4a","custom":false,"description":"After hitting a Character with a Piercing Weapon, force the target to roll a Resilience  Check against your total Damage dealt after Mitigation. If the target fails, they gain the Bleeding Condition","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Action : Thrust","avd12_id":"111_4b","custom":false,"description":"Make a normal Attack. Your next Attack with this same Weapon has a +2 Bonus to Attack until the start of your next turn regardless if your first Attack hits.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Journeyman Piercer","avd12_id":"111_5","custom":false,"description":"Gain +1 Attack with Piercing Weapons and gain access to the Attack of Opportunity Reaction","selected":false,"data":"AZV=0:AZ8=1","cost":2},"option_6a":{"name":"Reaction : Reactive Toss","avd12_id":"111_6a","custom":false,"description":"When a Creature moves within 4 Units of you, you can throw a Light Piercing Weapon at them.","selected":false,"data":"ZX2","cost":2},"option_6b":{"name":"Action : Impale","avd12_id":"111_6b","custom":false,"description":"You make an Attack against a Creature with a Heavy Piercing Weapon. The Creature must make an Acrobatics or Athletics check against your Strength Modifier. If they fail, they cannot move until the end of their next turn or you make another Attack with the same Weapon.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Expert Piercer","avd12_id":"111_7","custom":false,"description":"Gain Critical Hits and +1 Attack with Piercing Weapons","selected":false,"data":"AZG:AZ8=1","cost":3},"option_8a":{"name":"Action : Flurry","avd12_id":"111_8a","custom":false,"description":"Make 3 Attacks with the same Piercing Weapon, but each Attack has a -2 Modifier to each Attack and cannot True Hit.","selected":false,"data":"XX3","cost":2},"option_8b":{"name":"Action : Power Toss","avd12_id":"111_8b","custom":false,"description":"Make a Throwing Weapon Attack with a 1 Handed Piercing Weapon at a -2 Modifier that is upgraded to a True Hit if it hits the Target.","selected":false,"data":"XX3","cost":2},"option_9":{"name":"Master Piercer","avd12_id":"111_9","custom":false,"description":"Gain Brutal Critical Hits with Piercing Weapons and Gain +1 Attack with Piercing Weapons","selected":false,"data":"AZL:AZ8=1","cost":4},"option_10a":{"name":"Precise","avd12_id":"111_10a","custom":false,"description":"Gain +1 Attack and +1 Athletics","selected":false,"data":"AZ8=1:AS1=1","cost":3},"option_10b":{"name":"Action : Multi-thrust","avd12_id":"111_10b","custom":false,"description":"Make 2 Attacks with a Piercing Weapon, each with a +2 Attack Bonus. If both Attacks hit, the Target gains the Bleeding Condition.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Grandmaster Piercer","avd12_id":"111_11","custom":false,"description":"Your Damage Die for Piercing Weapons are upgraded (1-Handed Light: 2d6, 1-Handed Heavy: 2d8, 2-Handed Light: 3d6, 2-Handed Heavy: 3d8)","selected":false,"data":"AZY","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"0b9fcb1f882647cf","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Planar [Sky]","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"22","origin":true,"type":"planar","description":"undefined","options":{"option_1":{"name":"Minor Planar Magic","avd12_id":"22_1","custom":false,"description":"You learn 4 Beginner Spells from the Divine or Aeromancy schools of magic.","selected":true,"data":"","cost":2},"option_2a":{"name":"Innate Levitation","avd12_id":"22_2a","custom":false,"description":"Gain a Hover Speed equal to your Movement Speed.","selected":false,"data":"T5","cost":2},"option_2b":{"name":"Skylord's Protection","avd12_id":"22_2b","custom":false,"description":"Gain +2 Lightning, +1 Dark and +1 Physical Mitigation","selected":false,"data":"ADB=2:AD7=1:AD4=1","cost":2},"option_3":{"name":"The Language of the Wind","avd12_id":"22_3","custom":false,"description":"You gain the Aeron Language and gain +1 Spell Damage","selected":false,"data":"ALN:AZ4=1","cost":2},"option_4a":{"name":"Action [Daily] : Elemental Form","avd12_id":"22_4a","custom":false,"description":"You take the form of an Air Sprite, gaining it's stat block for 1 minute or until you reach 0 Health. At Level 5, this ability improves, allowing you to take the form of an Air Elementaling instead. At Level 9, you can take the form of an Air Elemental","selected":false,"data":"XD1","cost":2},"option_4b":{"name":"Reaction : Lightning Rod","avd12_id":"22_4b","custom":false,"description":"In response to you or an ally within 4 units taking lightning damage, reduce that damage by an amount equal to your level. The next Aeromancy spell you channel before the end of your next turn is charged. If that spell deals lightning damage, the damage is increased by an amount equal to your level.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Lesser Planar Magic","avd12_id":"22_5","custom":false,"description":"You learn 4 Novice Spells from the Divine or Aeromancy schools of magic.","selected":false,"data":"","cost":3},"option_6a":{"name":"Free Action : Smiting Thunder","avd12_id":"22_6a","custom":false,"description":"After making a Melee or Ranged Attack, immediately make another attack with that same weapon against the same target, dealing only the Primary Damage which is all converted to lightning.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Swift","avd12_id":"22_6b","custom":false,"description":"You gain +1 Movement Speed and +1 Dodge","selected":false,"data":"AV=1:AD2=1","cost":2},"option_7":{"name":"Planar Magic","avd12_id":"22_7","custom":false,"description":"You learn 4 Journeyman Spells from the Divine or Aeromancy schools of magic.","selected":false,"data":"","cost":3},"option_8a":{"name":"Storm Giant's Strength","avd12_id":"22_8a","custom":false,"description":"Gain +2 Strength and +1 Damage with Melee Attacks","selected":false,"data":"AZ4=1:AZA=1:AZB=1:AZC=1:AZN=1:AS2=2","cost":2},"option_8b":{"name":"Action [Daily] : Mount of the Valkyr","avd12_id":"22_8b","custom":false,"description":"You touch a Horse, transforming it into a Pegasus which is considered your pet. This enchantment lasts until the Pegasus dies, which it returns to the Plane of Valor. Only one horse can be transformed by this enchantment at a time.","selected":false,"data":"XD1","cost":2},"option_9":{"name":"Greater Planar Magic","avd12_id":"22_9","custom":false,"description":"You learn 4 Expert Spells from the Divine or Aeromancy schools of magic. At level 10, learn 2 Master Spells from the Divine or Aeromancy schools of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ4=1:AZ2=1","cost":4},"option_a":{"name":"Action : Lighter than Air","avd12_id":"22_a","custom":false,"description":"You take a modified version of the Move Action where you have a flight speed equal to 8 units plus your Spell Damage Bonus Modifier. This movement does not provoke reactions.","selected":true,"data":"XX3","cost":0},"option_b":{"name":"Aeron Connection","avd12_id":"22_b","custom":false,"description":"You have a connection with the Plane of Aeron, or one of it's adjacent planes, manifesting in minor or major changes to your appearance.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"6ca4ba8f3d6046df","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Planar [Earth]","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"24","origin":true,"type":"planar","description":"undefined","options":{"option_1":{"name":"Minor Planar Magic","avd12_id":"24_1","custom":false,"description":"You learn 4 Beginner Spells from the Druidic or Geomancy schools of magic.","selected":true,"data":"","cost":2},"option_2a":{"name":"Tunneler","avd12_id":"24_2a","custom":false,"description":"Gain a Burrow Speed equal to your Movement Speed.","selected":false,"data":"T7","cost":2},"option_2b":{"name":"Earthen Crust","avd12_id":"24_2b","custom":false,"description":"Gain +1 Physical Mitigation and +1 Block","selected":false,"data":"AD4=1:AD3=1","cost":2},"option_3":{"name":"The Language of the Earth","avd12_id":"24_3","custom":false,"description":"You gain the Okkor Language and gain +1 Spell Damage","selected":false,"data":"AZ4=1:ALO","cost":2},"option_4a":{"name":"Action [Daily] : Elemental Form","avd12_id":"24_4a","custom":false,"description":"You take the form of an Earth Sprite, gaining it's stat block for 1 minute or until you reach 0 Health. At Level 5, this ability improves, allowing you to take the form of an Earth Elementaling instead. At Level 9, you can take the form of an Earth Elemental","selected":false,"data":"XD1","cost":2},"option_4b":{"name":"Might of the Land","avd12_id":"24_4b","custom":false,"description":"Gain +1 Wilderness, +1 Strength and +1 Resilience","selected":false,"data":"ASB=1:AS2=1:AS6=1","cost":2},"option_5":{"name":"Lesser Planar Magic","avd12_id":"24_5","custom":false,"description":"You learn 4 Novice Spells from the Druidic or Geomancy schools of magic.","selected":false,"data":"","cost":3},"option_6a":{"name":"Geocrystals","avd12_id":"24_6a","custom":false,"description":"Your connection to the Plane of Okkor has manifested on crystal-like growths on your body that facilitate magic. Gain +10 Power and +10 Power Regeneration.","selected":false,"data":"FP=10:FR=10","cost":2},"option_6b":{"name":"Action : Geowave","avd12_id":"24_6b","custom":false,"description":"You make a Melee Attack against the ground, causing a wave of energy striking any creature within 2 units with a Force Attack. Any Huge or smaller creature who fails the check falls prone and takes Physical Damage equal to your level.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Planar Magic","avd12_id":"24_7","custom":false,"description":"You learn 4 Journeyman Spells from the Druidic or Geomancy schools of magic.","selected":false,"data":"","cost":3},"option_8a":{"name":"Okkor's Binding","avd12_id":"24_8a","custom":false,"description":"When crafting weapons or armor, you can add an additional infusion. Additionally, weapons you craft gain the Magical trait and armor you craft gains +1 Physical Mitigation.","selected":false,"data":"TC","cost":2},"option_8b":{"name":"Action [Daily] : Gift of Nature","avd12_id":"24_8b","custom":false,"description":"You touch another creature, granting them 3 Physical and 3 Elemental Mitigation for an hour. This effect is doubled on beasts.","selected":false,"data":"XD1","cost":2},"option_9":{"name":"Greater Planar Magic","avd12_id":"24_9","custom":false,"description":"You learn 4 Expert Spells from the Druidic or Geomancy schools of magic. At level 10, learn 2 Master Spells from the Druidic or Geomancy schools of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ2=1:AZ4=1","cost":4},"option_a":{"name":"Action : Solid as Stone","avd12_id":"24_a","custom":false,"description":"You take the Defend Action and gain Physical and Arcane Mitigation equal to your Level until the start of your next turn.","selected":true,"data":"XX3","cost":0},"option_b":{"name":"Okkor Connection","avd12_id":"24_b","custom":false,"description":"You have a connection with the Plane of Okkor, or one of it's adjacent planes, manifesting in minor or major changes to your appearance.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a24a236a54a14a1a","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Planar [Fey]","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"25","origin":true,"type":"planar","description":"undefined","options":{"option_1":{"name":"Minor Planar Magic","avd12_id":"25_1","custom":false,"description":"You learn 4 Beginner Spells from the Fey school of magic.","selected":true,"data":"","cost":2},"option_2a":{"name":"Prankster","avd12_id":"25_2a","custom":false,"description":"The Fey culture has given you an appreciation for tricks. Gain +1 Thievery and +1 Spell Damage.","selected":false,"data":"ASA=1:AZ4=1","cost":2},"option_2b":{"name":"Free Action : Names","avd12_id":"25_2b","custom":false,"description":"You speak the true name of a humanoid you can see within 10 units. For the next minute, the target has a 1d4 penalty to the next Resistance Check they make against you.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Protection of the Glade","avd12_id":"25_3","custom":false,"description":"You Gain +1 Resistance, +1 Arcane Mitigation and learn the Sylvan Language","selected":false,"data":"AD1=1:ADC=1:ALS","cost":2},"option_4a":{"name":"Feymind","avd12_id":"25_4a","custom":false,"description":"Your mind is protected from the trickery of others. Gain +2 Psychic and Immunity to the Charmed Condition.","selected":false,"data":"I4:AD9=2","cost":2},"option_4b":{"name":"Siren's Song","avd12_id":"25_4b","custom":false,"description":"Learn a Magical Ballad and gain +1 Performance. If you don't already have it, you gain the ability to play Ballads which require an Action to start and your Focus to maintain which can affect anyone within 4 Units who can hear.","selected":false,"data":"ASE=1","cost":2},"option_5":{"name":"Lesser Planar Magic","avd12_id":"25_5","custom":false,"description":"You learn 4 Novice Spells from the Fey school of magic.","selected":false,"data":"","cost":3},"option_6a":{"name":"Action [Daily] : Sprite Form","avd12_id":"25_6a","custom":false,"description":"You transform into either a Sprite or Pixie, taking on their statblock, but retaining your Knowledge and Social skills. This transformation lasts until you willfully end it or you reach 0 Health, at which point you transform back into your original form.","selected":false,"data":"XD1","cost":2},"option_6b":{"name":"Reaction : Feyshift","avd12_id":"25_6b","custom":false,"description":"As a Reaction to being the target of an Attack, you attempt to avoid it by shifting briefly into the Feywild, gaining a 2d4 bonus to your Defense Check. This ability only works on the Material Plane.","selected":false,"data":"ZX2","cost":2},"option_7":{"name":"Planar Magic","avd12_id":"25_7","custom":false,"description":"You learn 4 Journeyman Spells from the Fey school of magic.","selected":false,"data":"","cost":3},"option_8a":{"name":"Action : Fey Dust","avd12_id":"25_8a","custom":false,"description":"You sprinkle fey dust on a creature, granting them flight for the next minute.","selected":false,"data":"XX3","cost":2},"option_8b":{"name":"Free Action : Dreamweaver","avd12_id":"25_8b","custom":false,"description":"The next Melee or Ranged Attack you make this turn deals Psychic Damage instead of it's normal Primary type. If the damage brings a creature to 0 Health and it is not immune to the sleeping condition, it gains the sleeping condition for 1 hour.","selected":false,"data":"Y","cost":2},"option_9":{"name":"Greater Planar Magic","avd12_id":"25_9","custom":false,"description":"You learn 4 Expert Spells from the Fey school of magic. At level 10, learn 2 Master Spells from the Fey school of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ2=1:AZ4=1","cost":4},"option_a":{"name":"Action [Daily] : Charm","avd12_id":"25_a","custom":false,"description":"Using your innate Fey magic, you attempt to charm a Creature that you can see within 10 units by making a Performance Check against their Resistance. On a success, the creature is charmed by you for an hour or until it breaks naturally. On a failure, the creature is not aware of your attempt.","selected":true,"data":"XD1","cost":0},"option_b":{"name":"Fey","avd12_id":"25_b","custom":false,"description":"You have the Fey creature type, as well as the humanoid type. Your fey lineage also has physical implications, changing your appearance in a minor or drastic way.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"0f78e8e6c2514361","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Planar [Fire]","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"21","origin":true,"type":"planar","description":"undefined","options":{"option_1":{"name":"Minor Planar Magic","avd12_id":"21_1","custom":false,"description":"You learn 4 Beginner Spells from the Fiend or Pyromancy schools of magic.","selected":true,"data":"","cost":2},"option_2a":{"name":"Action : Break Flame","avd12_id":"21_2a","custom":false,"description":"You target a creature that is Ignited of Frozen within 12 units and immediately end the condition.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Firecraft","avd12_id":"21_2b","custom":false,"description":"Your skills at manipulating flames has given you a bonus to crafting. Gain +1 Cooking, Alchemy and Smithing","selected":false,"data":"AC1=1:AC5=1:AC2=1","cost":2},"option_3":{"name":"Infernal Speech","avd12_id":"21_3","custom":false,"description":"You gain the Infernal Language and gain +1 Spell Damage","selected":false,"data":"AZ4=1:AL7","cost":2},"option_4a":{"name":"Action [Daily] : Elemental Form","avd12_id":"21_4a","custom":false,"description":"You take the form of a Fire Sprite, gaining it's stat block for 1 minute or until you reach 0 Health. At Level 5, this ability improves, allowing you to take the form of an Fire Elementaling instead. At Level 9, you can take the form of an Fire Elemental","selected":false,"data":"XD1","cost":2},"option_4b":{"name":"Defense of the Dark Flames","avd12_id":"21_4b","custom":false,"description":"Gain +3 Dark and +3 Fire Mitigation","selected":false,"data":"AD7=3:AD6=3","cost":2},"option_5":{"name":"Lesser Planar Magic","avd12_id":"21_5","custom":false,"description":"You learn 4 Novice Spells from the Fiend or Pyromancy schools of magic.","selected":false,"data":"","cost":3},"option_6a":{"name":"Free Action : Devil's Whip","avd12_id":"21_6a","custom":false,"description":"You summon a whip of fire and immediately make a light 1-handed slashing attack against a creature within 3 units, dealing fire damage. On a True Hit, the creature becomes ignited.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Devil's Sight","avd12_id":"21_6b","custom":false,"description":"You gain +2 Search and Ultravision, but suffer a -4 penalty to your Divine Mitigation.","selected":false,"data":"ASG=2:DU:AD8=-4","cost":2},"option_7":{"name":"Planar Magic","avd12_id":"21_7","custom":false,"description":"You learn 4 Journeyman Spells from the Fiend or Pyromancy schools of magic.","selected":false,"data":"","cost":3},"option_8a":{"name":"Burning Resolve","avd12_id":"21_8a","custom":false,"description":"Gain +1 Resilience and Immunity to the Diseased and Poisoned Conditions","selected":false,"data":"AS6=1:I=8:I=19","cost":2},"option_8b":{"name":"Action [Daily] : Hellsteed","avd12_id":"21_8b","custom":false,"description":"You touch a Horse, transforming it into a Nightmare which is considered your pet. This enchantment lasts until the Nightmare dies, which it returns to the Infernal Plane. Only one horse can be transformed by this enchantment at a time.","selected":false,"data":"XD1","cost":2},"option_9":{"name":"Greater Planar Magic","avd12_id":"21_9","custom":false,"description":"You learn 4 Expert Spells from the Fiend or Pyromancy schools of magic. At level 10, learn 2 Master Spells from the Fiend or Pyromancy schools of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ4=1:AZ2=1","cost":4},"option_a":{"name":"Reaction : Vengeful Flames","avd12_id":"21_a","custom":false,"description":"In response to a creature within 10 units dealing damage to you, curse them with fire, dealing damage equal to twice your level which cannot be defended against.","selected":true,"data":"ZX2","cost":0},"option_b":{"name":"Infernal Connection","avd12_id":"21_b","custom":false,"description":"You have a connection with the Infernal Plane, or one of it's adjacent planes, manifesting in minor or major changes to your appearance.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"ee8a5ef548394940","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Planar [Water]","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"23","origin":true,"type":"planar","description":"undefined","options":{"option_1":{"name":"Minor Planar Magic","avd12_id":"23_1","custom":false,"description":"You learn 4 Beginner Spells from the Fiend or Aquamancy schools of magic.","selected":true,"data":"","cost":2},"option_2a":{"name":"Waterborn","avd12_id":"23_2a","custom":false,"description":"You gain a swim speed equal to your movement speed and the ability to breath under water.","selected":false,"data":"T6:TG","cost":2},"option_2b":{"name":"Abyssal Speech","avd12_id":"23_2b","custom":false,"description":"You gain the Abyssal Language and gain +1 Spell Damage","selected":false,"data":"AZ4=1:ALM","cost":2},"option_3":{"name":"Defense of the Cold Depths","avd12_id":"23_3","custom":false,"description":"Gain +3 Dark and +3 Cold Mitigation","selected":false,"data":"AD7=3:AD5=3","cost":2},"option_4a":{"name":"Action [Daily] : Elemental Form","avd12_id":"23_4a","custom":false,"description":"You take the form of a Water Sprite, gaining it's stat block for 1 minute or until you reach 0 Health. At Level 5, this ability improves, allowing you to take the form of an Water Elementaling instead. At Level 9, you can take the form of an Water Elemental","selected":false,"data":"XD1","cost":2},"option_4b":{"name":"Icecraft","avd12_id":"23_4b","custom":false,"description":"You can spend 1 minute creating either a light melee weapon or a piece of ammunition out of an area of water greater in size than 1 cubic unit which is not consumed. This ammunition or weapon has it's primary damage converted to eiterh Dark or Cold Damage and melts at the end of your next Full Rest.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Lesser Planar Magic","avd12_id":"23_5","custom":false,"description":"You learn 4 Novice Spells from the Fiend or Aquamancy schools of magic.","selected":false,"data":"","cost":3},"option_6a":{"name":"Action : Cold Flames","avd12_id":"23_6a","custom":false,"description":"You target a creature that is ignited and turn the flame cold and blue, causing the condition to deal cold damage instead. A creature must spend 2 actions to put out a cold flame as opposed to one. This ability can also be used on an open flame that fits within a 1 unit cube.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Devil's Sight","avd12_id":"23_6b","custom":false,"description":"You gain +2 Search and Ultravision, but suffer a -4 penalty to your Divine Mitigation.","selected":false,"data":"ASG=2:DU:AD8=-4","cost":2},"option_7":{"name":"Planar Magic","avd12_id":"23_7","custom":false,"description":"You learn 4 Journeyman Spells from the Fiend or Aquamancy schools of magic.","selected":false,"data":"","cost":3},"option_8a":{"name":"Reaction [Daily] : Refreshing Ice","avd12_id":"23_8a","custom":false,"description":"In response to taking enough Cold Damage to penetrate your Mitigation, you gain the Frozen Condition. At the start of each turn, you recover Health equal to your level. This condition ends when you reach full Health or the condition ends from taking Fire Damage.","selected":false,"data":"ZD1","cost":2},"option_8b":{"name":"Frozen Aura","avd12_id":"23_8b","custom":false,"description":"When an enemy creature starts their turn within 2 units of you, their Movement Speed is halved for the first Move Action they take. You can activate and deactivate this ability at will.","selected":false,"data":"TD","cost":2},"option_9":{"name":"Greater Planar Magic","avd12_id":"23_9","custom":false,"description":"You learn 4 Expert Spells from the Fiend or Aquamancy schools of magic. At level 10, learn 2 Master Spells from the Fiend or Aquamancy schools of magic. Additionally, gain +1 Spell Attack and +1 Spell Damage.","selected":false,"data":"AZ4=1:AZ2=1","cost":4},"option_a":{"name":"Action : Become Water","avd12_id":"23_a","custom":false,"description":"You teleport to a Location within a body of or a cloud of steam that you can see within 10 nits without provoking Reactions. The area must be large enough to completely surround your form.","selected":true,"data":"XX3","cost":0},"option_b":{"name":"Abyssal Connection","avd12_id":"23_b","custom":false,"description":"You have a connection with the Abyssal Plane, or one of it's adjacent planes, manifesting in minor or major changes to your appearance.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"50d62e5462bd4ac7","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Ranger","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"112","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Ranger","avd12_id":"112_1","custom":false,"description":"Gain +1 Attack and +1 Damage with Ranged Weapons","selected":true,"data":"AZ5=1:AZ9=1","cost":2},"option_2a":{"name":"Distant Shooting","avd12_id":"112_2a","custom":false,"description":"Gain +2 Maximum Units of Range on all Ranged Weapons","selected":false,"data":"O1=2:O2=2:O3=2","cost":2},"option_2b":{"name":"Increased Damage","avd12_id":"112_2b","custom":false,"description":"Gain +1 Damage with Ranged Weapons","selected":false,"data":"AZ9=1","cost":2},"option_3":{"name":"Novice Ranger","avd12_id":"112_3","custom":false,"description":"Increase Maximum range on all Ranged Weapons by 2 Units and reduce minimal range by 1 unit and gain +1 Attack with Ranged Weapons","selected":false,"data":"AZ5=1:O1=2:O2=2:O3=2:O5=1:O6=1:O7=1","cost":2},"option_4a":{"name":"Reaction : Cover Fire","avd12_id":"112_4a","custom":false,"description":"If an Ally is being Attacked in range of your Ranged Weapon, you can shoot 3 Ammunition in quick succession at a Creature lowering their Attack roll by 1d4.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Stance of the Marksman","avd12_id":"112_4b","custom":false,"description":"You learn the Marksmans Focus Stance","selected":false,"data":"H=17","cost":2},"option_5":{"name":"Journeyman Ranger","avd12_id":"112_5","custom":false,"description":"Gain +1 Attack and +1 Damage with Ranged Weapons","selected":false,"data":"AZ5=1:AZ9=1","cost":2},"option_6a":{"name":"Action : Headshot","avd12_id":"112_6a","custom":false,"description":"You make a Ranged Attack dealing an extra 1d10 Damage and increasing your True Hit threshold by 1. The bonus becomes 2d10 on a True Hit.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Action : Steady Aim","avd12_id":"112_6b","custom":false,"description":"You gain a +2 Attack with Ranged Weapons until the end of your next turn. If you Move or are Displaced, this effect ends.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Expert Ranger","avd12_id":"112_7","custom":false,"description":"Gain Critical Hits and Gain +1 Attack with Ranged Weapons","selected":false,"data":"AZH:AZ5=1","cost":3},"option_8a":{"name":"Free Action : Shoot and Scoot","avd12_id":"112_8a","custom":false,"description":"When you make a Ranged Attack, you can move 2 Units.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Action : Burst Shot","avd12_id":"112_8b","custom":false,"description":"You shoot 3 of your ammunition in rapid succession, each with a -2 Attack Penalty. You can target seperate Creatures with this Attack","selected":false,"data":"XX3","cost":2},"option_9":{"name":"Master Ranger","avd12_id":"112_9","custom":false,"description":"Gain Brutal Critical Hits with Ranged Weapons and Gain +1 Attack and Damage with Ranged Weapons","selected":false,"data":"AZI:AZ5=1:AZ9=1","cost":4},"option_10a":{"name":"Velocity","avd12_id":"112_10a","custom":false,"description":"Gain +2 Maximum Units of Range on all Ranged Weapons and +1 Damage with Ranged Weapons","selected":false,"data":"O1=2:O2=2:O3=2:AZ9=2","cost":3},"option_10b":{"name":"Action : Powershot","avd12_id":"112_10b","custom":false,"description":"You make a Ranged Attack at half your normal Range. This shot gains a +3 Attack Modifier, your True Hit threshold is increased by 1, and the Damage bypasses Physical Mitigation.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Grandmaster Ranger","avd12_id":"112_11","custom":false,"description":"Your Damage Die for Ranged Weapons are upgraded (Ultra-Light Ranged: 1d10, Light Ranged: 2d6, Heavy Ranged 3d6)","selected":false,"data":"AZZ","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9aefd3ea728b4d5c","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Reaver","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"280","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Severing Strikes","avd12_id":"280_1","custom":false,"description":"When you score a True Hit with a Melee Attack, your Target gains the Bleeding Condition.","selected":true,"data":"TO","cost":2},"option_2a":{"name":"Visceral Veteran","avd12_id":"280_2a","custom":false,"description":"Gain +2 Psychic Mitigation and +1 Physical Mitigation","selected":false,"data":"AD9=2:AD4=1","cost":2},"option_2b":{"name":"Anatomical Exploits","avd12_id":"280_2b","custom":false,"description":"Gain +1 Damage to all Melee Weapons and +1 Medicine ","selected":false,"data":"AS8=1:AZ3=1","cost":2},"option_3":{"name":"The Art of Gore","avd12_id":"280_3","custom":false,"description":"You gain a +2 Attack Bonus when making a Melee Attack against a Creature with the Bleeding Condition.","selected":false,"data":"TO","cost":2},"option_4a":{"name":"Action : Bloodbath","avd12_id":"280_4a","custom":false,"description":"You remove the Bleeding Condition from all other Creatures within a 2 Unit Radius of you. For each Condition removed, you gain 1d6 Temporary Health that lasts for 1 minute.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Surgical Strike","avd12_id":"280_4b","custom":false,"description":"You make a Melee Attack against a Creature that has the Bleeding Condition. If the attack hits, it is upgraded to a True Hit.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Reaction : Trauma Guard","avd12_id":"280_5","custom":false,"description":"In response to taking Damage, make a Medicine Check and reduce the total Damage by that amount.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8ff42ba3866943ba","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Runecarver","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"130","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Runecarving","avd12_id":"130_1","custom":false,"description":"Gain +2 Runecarving","selected":true,"data":"AC4=2","cost":2},"option_2a":{"name":"Unyielding Light","avd12_id":"130_2a","custom":false,"description":"Your Light Rune does not expire and can be activated and deactivated indefinitely.","selected":false,"data":"TC","cost":2},"option_2b":{"name":"Shared Words","avd12_id":"130_2b","custom":false,"description":"You can teach others your Command Words for runes, allowing them to activate them.","selected":false,"data":"TC","cost":2},"option_3":{"name":"Craft : Efficient Powdered Metal","avd12_id":"130_3","custom":false,"description":"You Grind an Ingot to Dust in half the amount of time and create 14 Pinches instead of 10","selected":false,"data":"O","cost":2},"option_4a":{"name":"Magical Script","avd12_id":"130_4a","custom":false,"description":"Gain +1 Runecarving and +1 Scribing","selected":false,"data":"AC4=1:AC3=1","cost":2},"option_4b":{"name":"Automatic Return","avd12_id":"130_4b","custom":false,"description":"Your Return Rune no longer requires a Command Word to return to you. any Object with this rune can return to you at the start of your next turn if it is more than 1 Unit away and within the Range of the Rune.","selected":false,"data":"TC","cost":2},"option_5":{"name":"Runekeeper","avd12_id":"130_5","custom":false,"description":"Gain +1 Runecarving and +1 Arcanum","selected":false,"data":"AC4=1:AS7=1","cost":2},"option_8a":{"name":"Action : Arcane Break","avd12_id":"130_8a","custom":false,"description":"You either throw an Object with a Breaking Rune on it or activate it with your command word. Instead of dealing Physical Damage, the rune deals Arcane Damage instead.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Craft : Steady Hand","avd12_id":"130_6b","custom":false,"description":"You carve a Rune that has a craft time of 1 minute and instead spend 10 Minutes and double the amount of materials but add a 1d6 Bonus to your Craft Check.","selected":false,"data":"O","cost":2},"option_7":{"name":"Attention to Detail","avd12_id":"130_7","custom":false,"description":"Gain +1 Runecarving, +1 Scribing and +1 Concentration","selected":false,"data":"AC","cost":2},"option_8b":{"name":"Reaction : Command Word","avd12_id":"130_8b","custom":false,"description":"You can activate Runes that require a Command Word with a Reaction.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Expert Runecarver","avd12_id":"130_9","custom":false,"description":"Gain +1 Runecarving and +2 Arcane Mitigation. Your Trigger Rune can activate Journeyman and Expert Scrolls.","selected":false,"data":"AC4=1:ADC=2:TC","cost":3},"option_10a":{"name":"Enchanter","avd12_id":"130_10a","custom":false,"description":"You gain access to the Enchanting Prestige Recipes","selected":false,"data":"TC","cost":3},"option_10b":{"name":"Dermaglyph Artist","avd12_id":"130_10b","custom":false,"description":"You gain access to the Dermaglyph Prestige Recipes","selected":false,"data":"TC","cost":3},"option_11":{"name":"Master Runecarver","avd12_id":"130_11","custom":false,"description":"Gain +2 Runecarving. Your Efficient Powdered Metal skill causes you to create 20 Pinches instead of 14 and your Breaking Runes deal an extra Dice of Damage. Additionally, you can carve your Breaking Rune into a Beginner Catalyst, causing it to deal the Damage Type of the Catalyst instead of Physical.","selected":false,"data":"TC:AC4=2","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9fdb33d5b7c24b23","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Scoundrel","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"232","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Roguish Charm","avd12_id":"232_1","custom":false,"description":"Gain +1 Performance and +1 Thievery","selected":true,"data":"ASE=1:ASA=1","cost":2},"option_2a":{"name":"Action : Cheapshot","avd12_id":"232_2a","custom":false,"description":"Make an Unarmed Attack with a 1d4 Bonus to the Attack and Damage. If the Attack hits, the Creature moves to the bottom of the Iniative order. If this ability is used to initiate Combat or on the first round, the Creature also loses their first Action.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Reaction : Dirty Fighting","avd12_id":"232_2b","custom":false,"description":"In response to an Ally making an Attack on a Creature that is Adjacent to you, make an Attack on that same Creature with a Light Melee Weapon or Unarmed Attack with a 1d4 Bonus Modifier.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Lucky Scoundrel","avd12_id":"232_3","custom":false,"description":"Gain 1 Luck Dice","selected":false,"data":"L1","cost":2},"option_4a":{"name":"Bluffer","avd12_id":"232_4a","custom":false,"description":"Gain +1 Persuasion and +1 Insight","selected":false,"data":"ASC=1:ASD=1","cost":2},"option_4b":{"name":"Hidden Weapon","avd12_id":"232_4b","custom":false,"description":"You can conceal either an Ultra Light Ranged or 1 Handed Light Weapon which can only be discovered by a Search Check of 12 or higher. Your first Attack with this Weapon in Combat gains a +2 Attack Modifier and is an automatic True Hit if it hits.","selected":false,"data":"TO","cost":2},"option_5":{"name":"Action : Knife Trick","avd12_id":"232_5","custom":false,"description":"You throw a Light 1 Handed Melee Weapon at a Target within 3 units and immediately move Adjacent to that Creature without provoking Reactions. If your Attack hits, make an additional Melee Attack with the same Weapon with a -2 Attack Modifier.","selected":false,"data":"T","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"47e56343981d49dc","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Scout","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"272","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"The Way of the Scout","avd12_id":"272_1","custom":false,"description":"Gain +1 Search and +1 Wilderness ","selected":true,"data":"ASG=1:ASB=1","cost":2},"option_2a":{"name":"Silent and Quick","avd12_id":"272_2a","custom":false,"description":"Gain +1 Stealth and +1 Initiative","selected":false,"data":"AS4=1:ASH=1","cost":2},"option_2b":{"name":"Surefooted","avd12_id":"272_2b","custom":false,"description":"Gain +1 Movement Speed. When you make Checks against slipping from terrain or Spell effects, gain a 1d4 Bonus.","selected":false,"data":"AV=1:TD","cost":2},"option_3":{"name":"Nothing Left Unturned","avd12_id":"272_3","custom":false,"description":"Become Good at Search","selected":false,"data":"","cost":2},"option_4a":{"name":"Free Action : Mark","avd12_id":"272_4a","custom":false,"description":"You pick a Target that you are aware of but do not need to have Line of Sight on. Any Bonuses from being Hidden, Having Partial Cover or being Invisible are negated until the Start of your next Turn. The first time this Target takes Damage, add an extra 1d8 of that Damage Type.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Action : Reveal","avd12_id":"272_4b","custom":false,"description":"Make a Search Check that includes an Area around you with an 8 Unit Radius detecting any Hidden, Invisible or Creatures with Cover.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Reaction : Flanking Shot","avd12_id":"272_5","custom":false,"description":"When an Ally is Ajdacent to a Creature and makes an Attack with a Melee Weapon, you can make an Attack with an Ultra-Light or Light Ranged Weapon at that same Target.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"479cc596536442d1","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Scribe","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"131","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Scribe","avd12_id":"131_1","custom":false,"description":"Gain +2 Scribing. You can Scribe Beginner and Novice Spells to Scrolls.","selected":true,"data":"AC3=2:TC","cost":2},"option_2a":{"name":"Mass Production","avd12_id":"131_2a","custom":false,"description":"Gain +1 Initiative. You can use a Piece of Paper instead of Treated Parchment when Researching and Scribing Spells, but you have a -1 Penalty to your Scribe Check.","selected":false,"data":"TC:ASH=1","cost":2},"option_2b":{"name":"Deceiving Penmanship","avd12_id":"131_2b","custom":false,"description":"Gain +1 Thievery. Forgeries that you make are indistinguishable if you possess a reference to the writing you are trying to mimic.","selected":false,"data":"TG:ASA=1","cost":2},"option_3":{"name":"Master of the Quill","avd12_id":"131_3","custom":false,"description":"You Gain +1 Scribing, +1 Runecarving and +1 Academics","selected":false,"data":"AS9=1:AC3=1:AC4=1","cost":2},"option_4a":{"name":"Chronicler","avd12_id":"131_4a","custom":false,"description":"As part of taking a Full Rest, you spend 1 Hour journaling the events of the day that you can reference accurately in the future by consulting the journal. Additionally, you can recall any writing or symbols you have read, even if it is in a Language you do not understand.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Reaction : Field Research","avd12_id":"131_4b","custom":false,"description":"When a Creature Channels a Spell within 10 Units of you that you can See and Hear, you use your Reaction to attempt to jot down a quick note about the Spell. If you Research this Spell in the future, you gain a +2 Bonus to your Scribe Check and use a Powdered Metal of one tier less than the one required.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Researcher","avd12_id":"131_5","custom":false,"description":"Gain +1 Arcanum and +1 Scribing","selected":false,"data":"AC3=2:AS9=1","cost":2},"option_6a":{"name":"Embedded Components","avd12_id":"131_6a","custom":false,"description":"You can Scribe Scrolls that consume Components by adding the Component as an Ingredient in your Recipe.","selected":false,"data":"TC","cost":2},"option_6b":{"name":"Instructions Included","avd12_id":"131_6b","custom":false,"description":"When others use Scrolls you Scribed, the Scrolls have a Spell Attack of 3 and a Spell Damage Bonus Modifier equal to your Scribing Skill at the time of the Check.","selected":false,"data":"TC","cost":2},"option_7":{"name":"Improved Scribing","avd12_id":"131_7","custom":false,"description":"Gain +1 Scribing. You can Scribe Journeyman Spells that you have access.","selected":false,"data":"TC:AC3=1","cost":2},"option_8a":{"name":"Action : Perfect Recital","avd12_id":"131_8a","custom":false,"description":"You Channel a Scroll that requires one Action but use your Scribe Bonus as both the Spell Attack and double your Scribe Bonus as the Spell Damage Bonus Modifier.","selected":false,"data":"XX3","cost":2},"option_8b":{"name":"Ritualistic Scribing","avd12_id":"131_8b","custom":false,"description":"You can Scribe Spells that have a Channel Time of more than 1 minute.","selected":false,"data":"TC","cost":2},"option_9":{"name":"Expert Scribe","avd12_id":"131_9","custom":false,"description":"Gain +1 Scribing. You can Scribe Expert Spells that you have access to and Use Expert Scrolls.","selected":false,"data":"TC:AC3=1","cost":3},"option_10a":{"name":"Taboo Magic","avd12_id":"131_10a","custom":false,"description":"Pick an Exotic Magic type. You can Research and Scribe Spells from that School.","selected":false,"data":"TC","cost":3},"option_10b":{"name":"Collector of Knowledge","avd12_id":"131_10b","custom":false,"description":"You can Research and Scribe Journeyman or lower Spells from any Traditional School of Magic.","selected":false,"data":"TC","cost":3},"option_11":{"name":"Master Scribe","avd12_id":"131_11","custom":false,"description":"Gain +2 Scribing. You can Scribe Master and Grand Master Spells that you have access to and use Master Scrolls. Additionally, when you fail to Scribe Check to Scribe a Spell, you can attempt the Recipe one more time by using another Treated Parchment","selected":false,"data":"AC3=2:TC","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a3eb342442744b64","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Sentinel","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"246","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Guardian of Knowledge","avd12_id":"246_1","custom":false,"description":"Gain +1 Academics and +1 Insight","selected":true,"data":"AS9=1:ASD=1","cost":2},"option_2a":{"name":"Reaction : Interpose","avd12_id":"246_2a","custom":false,"description":"In response to an Enemy Creature Moving within 1 Unit of an Ally, you can move up to 4 Units towards that ally. If you end up within 1 Unit of both the ally and enemy, you can make an Attack Action against that target.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Reaction : Know Thine Enemy","avd12_id":"246_2b","custom":false,"description":"When a Creature Attacks you with a Melee Attack, you can use your Academics Skill in place of a Dodge Check","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Well Learned","avd12_id":"246_3","custom":false,"description":"Become Good at one Knowledge Skill","selected":false,"data":"","cost":2},"option_4a":{"name":"The Art of Defense","avd12_id":"246_4a","custom":false,"description":"Gain +1 Dodge and +1 Block","selected":false,"data":"AD2=1:AD3=1","cost":2},"option_4b":{"name":"Sentinel Stance","avd12_id":"246_4b","custom":false,"description":"Gain the Sentinel Stance and +1 Academics.","selected":false,"data":"H=19:AS9=1","cost":2},"option_5":{"name":"Free Action : Feint","avd12_id":"246_5","custom":false,"description":"You make a quick Attack with a Light 2-Handed Weapon meant to distract, only dealing Primary Damage equal to the Bonus Damage Modifier and causing your Target to have a 1d4 Penalty to their next Defense Check before the start of your next turn. If the next Attack is a True Hit, the Damage is increased by 1d10.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"7628d11240e847ce","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Serpent","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"287","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Essence of the Snake","avd12_id":"287_1","custom":false,"description":"Gain +1 Initiative and +1 Stealth","selected":true,"data":"ASH=1:AS4=1","cost":2},"option_2a":{"name":"Venom Extractor","avd12_id":"287_2a","custom":false,"description":"You gain +1 Resilience. As an action, you you can draw poison from yourself or an adjacent ally, giving them extra mitigation equal to your Resilience bonus modifier against the damage from the poison until it ends.","selected":false,"data":"AS6=1:TG","cost":2},"option_2b":{"name":"Disabling Venom","avd12_id":"287_2b","custom":false,"description":"Gain +1 Alchemy. Poisons that you craft also cause the affected creature to gain Tier 1 Exhaustion.","selected":false,"data":"TC:AC5=1","cost":2},"option_3":{"name":"Serpent Reflexes","avd12_id":"287_3","custom":false,"description":"Gain +1 Dodge","selected":false,"data":"AD2=1","cost":2},"option_4a":{"name":"Reaction : Evade","avd12_id":"287_4a","custom":false,"description":"In response to making a defense check, make an Initiative Check as well and use the higher of the two values","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Strike","avd12_id":"287_4b","custom":false,"description":"You make a quick attack at a creature with a melee weapon with a 1d4 penalty. If the creature is poisoned, the attack has a 1d4 bonus instead.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Action : Coiled Lunge","avd12_id":"287_5","custom":false,"description":"You leap towards a creature within 2 units, making an attack with a melee weapon and adding your initiative bonus to the attack. If your attack misses, you return to your original position, otherwise you remain adjacent to the creature.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"6e8c47d063e6410e","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Shadow","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"255","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Action [Daily] : Shadowspawn","avd12_id":"255_1","custom":false,"description":"You detach your shadow in an unoccupied area adjacent to you. It becomes a dark creature with health equal to double your level while sharing the same mitigations and movement speed as you. You can use a subsequent action to recall or deploy your shadow unless it reaches 0 health. The shadow acts on your Initiative and has one Action which it can only use to either Move or Attack with a Melee Weapon you have equipped. The shadow is immune to all conditions and has a size equal to your own.","selected":true,"data":"XD1","cost":2},"option_2a":{"name":"Reaction : Swap","avd12_id":"255_2a","custom":false,"description":"In response to either you or your Shadow being the target of an Attack, swap places causing the attack to be redirected. If your new position places you adjacent to a creature, you can make a Melee Attack against it.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Free Action : Shadow Strike","avd12_id":"255_2b","custom":false,"description":"Your Shadow teleports up to 2 Units and uses the Attack action.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Shadow Aura","avd12_id":"255_3","custom":false,"description":"Both yours and your Shadow's Melee Attacks deal 2d4 bonus psychic damage on a True Hit. This bonus is increased to 2d8 at level 7 and 2d12 at level 11.","selected":false,"data":"TG","cost":2},"option_4a":{"name":"Inner Darkness","avd12_id":"255_4a","custom":false,"description":"You gain +1 Stealth and +3 Dark Mitigation. Additionally, your Shadow becomes Immune to Dark Damage.","selected":false,"data":"AS4:AD7=3","cost":2},"option_4b":{"name":"Dissipating Veil","avd12_id":"255_4b","custom":false,"description":"After one round of not taking an action, your Shadow becomes Invisible until it makes an Attack.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Synchronous Shadow","avd12_id":"255_5","custom":false,"description":"Your Shadow gains another Action which can only be used to take the Use or Move action. Additionally, when it takes the Attack Action, it can use one of your Unique Actions as if you were using it.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"61e9b004c573475e","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Shaman","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"240","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Witchdoctor","avd12_id":"240_1","custom":false,"description":"Gain +1 Alchemy and +1 Medicine","selected":true,"data":"AC5=1:AS8=1","cost":2},"option_2a":{"name":"Mystic","avd12_id":"240_2a","custom":false,"description":"Learn 2 Druidic and 2 Divine Beginner Spells","selected":false,"data":"","cost":2},"option_2b":{"name":"Spirit Companion","avd12_id":"240_2b","custom":false,"description":"You convert a Beast tamed by you to a Spirit Companion during a 12 Hour Ritual removing any need to Eat, Breath or Sleep. When this Spirit Companion reaches 0 Health, it vanishes into the Ethereal Realm and must be summoned again using this same Ritual.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Elementalist","avd12_id":"240_3","custom":false,"description":"Gain +1 Elemental Mitigation and Learn 2 Novice Druidic Spells","selected":false,"data":"ADA=1","cost":2},"option_4a":{"name":"Careful Healing","avd12_id":"240_4a","custom":false,"description":"When you can administer one Potion or Spell that restores Health to an Ally while taking a Breather, increasing the effectiveness by adding one Dice to the total amount Healed.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Action [Daily] : Trance","avd12_id":"240_4b","custom":false,"description":"Once per day, you take a Breather where you place yourself into a Trance. While in this Trance you are considered Unconscious for the duration and regain Health and Power equal to your Level when it completes.","selected":false,"data":"XD1","cost":2},"option_5":{"name":"Action : Dream Totem","avd12_id":"240_5","custom":false,"description":"You place down a totem on the ground which grants all Allies within 8 Units +1 Resistance and Psychic Mitigation equal to your Level while they are within the Area. Additionally, while an Ally is within the protection of the Totem, they cannot be put to sleep by magic or suffer the effects of Spells that cause nightmares or dreams.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e64b6c92dd044853","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Shield Magus","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"282","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Adaptive Shield","avd12_id":"282_1","custom":false,"description":"When using a shield as your Conduit, your shield offers adaptive mitigation against a single damage type equal to your spell damage bonus modifier. In response to taking arcane, dark, divine or elemental damage, you can elect to spend 1 power to change your adaptive mitigation to that type for the next minute.","selected":true,"data":"TD","cost":2},"option_2a":{"name":"Free Action : Shield Charge","avd12_id":"282_2a","custom":false,"description":"Immediately after Channeling a Spell and while you have an active adaptive mitigation, the Spell becomes Charged but you lose the adaptive Mitigation.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Reaction : Retaliatory Spell","avd12_id":"282_2b","custom":false,"description":"In response to being attacked by a Melee Attack by an Adjacent Creature, retaliate with a Touch Spell against the attacking Creature using your Block Check against the attack as the Spell Attack.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Magus","avd12_id":"282_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Improved Adaptive Shield","avd12_id":"282_4a","custom":false,"description":"Gain +1 Spell Damage. Additionally, your Adaptive Shield trait no longer requires power and does not expire.","selected":false,"data":"AZ4=1:TG","cost":2},"option_4b":{"name":"Action : Spellburst","avd12_id":"282_4b","custom":false,"description":"While using your shield as a Conduit, you channel a Ray Spell that takes 1 Action but it is converted to a 1 Unit wide Line Spell instead.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Arcane Aegis","avd12_id":"282_5","custom":false,"description":"Gain +1 Block while wielding a Shield, +2 Arcane Mitigation and +1 Elemental Mitigation.","selected":false,"data":"W5D3=1:ADC=2:ADA=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"b8bfda8ed993411c","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Skirmisher","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"259","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Always Ready","avd12_id":"259_1","custom":false,"description":"Gain +1 Initiative and +1 Athletics","selected":true,"data":"ASH=1:AS1=1","cost":2},"option_2a":{"name":"Free Action : Double Toss","avd12_id":"259_2a","custom":false,"description":"When you throw a Weapon with an Attack, you can throw an additional Weapon as part of that Action.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Action : Quick Fire","avd12_id":"259_2b","custom":false,"description":"If you are behind Partial or Full Cover, you can move 2 Units and use the Attack Action or Channel Action and return to your original position.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Action : Disengage","avd12_id":"259_3","custom":false,"description":"You Move up to your full Movement Speed but do not provoke Reactions.","selected":false,"data":"AD2=1","cost":2},"option_4a":{"name":"Nimble Engager","avd12_id":"259_4a","custom":false,"description":"Gain +1 Movement Speed and +1 Acrobatics","selected":false,"data":"AV=1:AS3=1","cost":2},"option_4b":{"name":"Avoidance","avd12_id":"259_4b","custom":false,"description":"Gain +1 Dodge","selected":false,"data":"AD2=1","cost":2},"option_5":{"name":"Reaction : Covered Retreat","avd12_id":"259_5","custom":false,"description":"When a hostile Creature moves within 2 Units of you, you can use your Reaction to Move up to 4 Units and make an Attack with a Ranged or a Throwing Weapon","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"797614a593184d66","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Slasher","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"109","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Slasher","avd12_id":"109_1","custom":false,"description":"Gain +1 Attack and +1 Damage with Slashing Weapons. Gain a Fighting Stance.","selected":true,"data":"AZ6=1:AZA=1","cost":2},"option_2a":{"name":"Reaction : Flank","avd12_id":"109_2a","custom":false,"description":"When an Allied Creature makes a Melee Attack against a target within your Melee Range, you can make an Attack against that same target with a 1d4 Bonus.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Increased Damage","avd12_id":"109_2b","custom":false,"description":"Gain +1 Damage with Slashing Weapons","selected":false,"data":"AZA=1","cost":2},"option_3":{"name":"Novice Slasher","avd12_id":"109_3","custom":false,"description":"Gain +1 Attack with Slashing Weapons and Learn a Fighting Stance from the Stance Table","selected":false,"data":"H=Z:AZ6=1","cost":2},"option_4a":{"name":"Action : Sweeping Slash","avd12_id":"109_4a","custom":false,"description":"Make a normal Attack with a Slashing Weapon against 2 Creatures within your Melee Range.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Reaction : Riposte","avd12_id":"109_4b","custom":false,"description":"When you Dodge or Block an Attack, you can make an Attack against that Creature if they are within Melee Range of you","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Journeyman Slasher","avd12_id":"109_5","custom":false,"description":"Gain +1 Attack with Slashing Weapons and gain access to the Attack of Opportunity Reaction","selected":false,"data":"AZ6=1:AZT=0","cost":2},"option_6a":{"name":"Powerful Blows","avd12_id":"109_6a","custom":false,"description":"Gain +1 Damage with Slashing Weapons, Piercing and Crushing Weapons and +1 Damage with Unarmed Strikes","selected":false,"data":"AZ6=1:AZ7=1:AZ8=1:AZN=1","cost":2},"option_6b":{"name":"Free Action : Quick Attack","avd12_id":"109_6b","custom":false,"description":"If you have not used an Attack Action or Special Action on this turn, you can make a fast Attack with a Light Slashing Weapon","selected":false,"data":"Y","cost":2},"option_7":{"name":"Expert Slasher","avd12_id":"109_7","custom":false,"description":"Gain Critical Hits and +1 Attack with Slashing Weapons","selected":false,"data":"AZE:AZ6=1","cost":3},"option_8a":{"name":"Parrying Blade","avd12_id":"109_8a","custom":false,"description":"Gain +1 Block","selected":false,"data":"AD3=1","cost":2},"option_8b":{"name":"Free Action : Glory Kill","avd12_id":"109_8b","custom":false,"description":"Gain an extra action when your Slashing Weapon brings a Creature to 0 Health","selected":false,"data":"Y","cost":2},"option_9":{"name":"Master Slasher","avd12_id":"109_9","custom":false,"description":"Gain Brutal Critical Hits with Slashing Weapons and Gain +1 Attack and Damage with Slashing Weapons","selected":false,"data":"AZJ:AZ6=1:AZA=1","cost":4},"option_10a":{"name":"Free Action : Amputation","avd12_id":"109_10a","custom":false,"description":"When you score a Brutal Critical Hit, you can target a Leg or Arm with a Called Shot before rolling your Damage.","selected":false,"data":"Y","cost":3},"option_10b":{"name":"Action : Powerslash","avd12_id":"109_10b","custom":false,"description":"You move up to 2 Units and then make a Melee Attack with a Slashing Weapon, increasing your True Hit threshold by 1. If your Attack is a True Hit, all Physical Damage from the Attack becomes True Damage.","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Grandmaster Slasher","avd12_id":"109_11","custom":false,"description":"Your Damage Die for Slashing Weapons are upgraded (1-Handed Light: 2d6, 1-Handed Heavy: 2d8, 2-Handed Light: 3d6, 2-Handed Heavy: 3d8)","selected":false,"data":"AZW","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a02774c9f46d4d13","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Slinger","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"236","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Slinger","avd12_id":"236_1","custom":false,"description":"Gain the Dual Wielding Stance which allows you to equip an Ultra Light Ranged weapon in your Offhand. Once per turn, you can make an Attack with your Offhand that does not consume an Action and does not apply your Damage Bonus Modifier.","selected":true,"data":"H=20","cost":2},"option_2a":{"name":"Free Action : Double Reload","avd12_id":"236_2a","custom":false,"description":"Reload up to 2 Equipped Ultra Light Ranged Weapons that have an Ammunition Capacity.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Reaction : Cover Dive","avd12_id":"236_2b","custom":false,"description":"When Targeted by a Melee Attack or Projectile, dive 2 Units without provoking Reactions and fall Prone while making an Attack with an Ultra Light Ranged Weapon with a 1d4 Penalty to hit. Gain a +2 Bonus to your Defense Checks against the Attack as well as any Bonuses for Cover in your new position.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Desperado","avd12_id":"236_3","custom":false,"description":"Gain +2 Units of Maximum Range on Ultra Light Ranged Weapons. Additionally, apply your Damage Bonus Modifier to Attacks you make with your Offhand Ultra Light Ranged Weapon.","selected":false,"data":"TO:O1=2","cost":2},"option_4a":{"name":"Action : Point Blank Overload","avd12_id":"236_4a","custom":false,"description":"You make an Attack with an Ultra Light Ranged Weapon at a Creature that is Adjacent to you, dealing an extra 1d6 Damage. If hit, a Large or smaller Creature must make an Athletics or Acrobatics Check against the total Damage dealt after Mitigations, or be Shoved 1 Unit backwards and fall Prone.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Cover Shot","avd12_id":"236_4b","custom":false,"description":"Make an Attack with your Offhand Ultra Light Ranged Weapon with a 1d6 Penalty and Move a number of Units equal to the result of the d6. When you reach your new Location, you can make an Attack with your Primary Weapon if eligble.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Master Slinger","avd12_id":"236_5","custom":false,"description":"Gain +1 Attack and +1 Damage with Ranged Weapons","selected":false,"data":"AZ5=1:AZ9=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8ebb7ba9463e4fe4","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Smith","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"129","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Smith","avd12_id":"129_1","custom":false,"description":"Gain +2 Smithing","selected":true,"data":"AC1=2","cost":2},"option_2a":{"name":"Hard Labor","avd12_id":"129_2a","custom":false,"description":"Gain +1 Strength and +2 Health","selected":false,"data":"AS2=1:AH=2","cost":2},"option_2b":{"name":"Smithing Hammer","avd12_id":"129_2b","custom":false,"description":"Gain +1 Damage with Crushing Weapons","selected":false,"data":"AZB=1","cost":2},"option_3":{"name":"Reaction : Brace","avd12_id":"129_3","custom":false,"description":"If you are hit with a Melee Attack, you can temporarily increase your Physical Mitigation by your Smithing Skill until the start of your next turn. Also add your Smithing Skill to any Checks that involve Displacing you or knocking you Prone.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Improved Weapons","avd12_id":"129_4a","custom":false,"description":"Weapons you Craft gain a +1 Damage Bonus","selected":false,"data":"TC","cost":2},"option_4b":{"name":"Improved Armor","avd12_id":"129_4b","custom":false,"description":"Chest Armor you Craft gains +1 Physical Mitigation","selected":false,"data":"TC","cost":2},"option_5":{"name":"Metalworker","avd12_id":"129_5","custom":false,"description":"Gain +1 Smithing, +1 Engineering and add an extra Infusion on Chest Armor and Weapons you Craft","selected":false,"data":"AC1=1:TC","cost":2},"option_6a":{"name":"Craft : Smelt","avd12_id":"129_6a","custom":false,"description":"You can destroy a Weapon or Armor that has a Smithing Recipe in a Forge yielding the Metal Ingots listed in the base Ingredients.","selected":false,"data":"O","cost":2},"option_6b":{"name":"Efficient Metallurgy","avd12_id":"129_6b","custom":false,"description":"When you fail to Craft an Object with Smithing, you do not lose any of the Ingots associated with the Recipe.","selected":false,"data":"TC","cost":2},"option_7":{"name":"Advanced Smithing","avd12_id":"129_7","custom":false,"description":"Gain +1 Smithing and access to Smithing Augmentations","selected":false,"data":"AC1=1:TC","cost":2},"option_8a":{"name":"Craft : Precision Forging","avd12_id":"129_8a","custom":false,"description":"You add an additional 1d4 Bonus to a Smithing Check but the Object can no longer benefit from Overcrafting. This can be used multiple times per Object.","selected":false,"data":"TC","cost":2},"option_8b":{"name":"Craft : Limit Testing","avd12_id":"129_8b","custom":false,"description":"Once per Object, you can use a Superior Infusion, doubling the required materials and bonuses for either a Reinforced or Insulating Infusion but not increasing the maximum Required Check to successfully complete it.","selected":false,"data":"TC","cost":2},"option_9":{"name":"Perfectly Balanced","avd12_id":"129_9","custom":false,"description":"Melee Weapons you Craft gain a +1 Attack Bonus and Chest Armor gains +1 Elemental Mitigation.","selected":false,"data":"TC","cost":3},"option_10a":{"name":"Free Action : Sunder","avd12_id":"129_10a","custom":false,"description":"When you hit a Creature with a Melee Weapon they become vulnerable. The next time the Targeted Creature takes Physical Damage, make a Smithing Check and apply that Damage to the total.","selected":false,"data":"Y","cost":3},"option_10b":{"name":"Forged in Fire","avd12_id":"129_10b","custom":false,"description":"Gain +1 Athletics, +1 Resilience and +4 Fire Mitigation","selected":false,"data":"AS6=1:AS1=1:AD6=4","cost":3},"option_11":{"name":"Master Smith","avd12_id":"129_11","custom":false,"description":"Gain +2 Smithing. Gloves and Boots Crafted by you gain +1 Elemental and +1 Physical Mitigation. Helmets Crafted by you grant Immunity to the Dazed Condition.","selected":false,"data":"TC:AC2=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"621f254b6e684abc","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Sniper","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"234","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Distance Shooter","avd12_id":"234_1","custom":false,"description":"Gain [Heavy +8 / Light +4 / Ultra Light +2] Unit Maximum Range","selected":true,"data":"O3=8:O2=4:O1=2","cost":2},"option_2a":{"name":"Action : Snipe","avd12_id":"234_2a","custom":false,"description":"While you are Hidden from a Target, make an Attack with a Ranged Weapon. If the Attack hits, make a Contested Stealth Check against an Initiative Check of the Target. On a success, the Ranged Weapon Dice are doubled. On a success of 10 or more, the Ranged Weapon Dice are tripled.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Action : Trick Shot","avd12_id":"234_2b","custom":false,"description":"You use 2 Ammunition and shoot them at different Targets that are within 4 Units of each other. Both Projectiles avoid any Partial Cover.","selected":false,"data":"XX3","cost":2},"option_3":{"name":"Accurate Shot","avd12_id":"234_3","custom":false,"description":"Gain +1 Attack with Ranged Weapons","selected":false,"data":"AZ5=1","cost":2},"option_4a":{"name":"Veiled Shot","avd12_id":"234_4a","custom":false,"description":"Gain +1 Stealth and +1 Damage to Ranged Weapons","selected":false,"data":"AZ5=1:AS4=1","cost":2},"option_4b":{"name":"Lying in Wait","avd12_id":"234_4b","custom":false,"description":"Gain +2 Attack with and an extra 1d6 Damage with Ranged Weapons while Prone","selected":false,"data":"TO","cost":2},"option_5":{"name":"Longshot","avd12_id":"234_5","custom":false,"description":"Gain +1 Damage to Ranged Weapons and Additional [Heavy +5 / Light +3 / Ultra Light +1] Range","selected":false,"data":"AZ9=1:O3=5:O2=3:O1=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8c24857134ee42f5","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Spectral Weapon","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"260","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Spectral Weapon","avd12_id":"260_1","custom":false,"description":"You designate a Light 1 or 2 Handed Melee Weapon as your Spectral Weapon with a 1 Hour Ritual. This weapon can be summoned and dismissed as a Free Action. If you throw this weapon, it appears in your hand after hitting or missing your target.","selected":true,"data":"TG","cost":2},"option_2a":{"name":"Spectral Shield","avd12_id":"260_2a","custom":false,"description":"Gain +4 Psychic Mitgation","selected":false,"data":"AD9=4","cost":2},"option_2b":{"name":"Spectral Twin","avd12_id":"260_2b","custom":false,"description":"You can designate a second Weapon as a Spectral Weapon which behaves in the same manner. With a Free Action, you can summon one or both Spectral Weapon.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Ethereal Weapons","avd12_id":"260_3","custom":false,"description":"Your Spectral Weapons deal an extra 1d4 Psychic Damage. This dice increases to 1d8 at level 7, and 2d6 at level 10","selected":false,"data":"TO","cost":2},"option_4a":{"name":"Reaction : Spectral Parry","avd12_id":"260_4a","custom":false,"description":"When you are Attacked by a Melee Weapon, you can summon a brief duplicate of your Spectral Weapon to attempt to Parry the Attack. Roll a 1d6 and add that to your Block Modifier.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Action : Psychic Onslaught","avd12_id":"260_4b","custom":false,"description":"Until the end of your next turn, the Primary Damage of your Spectral Weapons are convereted to Psychic Damage.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Action : Phantom Rush","avd12_id":"260_5","custom":false,"description":"Your Spectral Weapon appears Adjacent to a Target within 6 Units. If your Attack hits, you dash to your weapon if nothing is obstructing your path. Otherwise, you remain in your current position.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"b17ded1bf9fb42c7","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Spell Thief","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"237","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Spell Thief","avd12_id":"237_1","custom":false,"description":"You gain +2 Flexible Spell Slots which you fill with any Beginner or Novice Level Spells from any Traditional School of Magic. When an Ally Channels a Spell with you as the Target, you can replace one of these Spells with the new Spell. You can slot Journeyman Spells at Level 9 and Expert at 11.","selected":true,"data":"","cost":2},"option_2a":{"name":"Increased Capacity","avd12_id":"237_2a","custom":false,"description":"Gain +1 Flexible Spell Slot and +1 Arcanum","selected":false,"data":"","cost":2},"option_2b":{"name":"Potent Spells","avd12_id":"237_2b","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_3":{"name":"Reaction : Spell Steal","avd12_id":"237_3","custom":false,"description":"In response to a Spell being Channeled within 8 Units, you make an Arcanum Check against the Spell Attack. On a success and if you are capable of Learning the Spell, you replace one of your Flexible Spell Slots with this one.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Craft : Stolen Research","avd12_id":"237_4a","custom":false,"description":"You can use the Research Recipe to permanently Learn a Spell within your Flexible Spell Slots if it is a Traditional School of Magic.","selected":false,"data":"TG","cost":2},"option_4b":{"name":"Spell Heist","avd12_id":"237_4b","custom":false,"description":"When a Creature Botches their Spell Attack on your Spell Steal ability, the Spell fails and they cannot use that Spell again for 1 Hour.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Action : Channel Flexible Spell","avd12_id":"237_5","custom":false,"description":"You Channel a Spell from one of your Flexible Spell Slots which is automatically Charged and has a +2 Bonus to its Spell Attack.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"146ba76ee75e4df8","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Spellshot","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"242","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Spellshot","avd12_id":"242_1","custom":false,"description":"When your Ranged Weapon is a Conduit, your Ray and Projectile spells that target a single Creature use your Ranged Attack modifier instead of your Spell Attack Modifier. Additionally, the Range of these spells is set to your Maximum Range for your Ranged Conduit.","selected":true,"data":"TV","cost":2},"option_2a":{"name":"Arcane Power","avd12_id":"242_2a","custom":false,"description":"Gain +1 Spell Damage and +1 Arcanum","selected":false,"data":"AZ4=1:AS7=1","cost":2},"option_2b":{"name":"Pure Shot","avd12_id":"242_2b","custom":false,"description":"Gain +1 Damage with Ranged Weapons and +1 Maximum Range on all Ranged Weapons","selected":false,"data":"AZ9=1:O1=1:O2=1:O3=1","cost":2},"option_3":{"name":"Action : Arcane Blast","avd12_id":"242_3","custom":false,"description":"You target a point within 10 Units that you can see and make a Ranged Attack with your Spellshot Focus. All Creatures within a 2 Unit Radius of that point must make a Resistance Check against your Attack Roll or take 1d6 + your combined Ranged Damage and Spell Damage Bonus Modifier. The combined Damage Bonus is doubled on a True Hit.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Action : Heat Seaker","avd12_id":"242_4a","custom":false,"description":"You make a Ranged Attack that is not affected by Cover at a Target you have seen in the past minute. The Targets Dodge Modifier cannot be used to attempt to avoid this Attack.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Action : Arcane Delivery","avd12_id":"242_4b","custom":false,"description":"You Cast a Utility Spell that has a Channeling Time of 1 Action, but the Range becomes equal to that of your Spellshot Conduit. This Spell can only Target an Allied Creature.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Free Action : Ammo Infusion","avd12_id":"242_5","custom":false,"description":"When you successfully Channel a Projectile or Ray Spell through your Ranged Conduit, the Physical Damage from all other Ranged Attacks on this turn becomes the same Damage Type as the initial Spell.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"be5bdfa12e7744c1","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Spellslinger","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"217","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Acceleration Magic","avd12_id":"217_1","custom":false,"description":"Gain +1 Arcanum and +1 Spell Damage","selected":true,"data":"AS7=1:AZ4=1","cost":2},"option_2a":{"name":"Reaction : Spell of Opportunity","avd12_id":"217_2a","custom":false,"description":"In response to a Hostile Creature leaving your Area of Control, you Channel a 1 Action Touch Spell against the Target.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Free Action : Mobile Casting","avd12_id":"217_2b","custom":false,"description":"After using the Channel Action to complete a Spell, you move 2 Units as part of that Action.","selected":false,"data":"Y","cost":2},"option_3":{"name":"Improved Spells","avd12_id":"217_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Amplified Force","avd12_id":"217_4a","custom":false,"description":"Your Ray and Projectile Spells deal unavoidable Splash Damage to Creatures that are Adjacent to your initial Target","selected":false,"data":"TO","cost":2},"option_4b":{"name":"Empowered Conduit","avd12_id":"217_4b","custom":false,"description":"Gain +6 Power and +6 Power Regeneration","selected":false,"data":"FP=6:FR=6","cost":2},"option_5":{"name":"Action : High Velocity Magic","avd12_id":"217_5","custom":false,"description":"You Channel a Ray or Projectile Spell that takes 1 Action and gain a 1d4 Bonus to the Spell Attack Check. Additionally, the Range of the Spell is doubled and is not affected by Cover.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"94358b7a68184626","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Spellstriker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"239","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Focused Evoker","avd12_id":"239_1","custom":false,"description":"Gain +1 Concentration and learn 2 Beginner and 1 Novice Evocation Spell.","selected":true,"data":"AS6=1","cost":2},"option_2a":{"name":"Spellbound Weapon","avd12_id":"239_2a","custom":false,"description":"If your Conduit is a Melee Weapon, it's attack becomes equal to your Spell Attack and it's Damage becomes equal to your Spell Damage Bonus Modifier.","selected":false,"data":"TS","cost":2},"option_2b":{"name":"Magical Defenses","avd12_id":"239_2b","custom":false,"description":"Gain +1 Elemental Mitigation and +1 Arcanum","selected":false,"data":"ADA=1:AS7=1","cost":2},"option_3":{"name":"Spell and Blade","avd12_id":"239_3","custom":false,"description":"Gain +1 Spell Damage and learn a Fighting Stance from the Stance Table","selected":false,"data":"AZ4=1","cost":2},"option_4a":{"name":"Reaction : Transference","avd12_id":"239_4a","custom":false,"description":"In Response to taking Arcane, Psychic or Elemental Damage, roll a Spell Attack and reduce the Damage by that amount. Until the end of your next turn, your Weapon deals extra Primary Damage equal to the amount reduced.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Elemental Weapon","avd12_id":"239_4b","custom":false,"description":"You Channel a Beginner Evocation Spell at a weapon you have Equipped causing it to take on the Element of the Spell. For the next minute, the Sword deals Damage of that Element instead of its Primary Damage.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Action : Arcane Assault","avd12_id":"239_5","custom":false,"description":"You make an Attack with your Spellbound Weapon with a 1d4 Attack Bonus. If your Attack hits, all of the Damage is converted to Arcane and the next Spell you Channel before the end of your turn is automatically Charged.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3d3d936dd727415a","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Staffmaster","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"265","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Stick Fighter","avd12_id":"265_1","custom":false,"description":"Gain +1 Damage with Crushing Weapons and +1 Athletics","selected":true,"data":"AZB=1:AS1=1","cost":2},"option_2a":{"name":"Action : Vault","avd12_id":"265_2a","custom":false,"description":"If you have used the Move Action on your turn, you can make vaulting Attack against a Creature within 3 Units that has a +2 Attack Bonus while you have a 2-Handed Weapon equipped.","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Reaction : Deflect Blow","avd12_id":"265_2b","custom":false,"description":"When a Melee Attack is made against you, you can make a Weapon Attack instead of a Block or Dodge Check. If successful, you can redirect the Attack to another Creature that is within reach of the Attacker. This Attack has a -2 Modifier to hit the new target.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Staff Master","avd12_id":"265_3","custom":false,"description":"Gain +1 Attack with Crushing Weapons","selected":false,"data":"AZ7=1","cost":2},"option_4a":{"name":"Leveraged Defense","avd12_id":"265_4a","custom":false,"description":"Gain +1 Block and +1 Dodge","selected":false,"data":"AD2=1:AD3=1","cost":2},"option_4b":{"name":"Longstriker","avd12_id":"265_4b","custom":false,"description":"Gain +1 Unit Range on 2 Handed Weapons","selected":false,"data":"AZQ=1","cost":2},"option_5":{"name":"Action : Guard","avd12_id":"265_5","custom":false,"description":"You take an improved version of the Defense Action, gaining an additional +1 Bonus to your Defense Checks and allowing you to make a Melee Attack against any Creature that enters or leaves your Melee Attack Range without consuming a Reaction.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e58535ae66f74adc","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Stout-Folk","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"16","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Bounty of the Land","avd12_id":"16_1","custom":false,"description":"The Stout-Folk are a culture that works the soil, from farmers to miners. Gain +1 Wilderness, +1 Smithing and +1 Cooking.","selected":true,"data":"ASB=1:AC2=1:AC1=1:ALU","cost":2},"option_2a":{"name":"Action : Throwing Arm","avd12_id":"16_2a","custom":false,"description":"You make a Throwing Attack with a +2 Bonus to Attack and double the Range you can normally throw that object or weapon. Additionally, a True Hit on this Attack is upgraded to a Critical Hit","selected":false,"data":"XX3","cost":2},"option_2b":{"name":"Tavern Legends","avd12_id":"16_2b","custom":false,"description":"The Stout-Folk culture is renowned for their prowess in the tavern. Gain +1 Resilience. When you complete a Favorable Full Rest after a day where you have consumed alcohol, gain a Luck Dice.","selected":false,"data":"TG:AS6=1","cost":2},"option_3":{"name":"Truefooted","avd12_id":"16_3","custom":false,"description":"The Stout-Folk culture does not place much stock in footwear and have grown comfortable barefoot, growing protective calluses. Gain +1 Acrobatics, +1 Stealth and +1 Physical Mitigation.","selected":false,"data":"AS3=1:AS4=1:AD4=1","cost":2},"option_4a":{"name":"Heavy Metal","avd12_id":"16_4a","custom":false,"description":"The Stout-Folk are renowned for their complex metalwork, resulting in impressive hammers and plate armor. Gain an Infusion Slot when crafting Bludgeoning Weapons and Heavy Armor. Additionally, gain +1 Damage with Bludgeoning Weapons.","selected":false,"data":"TC:AZB=1","cost":2},"option_4b":{"name":"Action : Giantsbane","avd12_id":"16_4b","custom":false,"description":"You make an Attack with a Weapon against a Creature one or more sizes larger than you and deal an extra 1d10 Primary Damage for each Size difference.","selected":false,"data":"XX3","cost":2},"option_5":{"name":"Legacy of Armor","avd12_id":"16_5","custom":false,"description":"The Stout-Folk are renowned for utilizing heavier armors for protection. Gain +1 Block, Resistance and Dodge while wearing Medium or Heavy Armor.","selected":false,"data":"W2D2=1:W2D3=1:W2D1=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8e0a7e98bf204a70","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Striker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"133","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Striker","avd12_id":"133_1","custom":false,"description":"Gain +1 Attack and +1 Damage with Unarmed Strikes. Gain a Fighting Stance.","selected":true,"data":"AZM=1:AZN=1","cost":2},"option_2a":{"name":"Reaction : Flank","avd12_id":"133_2a","custom":false,"description":"When an Allied Creature makes a Melee Attack against a target within your Melee Range, you can make an Attack against that same target with a 1d4 Bonus.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Increased Damage","avd12_id":"133_2b","custom":false,"description":"Gain +1 Damage with Unarmed Strikes","selected":false,"data":"AZN=1","cost":2},"option_3":{"name":"Novice Striker","avd12_id":"133_3","custom":false,"description":"Gain +1 Attack with Unarmed Strikes and Learn a Fighting Stance from the Stance Table","selected":false,"data":"AZM=1:H=Z","cost":2},"option_4a":{"name":"Calloused Hands","avd12_id":"133_4a","custom":false,"description":"Gain +1 Physical Mitigation","selected":false,"data":"AD4=1","cost":2},"option_4b":{"name":"Bending Form","avd12_id":"133_4b","custom":false,"description":"You can change your Stance at the start of each turn without a cost.","selected":false,"data":"TG","cost":2},"option_5":{"name":"Journeyman Striker","avd12_id":"133_5","custom":false,"description":"Gain +1 Attack with Unarmed Strikes and gain access to the Attack of Opportunity Reaction","selected":false,"data":"AZW=0:AZM=1","cost":2},"option_6a":{"name":"Action : Uppercut","avd12_id":"133_6a","custom":false,"description":"You make a strong Unarmed Strike against a Creature, putting your full force into the blow and adding your Strength Bonus Modifier to the Damage. On a True Hit, the Strength Bonus is doubled.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Reaction : Counter","avd12_id":"133_6b","custom":false,"description":"In response to being the Target of a Melee Attack, use your Athletics Skill in place of your Defense Check. If the Attack misses, the Creature must make an Athletics or Acrobatics Check against your Defense Check, or fall Prone.","selected":false,"data":"ZX2","cost":2},"option_7":{"name":"Expert Striker","avd12_id":"133_7","custom":false,"description":"Gain Critical Hits and +1 Attack with Unarmed Attacks","selected":false,"data":"AZD:AZM=1","cost":3},"option_8a":{"name":"Flawless Form","avd12_id":"133_8a","custom":false,"description":"You gain the Flawless Defense Stance","selected":false,"data":"H=22","cost":2},"option_8b":{"name":"Flowing Strikes","avd12_id":"133_8b","custom":false,"description":"You gain the Flowing Strikes Stance","selected":false,"data":"H=18","cost":2},"option_9":{"name":"Master Striker","avd12_id":"133_9","custom":false,"description":"Gain Brutal Critical Hits with Unarmed Strikes and Gain +1 Attack with Unarmed Strikes","selected":false,"data":"AZO:AZM=1","cost":4},"option_10a":{"name":"Advantageous Blows","avd12_id":"133_10a","custom":false,"description":"Unarmed Strikes against Creatures that are Dazed or Stunned are automatically upgraded to Brutal Criticals","selected":false,"data":"TO","cost":3},"option_10b":{"name":"Action : Fatal Force","avd12_id":"133_10b","custom":false,"description":"Roll a 1d4 and make a number of Unarmed Strikes against a Target equal to the result","selected":false,"data":"XX3","cost":3},"option_11":{"name":"Grandmaster Striker","avd12_id":"133_11","custom":false,"description":"Your Damage Die for Unarmed Strikes are upgraded to 2d6.","selected":false,"data":"AZP","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"eee6014284df43b4","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Summoner","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"281","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Summoner","avd12_id":"281_1","custom":false,"description":"Gain the Summoner Familiar","selected":true,"data":"","cost":2},"option_2a":{"name":"Free Action : Greater Summoning","avd12_id":"281_2a","custom":false,"description":"Instead of using a quartz worth 5gp and an action, you can utilize a beginner catalyst gem to summon the corresponding elemental. When summoned this way, the elemental gains Temporary Health equal to your level. This ability can also be used to summon a higher level elemental using the Master Summoner trait with the appropriate catalyst.","selected":false,"data":"Y","cost":2},"option_2b":{"name":"Elemental Weapon","avd12_id":"281_2b","custom":false,"description":"You spend 1 minute and designate a weapon as your elemental weapon. When you have an active summon, the weapon's primary damage is converted to the damage type of the corresponding elemental and gains the magical property. You can only have one elemental weapon at a time.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Elemental Magic","avd12_id":"281_3","custom":false,"description":"Gain +1 Arcanum and +1 Spell Damage","selected":false,"data":"AZ4=1:AS7=1","cost":2},"option_4a":{"name":"Reaction : Divert Elements","avd12_id":"281_4a","custom":false,"description":"In response to taking elemental, arcane or physical damage when you have an active summon, you add their mitigation to yours when calculating damage.","selected":false,"data":"ZX2","cost":2},"option_4b":{"name":"Free Action : Focused Elements","avd12_id":"281_4b","custom":false,"description":"When you have an active elemental and channel an evocation spell of the subschool of your elemental, it becomes charged, has it's true hit threshold increased and can critically hit.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Master Summoner","avd12_id":"281_5","custom":false,"description":"Your summoning skills allow you to use an action to transform your familiar into an elementaling by using a 50gp gem or catalyst or an Elemental by using a 300gp gem or catalyst. This can only be used to summon an elemental that is lower than your level.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"731c56fe4c7c4f5d","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Thespian","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"218","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Penchant for Dramatics","avd12_id":"218_1","custom":false,"description":"Gain +1 Performance. You can use your Performance Modifier in situations where a Persuasion Check would be called for to persuade, deceive or intimidate.","selected":true,"data":"ASE=1","cost":2},"option_2a":{"name":"Reaction : Feign Death","avd12_id":"218_2a","custom":false,"description":"In response to a Creature making an Attack against you, make a Performance Check to pretend that you have died. Any Creature with a Persistent Insight Check higher than your Performance Checks can tell that you are feigning, otherwise you are believed to be dead.","selected":false,"data":"ZX2","cost":2},"option_2b":{"name":"Reaction : Mocking Taunt","avd12_id":"218_2b","custom":false,"description":"In response to a Creature starting their turn within 4 Units of you, make a Performance Check against their Insight. If it fails, the Creature has a 1d4 Penalty to Attack Checks against any Target other than you. This does not work on Beasts, Constructs or Creatures without the ability to make Insight Checks.","selected":false,"data":"ZX2","cost":2},"option_3":{"name":"Reaction : Improvise","avd12_id":"218_3","custom":false,"description":"In response to failing a Defense Check, make another Defensive Check using a different Skill with a 1d4 Bonus.","selected":false,"data":"ZX2","cost":2},"option_4a":{"name":"Performing Arts","avd12_id":"218_4a","custom":false,"description":"Gain +1 Acrobatics and +1 Performance","selected":false,"data":"AS3=1:ASE=1","cost":2},"option_4b":{"name":"Traveling Troupe","avd12_id":"218_4b","custom":false,"description":"Gain +1 Cooking, +1 Resilience and +1 Wilderness","selected":false,"data":"AC2=1:AS6=1:ASB=1","cost":2},"option_5":{"name":"Free Action : Encore!","avd12_id":"218_5","custom":false,"description":"After rolling a True Hit on a Creature with an Attack, make a different type of Attack on the same Creature such as a Spell after using a Melee Attack or an Attack with a Ranged Weapon after hitting with a Melee Weapon. If the Target dies as a result of this Attack, you gain a Heroic Action.","selected":false,"data":"Y","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"fd9b1968e1ab40d0","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Thief","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"219","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Criminal","avd12_id":"219_1","custom":false,"description":"Gain +1 Thievery and +1 Initiative","selected":true,"data":"ASA=1:ASH=1","cost":2},"option_2a":{"name":"Stalk","avd12_id":"219_2a","custom":false,"description":"Gain +1 Stealth. You Movement Speed while Hidden is no longer reduced.","selected":false,"data":"AS4=1:TG","cost":2},"option_2b":{"name":"Kleptomania","avd12_id":"219_2b","custom":false,"description":"Gain +1 Thievery. You gain benefits from stealing Objects. When you steal an Object, you gain 1 Temporary Health after your next Full Rest for each 20 Gold of value on the Object up to a maximum of your Level. For each successive Full Rest, you gain 1 Less Temporary Health until you the value becomes 0 or you Steal another Object.","selected":false,"data":"ASA=1:TG","cost":2},"option_3":{"name":"Quick Escape","avd12_id":"219_3","custom":false,"description":"Gain +1 Dodge and +1 Initiative","selected":false,"data":"AD2=1:ASH=1","cost":2},"option_4a":{"name":"Free Action : Pocket Sand","avd12_id":"219_4a","custom":false,"description":"You toss either debris from your pocket or dirt from the ground at a Creature within 2 Units by making a Contested Thievery Check against their Initiative. On a success, the Creature is Blinded until the end of your turn and cannot take Reactions unless they have another sense to locate you by such as Echolocation or Tremorsense.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Free Action : Quick Hide","avd12_id":"219_4b","custom":false,"description":"When you use an Action to Move, you can also Hide as part of that Action if no Enemy Creatures have Line of Sight on you.","selected":false,"data":"Y","cost":2},"option_5":{"name":"Action : Cunning Strike","avd12_id":"219_5","custom":false,"description":"You make a Weapon Attack against a Creature who has at least 1 of your Allies Adjacent to them dealing an extra 1d12 Damage. You Target must make a Concentration Check against Half the Damage after Migitation or you are considered Hidden against them until the Start of your next turn.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"397bc0a3cea14e61","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Tidewalker","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"17","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Raised in Water","avd12_id":"17_1","custom":false,"description":"The Tidewalker culture is at home in the water. Your Swim Speed becomes equal to your Movement Speed and you gain +1 Athletics.","selected":true,"data":"TA:ALR:T6","cost":2},"option_2a":{"name":"Friend of the Sea","avd12_id":"17_2a","custom":false,"description":"You You gain +1 Animals and +1 Persuasion. You can communicate basic concepts to Aquatic Beasts and the Level limit determined by your Taming Formula is increased by 2 for Aquatic Beasts.","selected":false,"data":"ASF=1:ASC=1:TG","cost":2},"option_2b":{"name":"Underwater Weapons","avd12_id":"17_2b","custom":false,"description":"The Tidewalker Heritage involves weapons that work efficiently under water. Gain +1 Attack on Piercing Weapons","selected":false,"data":"AZ8=1","cost":2},"option_3":{"name":"Hazards of the Sea","avd12_id":"17_3","custom":false,"description":"Your body is acclimated to the harsh conditions of the deep waters. Gain +3 Cold Mitigation and +3 Fire Mitigation","selected":false,"data":"AD5=3:AD6=3","cost":2},"option_4a":{"name":"Songs of the Deep","avd12_id":"17_4a","custom":false,"description":"Stories and messages are passed through song and you have learned to both sing and interpret them. Gain +1 Performance, +1 Search and +2 Range on all Ballads.","selected":false,"data":"ASE=1:ASG=1:FB=2","cost":2},"option_4b":{"name":"Underwater Diplomat","avd12_id":"17_4b","custom":false,"description":"The Tidwalker culture invovles many different types of Creatures and sharing a common language is important for communication. Learn the Tidal Magical Language and gain +1 Persuasion","selected":false,"data":"ALM:ASC=1","cost":2},"option_5":{"name":"Water Shaper","avd12_id":"17_5","custom":false,"description":"You Gain +1 Spell Attack and you can Research Beginner and Journeyman Spells from the Aquamancy School of Magic. You can Research Journeyman Aquamancy Spells at Level 7, Expert at 9 and Master at 11. Additionally, while submerged in water, your Aquamancy Spells are automatically Charged.","selected":false,"data":"AZ2=1","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"c35b80bae7c84c6c","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Transmutation Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"108","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Transmuter","avd12_id":"108_1","custom":false,"description":"You can research Beginner Level Transmutation Spells and gain +1 Power.","selected":true,"data":"S81=4:FP=1","cost":2},"option_2a":{"name":"Potent Magic","avd12_id":"108_2a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"Materialist","avd12_id":"108_2b","custom":false,"description":"Gain +1 Alchemy, +1 Smithing and +1 Cooking","selected":false,"data":"","cost":2},"option_3":{"name":"Empowered Conduit","avd12_id":"108_3","custom":false,"description":"In response to taking Elemental Damage, your Conduit automatically attunes to that type of Damage, granting you Mitigation of that Type until you take Damage of a different Elemental Type.","selected":false,"data":"T","cost":2},"option_4a":{"name":"Free Action : Empowered Charge","avd12_id":"108_4a","custom":false,"description":"You convert the elemental energy stored in your Conduit to raw energy, Charging your next Spell that you complete Channeling on this turn. Your Empowered Conduit loses its charge and must be empowered again before using this ability.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Immutable Crafting","avd12_id":"108_4b","custom":false,"description":"Items you Craft are Immutable without needing to add an Infusion","selected":false,"data":"TC","cost":2},"option_5":{"name":"Novice Transmuter","avd12_id":"108_5","custom":false,"description":"You can research Novice Level Transmutation Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S82=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Psychokinesis","avd12_id":"108_6a","custom":false,"description":"You gain the innate ability to use the Charged version of the Telekinesis Spell as an Action instead of a Spell. Instead of a Spell Attack, you make a Concentration Check for the Attack Roll and use your Concentration Modifier as the Damage Bonus Modifier.","selected":false,"data":"T","cost":2},"option_6b":{"name":"Action : Unleashed Element","avd12_id":"108_6b","custom":false,"description":"You unleash the energy in your Empowered Conduit and make a Ray Spell Attack against a target within 15 units with a +2 Spell Attack Bonus dealing Damage of the type stored in your Conduit equal to 3d10 + [Level]. On a True Hit, this ability becomes a Line Attack instead. Your Empowered Conduit loses its charge and must be empowered again before using this ability.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Journeyman Transmuter","avd12_id":"108_7","custom":false,"description":"You can research Journeyman Level Transmutation Spells, gain +5 Power and +1 Elemental Mitigation","selected":false,"data":"S83=3:ADA=1:FP=5","cost":3},"option_8a":{"name":"Free Action : Spell Force","avd12_id":"108_8a","custom":false,"description":"After hitting a Large or smaller Creature with a Spell, you displace them by up to 1 Unit.","selected":false,"data":"T","cost":2},"option_8b":{"name":"Reaction : Convert Elements","avd12_id":"108_8b","custom":false,"description":"When a Creature within 20 Units of you takes Elemental Damage, convert it to another type of Elemental Damage.","selected":false,"data":"","cost":2},"option_9":{"name":"Expert Transmuter","avd12_id":"108_9","custom":false,"description":"You can research Expert Level Transmutation Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S84=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Free Action : Empowered Telekinesis","avd12_id":"108_10a","custom":false,"description":"Change the Damage Type of a Spell to either Lightning, Fire or Cold Damage.","selected":false,"data":"Y","cost":3},"option_10b":{"name":"Selectively Immutable","avd12_id":"108_10b","custom":false,"description":"Your form is Immutable from effects caused by Creatures other than you","selected":false,"data":"","cost":3},"option_11":{"name":"Master Transmuter","avd12_id":"108_11","custom":false,"description":"You can research Master Level Transmutation Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Transmutation Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"afb9d5f9321541f6","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Unarmored Fighting","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"116","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Unarmored Fighting","avd12_id":"116_1","custom":false,"description":"Gain +1 Dodge and +1 Block while not wearing armor","selected":true,"data":"W0D2=1:W0D3=1","cost":2},"option_2a":{"name":"Hardened Skin","avd12_id":"116_2a","custom":false,"description":"Gain +1 Physical Mitigation while not wearing armor","selected":false,"data":"W0D4=1","cost":2},"option_2b":{"name":"Quick Footed","avd12_id":"116_2b","custom":false,"description":"Gain +1 Acrobatics and +1 Movement Speed","selected":false,"data":"AS3=1:AV=1","cost":2},"option_3":{"name":"Peak Performance","avd12_id":"116_3","custom":false,"description":"Gain +1 Acrobatics, +1 Athletics and +1 Physical Mitigation while not wearing armor","selected":false,"data":"AS1=1:AS3=1:W0D4=1","cost":2},"option_4a":{"name":"Psychic Defense","avd12_id":"116_4a","custom":false,"description":"Gain +4 Psychic Mitigation","selected":false,"data":"AD9=4","cost":2},"option_4b":{"name":"Magical Defense","avd12_id":"116_4b","custom":false,"description":"Gain +4 Arcane Mitigation","selected":false,"data":"","cost":2},"option_5":{"name":"Tough Hide","avd12_id":"116_5","custom":false,"description":"Gain +1 Physical and Elemental Mitigation while not wearing armor","selected":false,"data":"W0DA=1:W0D4=1","cost":2},"option_6a":{"name":"Action : Sprint","avd12_id":"116_6a","custom":false,"description":"You move a distance equal to double your Movement Speed. While sprinting in this way, you gain +2 Block and Dodge against any provoked Reactions.","selected":false,"data":"XX3","cost":2},"option_6b":{"name":"Ray Avoidance","avd12_id":"116_6b","custom":false,"description":"You can use your Dodge Skill to attempt to avoid Rays instead of Resistance.","selected":false,"data":"TD","cost":2},"option_7":{"name":"Unarmored Expert","avd12_id":"116_7","custom":false,"description":"Gain +1 Dodge, +1 Resist and +1 Block while not wearing armor. Additionally, gain +1 Movement Speed.","selected":false,"data":"W0D2=1:W0D3=1:W0D1=1:AV=1","cost":3},"option_8a":{"name":"Reaction : Rollout","avd12_id":"116_8a","custom":false,"description":"In response to being Targeted by an Area, Line or Cone ability, you can immediately move up to 2 Units. If you are no longer within the Area, you automatically succeed on the Defense Check and avoid any Splash Damage, otherwise you gain a +3 Bonus to your Check.","selected":false,"data":"ZX2","cost":2},"option_8b":{"name":"Free Action : Unencumbered Attack","avd12_id":"116_8b","custom":false,"description":"You make an Attack with a Light or Ultra Light Weapon as a Free Action while not wearing Armor.","selected":false,"data":"Y","cost":2},"option_9":{"name":"Magical Skin","avd12_id":"116_9","custom":false,"description":"Gain +2 Dark, Divine and Elemental Mitigation","selected":false,"data":"AD7=2:AD8=2:ADA=2","cost":4},"option_10a":{"name":"Action : Tactical Retreat","avd12_id":"116_10a","custom":false,"description":"Make an Attack with a Melee Weapon. Regardless if the Attack hits or misses, you can move 3 Units without provoking Reactions. If the Attack is a True Hit, you can move up to your Movement Speed","selected":false,"data":"XX3","cost":3},"option_10b":{"name":"Reaction : Versatile Reaction","avd12_id":"116_10b","custom":false,"description":"You can use one of your unique Reactions without expending one of its charges.","selected":false,"data":"ZX2","cost":3},"option_11":{"name":"Master of Body","avd12_id":"116_11","custom":false,"description":"Gain +1 Dodge, Block and Resist while not wearing Armor. Additionally, gain +1 Movement Speed, +1 Physical Mitigation and +1 Elemental Mitigation.","selected":false,"data":"W0D2=1:W0D3=1:W0D1=1:AD4=1:ADA=1:AV=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"0bc2861bf25741e8","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Undead","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"29","origin":true,"type":"alteration","description":"undefined","options":{"option_1":{"name":"Curse of Gloombarrow","avd12_id":"29_1","custom":false,"description":"When you reach 0 Health, you do not enter Lifeline. Instead, you die and reanimate with full health in 1d4 days. When you complete a full rest, you lose any conditions affecting you, gain full health and you regenerate any lost body parts unless your body was completely destroyed.","selected":true,"data":"TA","cost":2},"option_2a":{"name":"Grotesque Form","avd12_id":"29_2a","custom":false,"description":"Your body has become grotesque due to the curse, but more durable. You gain +8 health but suffer a -2 Penalty to your Persuasion","selected":false,"data":"AH=8:ASC=-2","cost":2},"option_2b":{"name":"Ancient Knowledge","avd12_id":"29_2b","custom":false,"description":"Learn 1 Magical Language and 1 Non-Magical Language. Additionally, gain +1 Arcanum and +1 Academics","selected":false,"data":"AS7=1:AS9=1","cost":2},"option_3":{"name":"Deadskin","avd12_id":"29_3","custom":false,"description":"You gain Immunity to the Wounded Condition and Gain +1 Physical and +2 Dark Mitigation","selected":false,"data":"AD4=1:AD7=2:I=26","cost":2},"option_4a":{"name":"Action : Detatchable Parts","avd12_id":"29_4a","custom":false,"description":"You detatch either a hand or eyeball from your body. When the hand is detatched in this way, it takes on the Undead Hand Statblock which you control. An eye detatched in this way grants you Sight in a 4 unit radius from the location of the eyeball when it is less than 100 Units away. A body part can be reattached by using this Action again.","selected":false,"data":"XX3","cost":2},"option_4b":{"name":"Ghoulish Desires","avd12_id":"29_4b","custom":false,"description":"You can spend 1 Minute consuming a Medium or smaller Beast or Humanoid corpse, gaining Temporary Health equal to twice it's level that lasts until the end of your next full rest","selected":false,"data":"TA","cost":3},"option_5":{"name":"Reaction : Undead Fortitude","avd12_id":"29_5","custom":false,"description":"In response to being the target of an ability that requires you to make a Resilience or Resistance Check, gain a 1d6 Bonus to your roll. If the resulting ability deals Psychic Damage, that damage is halved before applying mitigations.","selected":false,"data":"ZX2","cost":3},"option_6a":{"name":"Free Action : Tainted Bile","avd12_id":"29_6a","custom":false,"description":"You smear a Weapon with bile, tainting it for the next Attack you take before the end of your turn. When you deal Physical Damage with this Weapon, the creature must make a Resilience Check against the total damage dealt after Mitigation or they get a modified version of the Poisoned Condition which deals 2d4 Dark Damage and prevents a Creature from recovering Health while affected.","selected":false,"data":"Y","cost":2},"option_6b":{"name":"Action [Daily] : Banshee Scream","avd12_id":"29_6b","custom":false,"description":"You unleash a wave of sonic energy in a 4 Unit Radius dealing 1d4 Dark Damage per Level. Humanoids and Beasts that are lower Level than you become Afraid until the end of your next turn.","selected":false,"data":"XD1","cost":2},"option_7":{"name":"Eyes of the Dead","avd12_id":"29_7","custom":false,"description":"You Gain +2 Search and the Undead variant of Ultravision.","selected":false,"data":"ASG=2:DU","cost":3},"option_8a":{"name":"Supernatural Strength","avd12_id":"29_8a","custom":false,"description":"Gain +1 Strength, +1 Athletics and +1 Damage with Melee Attacks","selected":false,"data":"AS1=1:AS2=1:AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_8b":{"name":"Necromancy","avd12_id":"29_8b","custom":false,"description":"Gain +1 Spell Attack and Learn 2 Beginner, Novice and Journeyman Necromancy Spells","selected":false,"data":"AZ2=1","cost":2},"option_9":{"name":"Cursebreaker","avd12_id":"29_9","custom":false,"description":"All Critical and Brutal Critical Hits are downgraded to normal True Hits against you. Additionally, when you die, you can attempt to make a Resilience Check of 12 or higher to remove your curse, causing you to die without reanimating, freeing your spirit and allowing you to be resurrected with magic. This removes the Undead Module.","selected":false,"data":"TA","cost":4},"option_a":{"name":"Reaction [Daily] : Still As Death","avd12_id":"29_a","custom":false,"description":"In response to taking Damage, you fall down in a heap, indistinguishable from real death. After 1 Minute, you recover half of your maximum Health.","selected":true,"data":"ZD1","cost":0},"option_b":{"name":"Undead","avd12_id":"29_b","custom":false,"description":"Your creature type becomes Undead, granting you Immunity to the Diseased, Poisoned, Bleeding and Exhausted Condition. You can not benefit from Consumables such as Potions, Food and Snacks or be affected by magic that restores Health.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"455b47f528a64b87","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Vampirism","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"120","origin":true,"type":"alteration","description":"undefined","options":{"option_1":{"name":"Vampiric Thrall","avd12_id":"120_1","custom":false,"description":"You have vampirism and are the thrall to some Vampire Lord. You are considered permanently Charmed by them.","selected":true,"data":"TA","cost":2},"option_2a":{"name":"Anatomical Changes","avd12_id":"120_2a","custom":false,"description":"Your vampirism has manifested in several changes to your physique. Gain +1 Acrobatics and +1 Strength.","selected":false,"data":"AS2=1:AD3=1","cost":2},"option_2b":{"name":"Place of Rest","avd12_id":"120_2b","custom":false,"description":"You designate a coffin or similar storage Object and fill it with dirt. When you complete a Full Rest within the Object, you recover all your Health and remove any Condition on you.","selected":false,"data":"TG","cost":2},"option_3":{"name":"Deadskin","avd12_id":"120_3","custom":false,"description":"Gain +1 Physical and +2 Dark Mitigation.","selected":false,"data":"AD4=1:AD7=2","cost":2},"option_4a":{"name":"Wallclimb","avd12_id":"120_4a","custom":false,"description":"You gain a Climbing Speed equal to your Movement Speed and climb vertical and horizontal surfaces.","selected":false,"data":"T4:TG","cost":2},"option_4b":{"name":"Daywalker","avd12_id":"120_4b","custom":false,"description":"The amount of Damage you take while ending your turn in sunlight is reduced to 1d4 True Damage.","selected":false,"data":"TA","cost":2},"option_5":{"name":"Manifesting Vampirism","avd12_id":"120_5","custom":false,"description":"Your powers continue to manifest. You gain Echolocation up to 8 Units and become Immune to Disease and Poison.","selected":false,"data":"I=19:I=8:DE","cost":3},"option_6a":{"name":"Deadly Fangs","avd12_id":"120_6a","custom":false,"description":"Your Vampire Bite Action deals an additional 1d10 Damage.","selected":false,"data":"TO","cost":2},"option_6b":{"name":"Action : Bat Swarm","avd12_id":"120_6b","custom":false,"description":"You turn into a Swarm of Bats for up to 1 Hour, inheriting their Statblock. The Swarm only recovers Health at the end of a Full Rest and if it reaches 0, you cannot use this Action again until the swarm is restored. You revert back to your original form if the swarm reaches 0 Health or you use this Action again.","selected":false,"data":"XX3","cost":2},"option_7":{"name":"Free Action : Regeneration","avd12_id":"120_7","custom":false,"description":"After consuming blood from a Humanoid or Beast, either with the Vampire Bite Action or drinking from a container, you gain 2d4 Health. After using this ability, your blood requirements are no longer satisifed for the day.","selected":false,"data":"Y","cost":3},"option_8a":{"name":"Exotic Blood","avd12_id":"120_8a","custom":false,"description":"Gain +1 Alchemy. Additionally, your blood counts as a Tier 1 Augmentation for Alchemy.","selected":false,"data":"AC5=1:TC","cost":2},"option_8b":{"name":"Vampire Charm","avd12_id":"120_8b","custom":false,"description":"Gain +1 Persuasion. When a Humanoid Botches an Insight Check against your Persuasion, they become Charmed by you until it breaks naturally.","selected":false,"data":"TG:ASC=1","cost":2},"option_9":{"name":"Ascension","avd12_id":"120_9","custom":false,"description":"You become freed from the thrall of your master and become a Vampire Lord. Your Bite Attack now functions to infect Humanoids with Vampirism if they fail a Resilience Check with your Level as the Required Check, turning them into your Thrall if they die within 1 Week of being bitten. You can maintain 1 Thrall, increasing to 2 at Level 11, and 3 at level 15.","selected":false,"data":"TG","cost":4},"option_a":{"name":"Action : Vampire Bite","avd12_id":"120_a","custom":false,"description":"You make an Unarmed Attack against another Creature. If the Target is a Beast or Humanoid and the Damage is not completely Mitigated, you gain Health equal to the damage dealt and have your blood requirements satisifed.","selected":true,"data":"XX3","cost":0},"option_b":{"name":"Vampire","avd12_id":"120_b","custom":false,"description":"You are afflicted with Vampirism and suffer the benefits and weaknesses, changing from the Humanoid to Undead Creature Type. You have a -5 Divine Mitigation penalty and take 1d12 True Damage at the end of each turn while in Sunlight. You do not need to eat, drink or breathe and do not get the benefits from consuming foods or potions. For each day that you do not consume at least a vial of Blood, you gain 1 Tier of Exhaustion at the end of a Full Rest which cannot be mitigated by Spells or Immunities.","selected":true,"data":"TA","cost":0}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a91caa4cfef8419e","folder":"0d3f46dc2f734ec5","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Vethi","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"20","origin":false,"type":"racial","description":"undefined","options":{"option_1":{"name":"Enlighteners","avd12_id":"20_1","custom":false,"description":"The Vethi culture shares a special relationship with all living things and find their purpose in the wilds. Gain +1 Animals and +1 Wilderness.","selected":true,"data":"ASB=1:ASF=1:ALZ","cost":2},"option_2a":{"name":"Rune Masters","avd12_id":"20_2a","custom":false,"description":"Many of those within the Vethi culture are taught at a young age to runecarve. Gain +1 Runecarving and learn 1 Magical Language.","selected":false,"data":"AC4=1","cost":2},"option_2b":{"name":"Burden of the Ancestors","avd12_id":"20_2b","custom":false,"description":"Many within the Vethi culture are taught focus and inward dialog so that they do not repeat the crimes of those who came before. You gain +1 Concentration and +1 Insight.","selected":false,"data":"AS5=1:ASD=1","cost":2},"option_3":{"name":"Reaction [Daily] : Antimagic","avd12_id":"20_3","custom":false,"description":"In response to a Spell being Channeled within a number of Units equal to your Level, lower the Spell Attack by 1d8. If the Spell does not require a Spell Attack, the Spell fails if the result of the d8 is 6 or higher.","selected":false,"data":"ZD1","cost":2},"option_4a":{"name":"Abstained Magic","avd12_id":"20_4a","custom":false,"description":"There are several groups within the Vethi culture that villify the use of Magic and train to resit its effects. You have a -1 Penalty to Spell Attack but gain +4 Arcane and +4 Psychic Mitigation.","selected":false,"data":"AZ2=-1:ADC=4:AD9=4","cost":2},"option_4b":{"name":"Embraced Magic","avd12_id":"20_4b","custom":false,"description":"There are several groups within the Vethi culture that want to reclaim the old ways. Gain +1 Spell Attack and +1 Spell Damage but suffer a -2 Penalty to Arcane and Pyschic Mitigation.","selected":false,"data":"AZ2=1:AZ4=1:ADC=-2:AD9=-2","cost":2},"option_5":{"name":"Ultimate Focus","avd12_id":"20_5","custom":false,"description":"Those with great promise are taught the ancient ways of the Vethi and can split their thought into multiple strands. You are able to Focus on two things at once, though Concentration Checks you make have a 1d4 Penalty when using this ability.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"8545e5ee99ae488e","folder":"1042b1f04fcd4af1","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Virtuoso","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"220","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Talented Musician","avd12_id":"220_1","custom":false,"description":"Learn a Ballad and gain +1 Performance","selected":true,"data":"ASE=1","cost":2},"option_2a":{"name":"Perfect Focus","avd12_id":"220_2a","custom":false,"description":"Become Good at Concentration","selected":false,"data":"","cost":2},"option_2b":{"name":"Born to Perform","avd12_id":"220_2b","custom":false,"description":"Become Good at Performance","selected":false,"data":"","cost":2},"option_3":{"name":"Songsmith","avd12_id":"220_3","custom":false,"description":"Learn a Ballad and gain +2 Range on your Ballads","selected":false,"data":"FB=2","cost":2},"option_4a":{"name":"Reaction : Bridge","avd12_id":"220_4a","custom":false,"description":"While Focusing on a Ballad, you can mix in another Ballad as a Reaction that only lasts until the start of your next turn.","selected":false,"data":"","cost":2},"option_4b":{"name":"Reaction : Parody","avd12_id":"220_4b","custom":false,"description":"When an Attack misses you or an Ally within your Ballad Range, you can use your Reaction to sing or play a quick parody about that Creature, causing them to have a 1d4 Penalty on their next Attack or Defense Check.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Mantle of the Minstrel","avd12_id":"220_5","custom":false,"description":"Creatures that can hear your Ballads cannot be Confused or Maddened. Additionally, affected Creatures do not fall Unconscious until reaching 1 Lifeline Point.","selected":false,"data":"TG","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"02bc7f91f4b94cd1","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Volatile Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"238","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Free Action : Spell Surge","avd12_id":"238_1","custom":false,"description":"After Channeling a Spell that has a Channel Time of 1 Action and has an Attack Roll, amplify it with a surge of magic increasing your Check by 1d4. In the event you roll a 1, you roll on the Surge Table which alters your Spell.","selected":true,"data":"Y","cost":2},"option_2a":{"name":"Charging Surge","avd12_id":"238_2a","custom":false,"description":"When you use your Spell Surge, the Spell becomes automatically Charged on a d4 roll of 4.","selected":false,"data":"TO","cost":2},"option_2b":{"name":"Violent Surge","avd12_id":"238_2b","custom":false,"description":"When you use your Spell Surge, you double your Damage Bonus Modifier on the Spell on any roll besides a 1 on the d4.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Chaos Mage","avd12_id":"238_3","custom":false,"description":"Gain +1 Spell Attack","selected":false,"data":"AZ2=1","cost":2},"option_4a":{"name":"Prepared Mind","avd12_id":"238_4a","custom":false,"description":"Gain +1 Resistance and +2 Arcane Mitigation","selected":false,"data":"AZ4=1","cost":2},"option_4b":{"name":"Spell Power","avd12_id":"238_4b","custom":false,"description":"Gain +1 Spell Damage and +1 Arcanum","selected":false,"data":"TO","cost":2},"option_5":{"name":"Reaction : Empowering Surge","avd12_id":"238_5","custom":false,"description":"After a Creature within 10 Units Channels a Spell with a Channel Type of 1 Action, you amplify it with a surge of magic increasing your Check by 1d4. In the event you roll a 1, you roll on the Surge Table which alters your Spell.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"c98dfc22e46f4ff5","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Witchcraft Magic","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"105","origin":false,"type":"core","description":"undefined","options":{"option_1":{"name":"Beginner Occultist","avd12_id":"105_1","custom":false,"description":"You can research Beginner Level Witch Spells and gain +1 Power.","selected":true,"data":"S91=4:FP=1","cost":2},"option_2a":{"name":"Potent Spells","avd12_id":"105_2a","custom":false,"description":"Gain +1 Spell Damage","selected":false,"data":"AZ4=1","cost":2},"option_2b":{"name":"Witch Companion","avd12_id":"105_2b","custom":false,"description":"Gain a Witches Familiar","selected":false,"data":"OW","cost":2},"option_3":{"name":"Action : Hex","avd12_id":"105_3","custom":false,"description":"Mark a Creature that you can see within 15 Units and curse them with a Hex that lasts for 1 minute. Any time you hit a Creature with a new Spell or Weapon Attack, you deal extra 1d8 (2d8 if Improved) Dark Damage. Hex can only be used again if the Hexed Creature dies, otherwise, you must wait until you finish a Full Rest to use this ability again.","selected":false,"data":"XX3","cost":2},"option_4a":{"name":"Researcher of the Dark Arts","avd12_id":"105_4a","custom":false,"description":"Gain +1 Scribing and +2 Dark Mitigation","selected":false,"data":"AC3=1:AD7=2","cost":2},"option_4b":{"name":"Defiler","avd12_id":"105_4b","custom":false,"description":"Gain +4 Divine Mitigation","selected":false,"data":"AD8=4","cost":2},"option_5":{"name":"Novice Occultist","avd12_id":"105_5","custom":false,"description":"You can research Novice Level Witch Spells, gain +1 Spell Attack and +2 Power.","selected":false,"data":"S92=4:AZ2=1:FP=2","cost":2},"option_6a":{"name":"Coven","avd12_id":"105_6a","custom":false,"description":"You create or join a Coven of up to 4 other Creatures with this Trait. While in the same Coven, witches can communicate telepathically, no matter the distance. Additionally, witches gain +2 Spell Damage Bonus Modifier for each member of the Coven within 20 Units. A witch can only leave a Coven if they die.","selected":false,"data":"TG","cost":2},"option_6b":{"name":"Special Recipes","avd12_id":"105_6b","custom":false,"description":"You Gain +2 Cooking and +1 Alchemy","selected":false,"data":"DU","cost":2},"option_7":{"name":"Journeyman Occultist","avd12_id":"105_7","custom":false,"description":"You can research Journeyman Level Druidic Spells, gain +5 Power and +1 Concentration","selected":false,"data":"S93=3:AS5=1:FP=5","cost":3},"option_8a":{"name":"Free Action : Dark Stalker","avd12_id":"105_8a","custom":false,"description":"If you start your turn in Darkness, gain a +2 Attack on all Spells and Weapons until the end of your turn.","selected":false,"data":"Y","cost":2},"option_8b":{"name":"Reaction : Transfer Spell","avd12_id":"105_8b","custom":false,"description":"When a Creature dies that is affected by one of your Spells that you are maintaining Focus on, you can use a Reaction to move that Spell to another Creature by making a Spell Attack against their Resistance. On a failure, the Spell ends.","selected":false,"data":"ZX2","cost":2},"option_9":{"name":"Expert Occultist","avd12_id":"105_9","custom":false,"description":"You can research Expert Level Witch Spells, gain +8 Power, +1 Spell Attack and +1 Spell Damage","selected":false,"data":"S94=2:AZ2=1:AZ4=1:FP=8","cost":4},"option_10a":{"name":"Witch Eyes","avd12_id":"105_10a","custom":false,"description":"You Gain Ultravision up to 10 Units","selected":false,"data":"DU","cost":3},"option_10b":{"name":"Improved Hex","avd12_id":"105_10b","custom":false,"description":"Your Hex damage is increased to 2d8 Dark Damage and your True Hit threshold is increased by 1.","selected":false,"data":"TG","cost":3},"option_11":{"name":"Master Occultist","avd12_id":"105_11","custom":false,"description":"You can research Master Level Witch Spells, gain +10 Power, +1 Spell Attack and +1 Resistance. Additionally, you can research or learn Grand Master Witch Spells at level 13.","selected":false,"data":"FP=6:AZ2=1:AD1=1","cost":5}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3d7af2edcc2e4ee2","folder":"ce13e78a37744bdf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Wrestler","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"258","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Good Physique","avd12_id":"258_1","custom":false,"description":"Gain +1 Acrobatics and +1 Athletics","selected":true,"data":"AS1=1:AS3=1","cost":2},"option_2a":{"name":"Grapplemaster","avd12_id":"258_2a","custom":false,"description":"A Creature that is Grappled by you has a 1d4 Penalty to their Attack Rolls.","selected":false,"data":"TO","cost":2},"option_2b":{"name":"Leverage","avd12_id":"258_2b","custom":false,"description":"You can Shove and Grapple Creatures that are one Size larger than you.","selected":false,"data":"TO","cost":2},"option_3":{"name":"Improvised Attacks","avd12_id":"258_3","custom":false,"description":"Gain +1 Attack with Crushing Weapons and Unarmed Attacks","selected":false,"data":"AZ7=1:AZM=1","cost":2},"option_4a":{"name":"Free Action : Powershove","avd12_id":"258_4a","custom":false,"description":"When you make a successful Shove Action, you both displace and knock the creature Prone instead of choosing between the two.","selected":false,"data":"Y","cost":2},"option_4b":{"name":"Reaction : Reversal","avd12_id":"258_4b","custom":false,"description":"When a Creature attempts to Shove or Grapple you, gain a 1d4 Bonus to your roll. If you win the Check, you can choose to Shove or Grapple the Creature.","selected":false,"data":"ZX2","cost":2},"option_5":{"name":"Action : Slam","avd12_id":"258_5","custom":false,"description":"When you have a target Grappled or are adjacent to a target that is Prone, you make an Unarmed Attack on them that is upgraded to a Brutal Critical if it hits.","selected":false,"data":"XX3","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"eee821347cb0478b","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Zealot","type":"avd12module","img":"systems/avd12/images/icons/gem.webp","system":{"avd12_id":"277","origin":false,"type":"secondary","description":"undefined","options":{"option_1":{"name":"Unwavering Belief","avd12_id":"277_1","custom":false,"description":"Gain +1 Insight and +1 Resilience","selected":true,"data":"ASD=1:AS6=1","cost":2},"option_2a":{"name":"Act with Faith","avd12_id":"277_2a","custom":false,"description":"Become Good at Initiative","selected":false,"data":"","cost":2},"option_2b":{"name":"Zealots Gift","avd12_id":"277_2b","custom":false,"description":"Gain 2 Beginner and 1 Novice Spell from any Traditional or Exoctic Spell School and gain +2 Power Regeneration.","selected":false,"data":"FR=2","cost":2},"option_3":{"name":"Free Action : Reward the Faithful","avd12_id":"277_3","custom":false,"description":"When you get a True hit on any Attack on a Creature that is at most 2 Levels lower than you, gain Temporary Health equal to your Level that lasts until expended or the end of a Full Rest.","selected":false,"data":"Y","cost":2},"option_4a":{"name":"Armor of Faith","avd12_id":"277_4a","custom":false,"description":"Gain +2 Divine Mitigation and +2 Dark Mitigation","selected":false,"data":"AD7=2:AD8=2","cost":2},"option_4b":{"name":"Guided Hand","avd12_id":"277_4b","custom":false,"description":"Gain +1 Spell Damage and +1 Damage to Melee Attacks","selected":false,"data":"AZ4=1:AZA=1:AZB=1:AZC=1:AZN=1","cost":2},"option_5":{"name":"Reaction : Enduring Faith","avd12_id":"277_5","custom":false,"description":"Whenever you are forced to make either a Concentration, Resilience or Resistance Check, add an additional 1d6 to the total. This ability can be used after the result of the roll is known.","selected":false,"data":"ZX2","cost":3}},"details":{}},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"f82b7dcb961945dd","folder":"82c17fbad4244aaf","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}