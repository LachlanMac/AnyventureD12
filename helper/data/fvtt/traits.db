{"name":"Pact Trait : Sylvan ","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"6_pact_trait_:_sylvan_","description":"You can Speak to Animals and Plants at will, but you lose -2 Persuasion and -2 Insight.","data":"ASC=-2:ASD=-2"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"106e8781607944b9","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
