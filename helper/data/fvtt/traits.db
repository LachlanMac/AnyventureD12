{"name":"Beastkin Trait : Seawalker","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"15_beastkin_trait_:_seawalker","description":"You can Breathe Underwater and gain a Swim Speed equal to your Movement Speed.","data":""},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"edcf895e29ab4e00","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
