{"name":"Pact Trait : Broken Will","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"11_pact_trait_:_broken_will","description":"You gain +1 Attack and +1 Damage with all Weapons but lose -2 Resistance.","data":"AD1=-2:AZ1=1:AZ3=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"2346f4f295594f6c","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact Trait : Forbidden Knowledge","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"12_pact_trait_:_forbidden_knowledge","description":"You gain +1 Arcana, Academics and Medicine Knowledge but lose -1 Block and -1 Dodge","data":"AS7=1:AS9=1:AS8=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"4b8d2b81e0984806","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
