{"name":"Pact Trait : Wild Binding","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"8_pact_trait_:_wild_binding","description":"With 2 Actions, you can Transform into a Beast of Level 2 or lower. While you are in contact with Iron, take 1d4 True Damage at the start of your turn unless you have 1 or less Health.","data":""},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"23f8d35ee3ea4594","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact Trait : Patrons Fury","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"9_pact_trait_:_patrons_fury","description":"When you are Critically Hit, the Attack is downgraded to a normal Hit but you become Maddened for 1d4 Turns.","data":""},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3c952ba888554fdd","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
