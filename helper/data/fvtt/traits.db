{"name":"Lycanthrope Weakness : Fire Weakness","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"17_lycanthrope_weakness_:_fire_weakness","description":"Your Lycanthropy has manifested in a fear of fire. You suffer a -4 Penalty to your Fire Mitigation. Any time you take Fire Damage, you must make a Resilience Check greater than or equal to half the Fire Damage taken or become Afraid of whatever caused the Damage. You cannot willfully move within 2 Units of an open flame while in Lycanthrope form.","data":"AD6=-4"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"60df9171575342de","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Lycanthrope Weakness : Water Weakness","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"18_lycanthrope_weakness_:_water_weakness","description":"Your Lycanthropy has manifested in a fear of fire. You suffer a -4 Penalty to your Cold Mitigation. Any time you take Cold Damage, you must make a Resilience Check greater than or equal to half the Cold Damage taken or become Afraid of whatever caused the Damage. You cannot willfully cross a boundry or body of water while in Lycanthrope form.","data":"AD5=-4"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"7c0e330982164546","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Lycanthrope Weakness : Silver Weakness","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"19_lycanthrope_weakness_:_silver_weakness","description":"Your Lycanthropy has manifested in an aversion to Silver. Weapons that are Silvered deal True Damage to you. Whenever you first come in contact with a Silver Object or end your turn holding a Silver Object in your Inventory, you take 1d6 True Damage. This includes Touch Spells that use Silver as a Component.","data":""},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"15a5b68466c247c7","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Small Creature","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"20_small_creature","description":"Small Creatures gain +1 Dodge and Stealth while having a -1 penalty to Movement Speed and Strength. They cannot wield Heavy Weapons and have a decreased carrying capacity.","data":"AD2=1:AS4=1:AV=-1:AS2=-1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"d5ec488feb3f4fa2","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Medium Creature","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"21_medium_creature","description":"Medium Creatures are standard size, gaining no penalties or bonuses.","data":""},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"3cd063e2afcf4537","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Large Creature","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"22_large_creature","description":"Large creatures gain a +1 Strength and Block while having a -1 penalty to Stealth, Acrobatics and Dodge.They must consume 4 Meals per day to qualify for the benefits from a Full Rest. Additionally, they take up double the space of a normal creature but have an increased carrying capacity.","data":"AD3=1:AD2=-1:AS4=-1:AS3=-1:AS2=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"e1485d4e52fa4a1a","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}