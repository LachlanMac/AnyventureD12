{"name":"Pact Trait : Eyes of the Patron","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"1_pact_trait_:_eyes_of_the_patron","description":"You lose your Normal Vision, but gain Echo Location up to 20 Units and +1 Search.","data":"ASG=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"964a8ecc27764b3f","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact Trait : Silvered Tongue","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"2_pact_trait_:_silvered_tongue","description":"You gain +1 Persuasion and your Patrons Magical Language. When you roll a 1 on a Persuasion Check, you cannot speak or Channel Spells until you complete a Full Rest.","data":"ASC=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"73f2a213cd5e4e2a","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact Trait : Enamoring Melody","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"3_pact_trait_:_enamoring_melody","description":"You gain +2 Performance. When you roll a 1 on a Performance Check while playing an Instrument, Singing or attempting a Ballad, everyone who can hear you must make a Resistance Check of 10 or higher or become Maddened for 1 Minute.","data":"ASC=2"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"227722c45eba47c7","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
{"name":"Pact Trait : Fractured Mind","type":"trait","img":"systems/avd12/images/icons/focus2.webp","system":{"traittype":"origin","avd12_id":"4_pact_trait_:_fractured_mind","description":"You gain +1 Spell Attack and +1 Spell Damage but you cannot Focus on anything.","data":"AZ2=1:AZ4=1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"333a4deb27484007","folder":null,"sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
