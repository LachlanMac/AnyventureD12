{"name":"Inspire","type":"reaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"When you or an Ally make a Knowledge Check, you inspire them, adding a 1d6 Bonus to their Check. This ability can only be used a number of times per day equal to your Knowledge Attribute.","uses":{"current":2,"max":2},"avd12_id":"226_4a"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"52f6b54469bb4370","folder":"d6656fd454944b77","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
