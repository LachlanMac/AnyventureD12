{"name":"Kinetic Shot","type":"action","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"You fire energy from your Conduit by making a Projectile Spell Attack at a Target within 6 Units, dealing 1d8 Physical Damage plus your Spell Damage Bonus Modifier. This Action does not have usage limits.","uses":{"current":3,"max":3},"avd12_id":"261_1"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"26fa6cad060f4e28","folder":"8f0646a847504190","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
