{"name":"Arcane Cataclysm","type":"action","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":true,"description":"You make an Area Spell Attack with your Focus that is centered on your location with a Radius of 3 Units. Spend up to your Level in Focus Points, dealing 1d6 Arcane Damage for each point spent.","uses":{"current":1,"max":1},"avd12_id":"103_10b"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"654bc6fedbc24f86","folder":"8f0646a847504190","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
