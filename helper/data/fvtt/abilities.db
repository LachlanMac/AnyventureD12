{"name":"Dream Totem","type":"action","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"You place down a totem on the ground which grants all Allies within 8 Units +1 Resistance and Psychic Mitigation equal to your Level while they are within the Area. Additionally, while an Ally is within the protection of the Totem, they cannot be put to sleep by magic or suffer the effects of Spells that cause nightmares or dreams.","uses":{"current":3,"max":3},"avd12_id":"240_5"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"58eeebde14cf42af","folder":"8f0646a847504190","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
