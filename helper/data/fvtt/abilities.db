{"name":"Bloodmagic","type":"freeaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"You let your own blood with a Light 1-Handed Weapon, dealing 1d6 True Damage to yourself. The next Spell that you complete on this turn becomes Charged and the Spell Damage Bonus Modifier is doubled.","uses":{"current":0,"max":0},"avd12_id":"276_4b"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"9e8800f8da9e4959","folder":"61f74e9ee4ba4778","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
