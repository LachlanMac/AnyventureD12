{"name":"Brutalize","type":"freeaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"When you deal a killing blow to an Enemy, you can use your Free Action to brutally savage them. You make a Contested Performance Check against the Resilience of any Enemy within 4 Units. On a success, they become Afraid of you until the start of your next turn.","uses":{"current":0,"max":0},"avd12_id":"213_3"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"a79bd0c69a054ecf","folder":"61f74e9ee4ba4778","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
