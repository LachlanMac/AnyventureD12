{"name":"Empowered Charge","type":"freeaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"You convert the elemental energy stored in your Conduit to raw energy, Charging your next Spell that you complete Channeling on this turn. Your Empowered Conduit loses its charge and must be empowered again before using this ability.","uses":{"current":0,"max":0},"avd12_id":"108_4a"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"1844509053c54054","folder":"61f74e9ee4ba4778","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
