{"name":"Circle Kick","type":"action","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"Make an Unarmed Attack against a Creature. You can then Move up to your Movement Speed as long as remain Adjacent to your initial Target regardless if the Attack is successful. Your next Melee Attack this turn against a Creature other than the original Target has a 1d4 Attack Bonus.","uses":{"current":3,"max":3},"avd12_id":"273_2a"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"dc1728c8f8ac48ee","folder":"8f0646a847504190","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
