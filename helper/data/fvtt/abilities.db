{"name":"Dreamweaver","type":"freeaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"The next Melee or Ranged Attack you make this turn deals Psychic Damage instead of it's normal Primary type. If the damage brings a creature to 0 Health and it is not immune to the sleeping condition, it gains the sleeping condition for 1 hour.","uses":{"current":0,"max":0},"avd12_id":"25_8b"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"04267c8381b34ac4","folder":"61f74e9ee4ba4778","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
