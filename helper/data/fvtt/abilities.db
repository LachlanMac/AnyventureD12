{"name":"Rollout","type":"reaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"In response to being Targeted by an Area, Line or Cone ability, you can immediately move up to 2 Units. If you are no longer within the Area, you automatically succeed on the Defense Check and avoid any Splash Damage, otherwise you gain a +3 Bonus to your Check.","uses":{"current":2,"max":2},"avd12_id":"116_8a"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"cf584fc9466e49ff","folder":"d6656fd454944b77","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
