{"name":"Bless","type":"action","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"You touch a Weapon, causing it to glow with radiant energy. The next time this weapon hits a creature, the primary damage is converted to Divine damage. If you elect to Focus on this Action, you can recharge the weapon with a Reaction.","uses":{"current":3,"max":3},"avd12_id":"101_3"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"25fa19e96b9a47ba","folder":"8f0646a847504190","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
