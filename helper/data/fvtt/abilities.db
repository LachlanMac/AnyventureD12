{"name":"Undead Service","type":"freeaction","img":"systems/avd12/images/icons/focus2.webp","system":{"daily":false,"description":"When you take a Creature down to 0 Health as a result of one of your Spells, the Creature comes under your command, taking its turn after yours ends. At the end of its turn, this effect ends. This Spell does not affect Elementals or Constructs.","uses":{"current":0,"max":0},"avd12_id":"104_8a"},"effects":[],"flags":{"core":{"sourceId":""}},"_stats":{"systemId":"avd12","systemVersion":"14.0.2","coreVersion":"12.324.0","createdTime":1736286701128,"modifiedTime":1736286701128,"lastModifiedBy":"PkSjA89Pm9zyORjP"},"_id":"88a9a639ac6648e0","folder":"61f74e9ee4ba4778","sort":0,"ownership":{"default":0,"PkSjA89Pm9zyORjP":3}}
